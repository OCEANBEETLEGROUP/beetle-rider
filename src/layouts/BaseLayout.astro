---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageLoader from '../components/PageLoader.astro';
import { getSiteConfig, getInstagramPosts } from '../lib/microcms';
import { getLangFromUrl } from '../i18n/config';
import { alternateUrl } from '../i18n/config';

const lang = getLangFromUrl(Astro.url);
const siteConfig = await getSiteConfig();

// Fetch Instagram gallery photos
const [ebikeIg, chopperIg] = await Promise.all([
  getInstagramPosts('ebike'),
  getInstagramPosts('chopper'),
]);
const igPhotos = {
  ebike: ebikeIg.contents.map(p => ({ src: p.image.url + '?w=600&q=80', alt: p.altText || '' })),
  chopper: chopperIg.contents.map(p => ({ src: p.image.url + '?w=600&q=80', alt: p.altText || '' })),
};

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  activePage?: 'home' | 'chopper' | 'ebike' | 'about';
  headerLogo?: 'chopper' | 'ebike' | 'corporate';
}

const {
  title,
  description = 'BEETLE RIDER — A rental experience by OCEANBEETLE. Chopper & E-Bike rental in Kamakura.',
  bodyClass = '',
  activePage = 'home',
  headerLogo = 'chopper',
} = Astro.props;

const altUrl = alternateUrl(Astro.url);
const altLang = lang === 'ja' ? 'en' : 'ja';

// JSON-LD structured data — only on homepage (Organization + WebSite)
const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '/en/' || Astro.url.pathname === '/en';

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://beetlerider.com/#organization',
  name: 'BEETLE RIDER',
  alternateName: 'BEETLE RIDER Kamakura',
  url: 'https://beetlerider.com/',
  logo: {
    '@type': 'ImageObject',
    url: 'https://beetlerider.com/favicon-512.png',
    width: 512,
    height: 512,
  },
  image: 'https://beetlerider.com/ogp.png',
  description: 'A rental experience by OCEANBEETLE. Chopper & E-Bike rental in Kamakura.',
  sameAs: [
    'https://instagram.com/beetlerider_japan',
    'https://instagram.com/beetlerider_ebike',
  ],
};

const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://beetlerider.com/#localbusiness',
  name: 'BEETLE RIDER',
  image: 'https://beetlerider.com/ogp.png',
  url: 'https://beetlerider.com/',
  telephone: '+81-467-37-9926',
  priceRange: '¥¥',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '小町1-15-2',
    addressLocality: '鎌倉市',
    addressRegion: '神奈川県',
    postalCode: '248-0006',
    addressCountry: 'JP',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 35.3192,
    longitude: 139.5509,
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '10:00',
    closes: '18:00',
  }],
  sameAs: [
    'https://instagram.com/beetlerider_japan',
    'https://instagram.com/beetlerider_ebike',
  ],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://beetlerider.com/#website',
  url: 'https://beetlerider.com/',
  name: 'BEETLE RIDER',
  description: 'A rental experience by OCEANBEETLE. Chopper & E-Bike rental in Kamakura.',
  publisher: { '@id': 'https://beetlerider.com/#organization' },
  inLanguage: ['ja', 'en'],
};
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>

  <!-- Canonical -->
  <link rel="canonical" href={Astro.url.href}>

  <!-- Favicon (Google search results require square, min 48x48) -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#0a0a0a">

  <!-- OGP / Social -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://beetlerider.com/ogp.png">
  <meta property="og:url" content={Astro.url.href}>
  <meta property="og:site_name" content="BEETLE RIDER">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="https://beetlerider.com/ogp.png">

  <!-- Google Analytics (GA4) + Google Tag -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-7BY8Q8C33D"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-7BY8Q8C33D');
    gtag('config', 'GT-P3JXZPBB');
  </script>

  <!-- i18n (absolute URLs required for hreflang) -->
  <link rel="alternate" hreflang={altLang} href={`https://beetlerider.com${altUrl}`} />
  <link rel="alternate" hreflang={lang} href={Astro.url.href} />
  <link rel="alternate" hreflang="x-default" href={`https://beetlerider.com${lang === 'ja' ? Astro.url.pathname : Astro.url.pathname.replace(/^\/en/, '') || '/'}`} />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessLd)} />
  {isHomepage && <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />}

  <!-- Fonts (non-blocking) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Rubik+Dirt&family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700;900&family=Noto+Serif+JP:wght@700;900&display=swap">
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Rubik+Dirt&family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700;900&family=Noto+Serif+JP:wght@700;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Rubik+Dirt&family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700;900&family=Noto+Serif+JP:wght@700;900&display=swap" rel="stylesheet"></noscript>
</head>
<body class={bodyClass}>
  <PageLoader />
  <Header activePage={activePage} logo={headerLogo} lang={lang} />

  <main>
    <slot />
  </main>

  <Footer activePage={activePage} siteConfig={siteConfig} igPhotos={igPhotos} lang={lang} />

  <!-- Scroll Reveal -->
  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      { threshold: 0.15 }
    );
    document.querySelectorAll('.reveal, .reveal-scale').forEach((el) => observer.observe(el));
  </script>
</body>
</html>
