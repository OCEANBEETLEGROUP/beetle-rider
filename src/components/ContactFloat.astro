---
/**
 * ContactFloat — 予約直前の疑問を即解消する連絡ボタン（IG DM / 電話）。左下固定。
 */
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
  phone?: string;
}
const { lang, phone = '0467379926' } = Astro.props;
const en = lang === 'en';
---

<div class="fixed bottom-8 left-8 max-md:bottom-5 max-md:left-5 z-[85] flex flex-col gap-2.5">
  <a
    href="https://ig.me/m/beetlerider_japan"
    target="_blank"
    rel="noopener"
    aria-label={en ? 'Message us on Instagram' : 'InstagramでDMする'}
    class="group flex items-center gap-0 w-11 h-11 hover:w-auto hover:px-4 rounded-full bg-white/[0.08] border border-white/[0.14] backdrop-blur-[12px] items-center justify-center overflow-hidden transition-all duration-300 hover:bg-white/[0.16]"
  >
    <span class="w-11 h-11 shrink-0 -ml-[1px] flex items-center justify-center">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px] text-white/85">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
      </svg>
    </span>
    <span class="hidden group-hover:inline whitespace-nowrap pr-2 text-[10.5px] font-bold tracking-[0.15em] uppercase text-white">{en ? 'DM us' : 'DMで質問'}</span>
  </a>
  <a
    href={`tel:${phone}`}
    aria-label={en ? 'Call us' : '電話する'}
    class="group flex items-center gap-0 w-11 h-11 hover:w-auto hover:px-4 rounded-full bg-white/[0.08] border border-white/[0.14] backdrop-blur-[12px] items-center justify-center overflow-hidden transition-all duration-300 hover:bg-white/[0.16] md:hidden"
  >
    <span class="w-11 h-11 shrink-0 -ml-[1px] flex items-center justify-center">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px] text-white/85">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
    </span>
  </a>
</div>
