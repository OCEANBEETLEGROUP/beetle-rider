---
import { bokunWidgetUrl } from '../lib/bokun';

interface Props {
  widgetId: string;
  label?: string;
  class?: string;
}

const { widgetId, label = 'BOOK NOW', class: className } = Astro.props;
const bookingUrl = widgetId ? bokunWidgetUrl(widgetId) : '';
---

{widgetId ? (
  <a
    href={bookingUrl}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[className]}
  >
    {label}
  </a>
) : (
  <span class:list={[className, 'opacity-50 cursor-not-allowed']}>
    COMING SOON
  </span>
)}
