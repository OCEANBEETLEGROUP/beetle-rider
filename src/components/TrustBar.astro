---
/**
 * TrustBar — BR固有の信頼証明チップ帯（OB本体の実績は使わない: TAKE裁定 2026-07-06）
 * theme: 'dark'=deep-red系ページ用 / 'pink'=E-BIKEページ用（茶色禁止・bg-ebikeで帯を出す）
 */
import type { Lang } from '../i18n/config';
import { GOOGLE_RATING, GOOGLE_REVIEW_COUNT, REVIEWS_ARE_REAL } from '../data/reviews';

interface Props {
  lang: Lang;
  variant?: 'chopper' | 'ebike' | 'home';
  theme?: 'dark' | 'pink';
}

const { lang, variant = 'home', theme = 'dark' } = Astro.props;
const en = lang === 'en';

const google = REVIEWS_ARE_REAL
  ? `★ ${GOOGLE_RATING.toFixed(1)} GOOGLE (100+)`
  : null;

const chips: string[] = [];
if (google) chips.push(google);
if (variant === 'chopper') {
  chips.push(en ? "JAPAN'S ONLY CHOPPER RENTAL" : '日本唯一のチョッパーレンタル');
  chips.push(en ? 'LIABILITY INSURANCE INCLUDED' : '対人・対物保険込み');
} else if (variant === 'ebike') {
  chips.push(en ? 'NO LICENSE REQUIRED' : '免許不要');
  chips.push(en ? 'INSURANCE PLANS AVAILABLE' : '保険プランあり');
} else {
  chips.push(en ? "JAPAN'S ONLY CHOPPER RENTAL" : '日本唯一のチョッパーレンタル');
  chips.push(en ? 'NO LICENSE — E-BIKE' : 'E-BIKEは免許不要');
}
chips.push(en ? '4 MIN FROM KAMAKURA STA.' : '鎌倉駅から徒歩4分');

const wrap = theme === 'pink' ? 'bg-ebike border-y border-black/[0.08]' : 'border-y border-white/[0.07] bg-white/[0.015]';
const chipText = theme === 'pink' ? 'text-white/75' : 'text-white/45';
const starText = theme === 'pink' ? 'text-white' : 'text-brand';
---

<div class={wrap}>
  <div class="max-w-[1200px] mx-auto px-6 py-4 flex flex-wrap items-center justify-center gap-x-8 gap-y-2">
    {chips.map((c, i) => (
      <span class={`flex items-center gap-2 text-[10.5px] md:text-[11px] font-bold tracking-[0.18em] uppercase ${chipText} whitespace-nowrap`}>
        {i === 0 && google ? <span class={starText}>{c}</span> : c}
      </span>
    ))}
  </div>
</div>
