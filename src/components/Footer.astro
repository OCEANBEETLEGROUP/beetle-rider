---
interface Props {
  activePage: 'home' | 'chopper' | 'ebike' | 'about';
  siteConfig?: {
    instagramChopper?: string;
    instagramEbike?: string;
    address?: string;
    mapUrl?: string;
    phone?: string;
    businessHours?: string;
    email?: string;
    privacyPolicyUrl?: string;
    tokushohoUrl?: string;
    importantNoticesUrl?: string;
  };
  igPhotos?: {
    ebike: { src: string; alt: string }[];
    chopper: { src: string; alt: string }[];
  };
}

const { activePage, siteConfig } = Astro.props;

const igEbike = siteConfig?.instagramEbike || 'https://instagram.com/beetlerider_ebike';
const igChopper = siteConfig?.instagramChopper || 'https://instagram.com/beetlerider_japan';
const mapUrl = siteConfig?.mapUrl || 'https://maps.app.goo.gl/Y2bhYqAcBkLyzdydA';

// All pages show both IG accounts
const showBoth = true;
const showEbike = true;
const showChopper = true;

// Instagram photos from props (fetched in BaseLayout)
const ebikePhotos = (Astro.props.igPhotos?.ebike ?? [
  { src: '/assets/ebike/ebike0010.jpg', alt: 'E-BIKE Kamakura' },
  { src: '/assets/ebike/ebike0023.jpg', alt: 'E-BIKE coastal ride' },
  { src: '/assets/ebike/ebike0026.jpg', alt: 'E-BIKE temple' },
]);

const chopperPhotos = (Astro.props.igPhotos?.chopper ?? [
  { src: '/assets/chopper/promo/R0006459.JPG', alt: 'Chopper ride' },
  { src: '/assets/chopper/promo/R0006463.JPG', alt: 'Chopper sunset' },
  { src: '/assets/chopper/promo/2512080004.jpg', alt: 'Chopper Kamakura' },
]);
---

<footer class="bg-deep-red">
  <!-- Instagram Gallery -->
  <div class="px-10 py-16 border-b border-white/[0.06]">
    <div class="max-w-[1200px] mx-auto">
      <span class="block text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">Instagram</span>

      <div class:list={[
        'grid gap-10',
        showBoth ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-1',
      ]}>
        {showEbike && (
          <div class:list={[!showBoth && 'max-w-[480px]']}>
            <div class="flex items-center gap-2 mb-2.5">
              <div class="w-1.5 h-1.5 rounded-full bg-ebike"></div>
              <a href={igEbike} target="_blank" class="text-[11px] font-semibold tracking-[0.12em] uppercase text-white/45 hover:text-white transition-colors">@beetlerider_ebike</a>
            </div>
            <div class="grid grid-cols-3 gap-1">
              {ebikePhotos.map((photo) => (
                <a href={igEbike} target="_blank" class="aspect-[4/5] rounded-lg overflow-hidden relative cursor-pointer group block">
                  <img src={photo.src} alt={photo.alt} class="w-full h-full object-cover" loading="lazy" />
                  <div class="absolute inset-0 bg-black/30 group-hover:bg-black/0 transition-colors"></div>
                </a>
              ))}
            </div>
          </div>
        )}

        {showChopper && (
          <div class:list={[!showBoth && 'max-w-[480px]']}>
            <div class="flex items-center gap-2 mb-2.5">
              <div class="w-1.5 h-1.5 rounded-full bg-brand"></div>
              <a href={igChopper} target="_blank" class="text-[11px] font-semibold tracking-[0.12em] uppercase text-white/45 hover:text-white transition-colors">@beetlerider_japan</a>
            </div>
            <div class="grid grid-cols-3 gap-1">
              {chopperPhotos.map((photo) => (
                <a href={igChopper} target="_blank" class="aspect-[4/5] rounded-lg overflow-hidden relative cursor-pointer group block">
                  <img src={photo.src} alt={photo.alt} class="w-full h-full object-cover" loading="lazy" />
                  <div class="absolute inset-0 bg-black/30 group-hover:bg-black/0 transition-colors"></div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Main Footer -->
  <div class="px-10 py-16 max-w-[1200px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-16">
    <!-- Brand Column -->
    <div class="flex flex-col gap-6">
      <img src="/assets/logo/OB_CORPORATE.svg" alt="OCEANBEETLE" class="h-10 w-auto self-start" />
      <p class="text-[13px] text-white/40 font-medium">BEETLE RIDER — A rental experience by OCEANBEETLE.</p>
      <div class="flex flex-wrap gap-3 mt-2">
        <a href={igEbike} target="_blank" class="flex items-center gap-2 px-4 py-2 rounded-full bg-white/[0.06] border border-white/[0.08] hover:bg-ebike hover:border-ebike hover:-translate-y-0.5 transition-all group">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white/60 group-hover:text-white">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
          </svg>
          <span class="text-[11px] font-semibold tracking-wider text-white/50 group-hover:text-white">E-BIKE</span>
        </a>
        <a href={igChopper} target="_blank" class="flex items-center gap-2 px-4 py-2 rounded-full bg-white/[0.06] border border-white/[0.08] hover:bg-brand hover:border-brand hover:-translate-y-0.5 transition-all group">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white/60 group-hover:text-white">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
          </svg>
          <span class="text-[11px] font-semibold tracking-wider text-white/50 group-hover:text-white">CHOPPER</span>
        </a>
        <a href={mapUrl} target="_blank" class="flex items-center gap-2 px-4 py-2 rounded-full bg-white/[0.06] border border-white/[0.08] hover:bg-white/15 hover:-translate-y-0.5 transition-all group">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white/60 group-hover:text-white">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          <span class="text-[11px] font-semibold tracking-wider text-white/50 group-hover:text-white">MAP</span>
        </a>
      </div>
    </div>

    <!-- Info Column -->
    <div class="flex flex-col gap-4 md:justify-end">
      <h4 class="text-[11px] font-bold tracking-[0.2em] uppercase text-white/30">Info</h4>
      <dl class="flex flex-col gap-3">
        <div>
          <dt class="text-[10px] font-semibold tracking-[0.15em] uppercase text-white/25 mb-1">Hours</dt>
          <dd class="text-sm text-white/55 font-medium">{siteConfig?.businessHours || '10:00 - 18:00'}</dd>
        </div>
        <div>
          <dt class="text-[10px] font-semibold tracking-[0.15em] uppercase text-white/25 mb-1">Tel</dt>
          <dd><a href={`tel:${siteConfig?.phone || '0467379926'}`} class="text-sm text-white/55 font-medium hover:text-white transition-colors">{siteConfig?.phone || '0467-37-9926'}</a></dd>
        </div>
        <div>
          <dt class="text-[10px] font-semibold tracking-[0.15em] uppercase text-white/25 mb-1">Location</dt>
          <dd><a href={mapUrl} target="_blank" class="text-sm text-white/55 font-medium hover:text-white transition-colors">{siteConfig?.address || '神奈川県鎌倉市由比ガ浜2-1-11'}</a></dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- Bottom Legal -->
  <div class="border-t border-white/[0.06] px-10 py-6 pb-20">
    <div class="max-w-[1200px] mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <span class="text-[11px] text-white/20">&copy; 2026 OCEANBEETLE Co., Ltd. All rights reserved.</span>
      <div class="flex flex-wrap items-center gap-4">
        <a href={`mailto:${siteConfig?.email || 'info@beetlerider.com'}`} class="text-[11px] text-white/25 hover:text-white/50 transition-colors underline">お問い合わせ</a>
        <span class="text-white/10">|</span>
        <a href={siteConfig?.privacyPolicyUrl || '#'} target="_blank" class="text-[11px] text-white/25 hover:text-white/50 transition-colors">Privacy Policy</a>
        <a href={siteConfig?.tokushohoUrl || '#'} target="_blank" class="text-[11px] text-white/25 hover:text-white/50 transition-colors">特定商取引法に基づく表記</a>
        <a href={siteConfig?.importantNoticesUrl || '#'} target="_blank" class="text-[11px] text-white/25 hover:text-white/50 transition-colors">重要事項説明</a>
      </div>
    </div>
  </div>
</footer>
