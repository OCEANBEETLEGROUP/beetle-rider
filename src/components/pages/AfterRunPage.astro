---
/**
 * AfterRunPage：ロッドショーの2日後のラン（2026-12-08 火）の特設ページ。名前は「BEETLE RUN」＋サブタイトル「HOT ROD SHOW AFTER RUN」（TAKE 11/24）
 *
 * 経緯: BR定例 第12回（2026-11-23）で有料のプラン ¥32,000（食事と高速代込み）に決定。11/24 TAKE「特設ページを作って、トップとチョッパーのページからリンク。
 * Googleフォームで申し込み → Square のリンク決済」。
 * 11/24 夕方 TAKE「逗子海岸のサンセットは描かなくていい」「日程も、箱根まで行って飯食うくらいのシンプルな感じで」「サイトは全部英語のみで大丈夫」
 * 「タイトルもバランスよく」「フォントは変えて。もっと手作り感満載のページに」「帯は日付をもっとわかりやすく」「アプライCTAはもうちょっと分かりやすく」
 * ＝壁に手作りのチラシを貼った見た目に作り直した。字は 筆記体 Mr Dafoe（名前）・マーカー Permanent Marker（見出し・書き込み）・タイプライター Special Elite（本文）。
 *   紙・マスキングテープ・ゴム印・手描きの線は、生成した絵を使わず CSS と手で書いた SVG で作る（AI 感を出さない）。
 *
 * - 英語だけ。日本語の URL（/beetle-run）は英語のページへ送る（src/pages/beetle-run.astro）
 * - noindex（BaseLayout の noindex）＋ サイトマップから外す（astro.config.mjs の filter）
 * - 申し込みの流れ: フォーム（江ノ島店の Gmail のフォーム）→ 先着順で決済リンクをメールで送る → 払ったら確定
 * - 締め切り: 一次募集は 11/30・二次募集はショー前日の 12/5。台数は書かない
 * - 12/8 18:00（日本時間）を過ぎたら、申し込みボタンを「終了」に切り替える（ビルド時と表示時の両方）
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdpChecker from '../../components/IdpChecker.astro';
import { localePath } from '../../i18n/config';

const lang = 'en' as const;

const EVENT = {
  endsAt: '2026-12-08T18:00:00+09:00',
  formUrl: 'https://docs.google.com/forms/d/e/1FAIpQLSdtUkXlgyKal-lftUGtGgZNZJSVEAZvHx0YTm78bpcoKoGF2A/viewform', // 江ノ島店の Gmail のフォーム（公開は TAKE の OK 後）
};
const closed = Date.now() > Date.parse(EVENT.endsAt);
const link = { href: EVENT.formUrl, target: '_blank', rel: 'noopener' };

// 日程は「箱根まで行ってご飯」くらいの粒度で（TAKE 11/24）。夕日とデザートは書かない
const plan = [
  { t: '10:00', d: 'Meet at BEETLE RIDER Kamakura' },
  { t: '', d: 'Ride to Hakone' },
  { t: '', d: 'Lunch' },
  { t: '', d: 'Ride back to Kamakura' },
];

// 国ごとの書類（JAF の翻訳文の国など）は、下の LICENSE CHECK で出るので書かない
const who = [
  'A full motorcycle license, no engine size limit.',
  'From overseas: an IDP with Category A, your home license and your passport.',
  'You ride a heavy bike in a group, in the mountains, in the cold.',
];

const steps = [
  { n: '1', t: 'Fill in the form', d: 'Takes 2 minutes. One form per rider.' },
  { n: '2', t: 'Get a payment link', d: 'We email links in the order the forms come in.' },
  { n: '3', t: 'Pay and you are in', d: 'Your bike is booked once you pay.' },
];

const know = [
  { k: 'Bring', v: 'Your license documents and passport. Warm layers: Hakone in December is cold.' },
  { k: 'Gear', v: 'We lend helmets, gloves and riding gear.' },
  { k: 'Rain', v: 'We cancel the ride and refund you in full.' },
  { k: 'Cancellation', v: 'No cancellations once you pay. Rain is the only exception.' },
  { k: 'Not included', v: 'Hotels and travel to Kamakura. Damage to the bike is not covered, same as our regular rental.' },
  { k: 'Meet', v: 'BEETLE RIDER Kamakura, 1-15-2 Komachi, Kamakura. 10:00 AM.', link: { href: localePath('/access', lang), label: 'SEE MAP' } },
];

const metaTitle = 'BEETLE RUN · Hot Rod Show After Run · Tue, Dec 8｜BEETLE RIDER Kamakura';
const metaDesc = 'The Hot Rod Show after run. Ride to Hakone on our choppers with JOSE and TSUGUMI, eat lunch, ride back. Tuesday, December 8. Meet 10:00 am in Kamakura. ¥32,000 all in.';
---

<BaseLayout title={metaTitle} description={metaDesc} activePage="chopper" headerLogo="chopper" ogImage="/assets/after-run/og.jpg" noindex={true}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Mr+Dafoe&family=Permanent+Marker&family=Special+Elite&display=swap" rel="stylesheet">
  </Fragment>

  <div class="brp">

    <!-- ===== 1. 名前と日付と申し込み（壁に貼ったチラシ） ===== -->
    <section class="sec sec-hero">
      <div class="paper flyer">
        <span class="tape tape-tl" aria-hidden="true"></span>
        <span class="tape tape-tr" aria-hidden="true"></span>

        <p class="presents">BEETLE RIDER KAMAKURA <i>presents</i></p>
        <div class="lockup">
          <p class="hotrod">★ HOT ROD SHOW AFTER RUN ★</p>
          <h1 class="title">Beetle Run</h1>
          <svg class="swash" viewBox="0 0 600 60" aria-hidden="true"><path d="M8 42 C 118 20, 298 9, 468 14 C 528 16, 574 22, 597 31 C 561 27, 521 25, 470 25 C 302 23, 132 35, 15 50 Z" /></svg>
        </div>

        <p class="lead">Ride to Hakone. Eat lunch. Ride back.</p>
        <p class="lead-sub">Two days after the Hot Rod show in Yokohama: one day on our choppers with JOSE &amp; TSUGUMI.</p>

        <div class="hero-row">
          <div class="when">
            <p class="cal" aria-label="Tuesday, December 8">
              <span class="cal-m">DEC</span>
              <span class="cal-d">8</span>
              <span class="cal-w">TUESDAY</span>
            </p>
            <p class="when-lines">
              <b>MEET 10:00 AM</b><br />
              BEETLE RIDER Kamakura<br />
              <b>¥32,000</b> all in
            </p>
          </div>

          <div class="cta" data-ar-open>
            {!closed && (
              <>
                <span class="apply-wrap">
                  <a class="apply" id="apply-top" {...link}>APPLY NOW <svg class="arr" viewBox="0 0 40 24" aria-hidden="true"><path d="M3 13 C 12 11, 22 12, 34 12" /><path d="M25 4 L 35 12 L 26 20" /></svg></a>
                  <span class="scrawl scrawl-cta" aria-hidden="true">
                    <svg class="scrawl-arrow" viewBox="0 0 60 40"><path d="M57 5 C 40 3, 22 11, 9 30" /><path d="M3 19 L 8 32 L 21 28" /></svg>
                    takes 2 min!
                  </span>
                </span>
                <p class="apply-note">Fill in the form. We email you a payment link.</p>
              </>
            )}
            {closed && <p class="closed-msg">This ride has finished. Thank you for riding with us.</p>}
          </div>
        </div>
        <p class="closed-msg" data-ar-closed hidden>This ride has finished. Thank you for riding with us.</p>
      </div>
    </section>

    <!-- ===== 2. 日程（シンプルに）と写真 ===== -->
    <section class="sec">
      <div class="grid-plan">
        <div class="paper card card-plan">
          <span class="tape tape-tl" aria-hidden="true"></span>
          <h2 class="h">The plan</h2>
          <svg class="route" viewBox="0 0 440 150" aria-hidden="true">
            <path class="route-sea" d="M14 132 q 9 -7 18 0 t 18 0 t 18 0 M40 144 q 9 -7 18 0 t 18 0" />
            <path class="route-hill" d="M292 78 L 318 40 L 334 58 L 356 26 L 392 78" />
            <path class="route-line" d="M58 116 C 120 92, 160 132, 222 104 S 318 92, 368 96" />
            <circle class="route-dot" cx="50" cy="118" r="9" />
            <circle class="route-dot" cx="374" cy="96" r="9" />
            <text class="route-label" x="20" y="100">KAMAKURA</text>
            <text class="route-label" x="330" y="128">HAKONE</text>
            <text class="route-note" x="392" y="62">lunch!</text>
          </svg>
          <ol class="plan">
            {plan.map((p) => (
              <li><span class="plan-t">{p.t ? p.t : <svg class="plan-arr" viewBox="0 0 40 24" aria-hidden="true"><path d="M3 13 C 12 11, 22 12, 34 12" /><path d="M25 4 L 35 12 L 26 20" /></svg>}</span><span class="plan-d">{p.d}</span></li>
            ))}
          </ol>
          <p class="scrawl scrawl-plan">about 6 hours</p>
          <p class="small">JOSE &amp; TSUGUMI from our Kamakura shop lead the ride.</p>
        </div>

        <div class="photos">
          <figure class="polaroid pol-1">
            <span class="tape tape-top" aria-hidden="true"></span>
            <img src="/assets/after-run/hero.webp" alt="Our choppers lined up by the sea, with Enoshima and Mt. Fuji behind" loading="lazy" width="2000" height="1333" />
            <figcaption>our choppers</figcaption>
          </figure>
          <figure class="polaroid pol-2">
            <span class="tape tape-top" aria-hidden="true"></span>
            <img src="/assets/after-run/ride.webp" alt="Riding together on our choppers" loading="lazy" width="1600" height="1067" />
            <figcaption>the pack</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ===== 3. 料金（値札）と乗れる人 ===== -->
    <section class="sec">
      <div class="grid-who">
        <div class="tag-wrap">
          <div class="tag">
            <span class="tag-hole" aria-hidden="true"></span>
            <p class="tag-k">ALL IN</p>
            <p class="tag-price">¥32,000</p>
            <p class="tag-per">per rider</p>
            <ul class="tag-list">
              <li>chopper for the day</li>
              <li>fuel</li>
              <li>lunch</li>
              <li>expressway tolls</li>
              <li>insurance</li>
            </ul>
            <p class="tag-gear">+ we lend helmets, gloves and gear</p>
          </div>
        </div>

        <div class="paper card card-who">
          <span class="tape tape-tr" aria-hidden="true"></span>
          <h2 class="h">Who can ride</h2>
          <ul class="stars">
            {who.map((w) => <li>{w}</li>)}
          </ul>
          <div class="ink-card">
            <IdpChecker lang={lang} />
          </div>
        </div>
      </div>
    </section>

    <!-- ===== 4. 申し込みの流れ ===== -->
    <section class="sec" id="how">
      <div class="paper card card-how">
        <span class="tape tape-tl" aria-hidden="true"></span>
        <span class="tape tape-tr" aria-hidden="true"></span>
        <h2 class="h">How to join</h2>
        <p class="scrawl scrawl-how">first come, first served</p>
        <ol class="steps">
          {steps.map((s) => (
            <li class="step">
              <svg class="step-n" viewBox="0 0 64 64" aria-hidden="true">
                <path d="M34 6 C 52 7, 60 22, 57 36 C 54 51, 40 59, 26 56 C 11 53, 4 40, 7 26 C 10 13, 22 5, 39 9" />
                <text x="32" y="44">{s.n}</text>
              </svg>
              <p class="step-t">{s.t}</p>
              <p class="step-d">{s.d}</p>
            </li>
          ))}
        </ol>
        <div class="how-bottom">
          <p class="note">
            <b>Deadlines</b><br />
            Round 1: Nov 30<br />
            Round 2: Dec 5
          </p>
          <div class="cta cta-how" data-ar-open>
            {!closed && (
              <>
                <a class="apply" id="apply-how" {...link}>APPLY NOW <svg class="arr" viewBox="0 0 40 24" aria-hidden="true"><path d="M3 13 C 12 11, 22 12, 34 12" /><path d="M25 4 L 35 12 L 26 20" /></svg></a>
                <p class="apply-note">2-minute form. We email you a payment link.</p>
              </>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- ===== 5. 知っておくこと ===== -->
    <section class="sec">
      <div class="paper card card-know">
        <span class="tape tape-tr" aria-hidden="true"></span>
        <h2 class="h">Good to know</h2>
        <dl class="know">
          {know.map((row) => (
            <div class="know-row">
              <dt>{row.k}</dt>
              <dd>
                {row.v}
                {'link' in row && row.link && <a class="inline-link" href={row.link.href}>{row.link.label}</a>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ===== 6. 最後の申し込み ===== -->
    <section class="sec sec-final">
      <div class="paper flyer flyer-final">
        <span class="tape tape-tl" aria-hidden="true"></span>
        <span class="tape tape-tr" aria-hidden="true"></span>
        <p class="stamp stamp-final" aria-hidden="true">FIRST COME<br />FIRST SERVED</p>
        <p class="hotrod">★ HOT ROD SHOW AFTER RUN ★</p>
        <p class="title title-final">Beetle Run</p>
        <p class="final-date"><span class="nw">TUE, DEC 8 · 10:00 AM</span><span class="sep"> · </span><span class="nw">KAMAKURA</span></p>
        <div class="cta" data-ar-open>
          {!closed && (
            <>
              <a class="apply" id="apply-final" {...link}>APPLY NOW <svg class="arr" viewBox="0 0 40 24" aria-hidden="true"><path d="M3 13 C 12 11, 22 12, 34 12" /><path d="M25 4 L 35 12 L 26 20" /></svg></a>
              <p class="apply-note">2-minute form. We email you a payment link.</p>
            </>
          )}
        </div>
        <p class="closed-msg" data-ar-closed hidden>This ride has finished. Thank you for riding with us.</p>
        <p class="ask">Questions? Message us on Instagram <a href="https://ig.me/m/beetlerider_japan" target="_blank" rel="noopener">@beetlerider_japan</a></p>
      </div>
    </section>

    {!closed && (
      <a class="float-apply" id="float-apply" data-ar-open {...link} aria-label="Apply now for BEETLE RUN on Tuesday, December 8">
        <span class="float-k">DEC 8</span>
        <span class="float-v">APPLY NOW <svg class="arr" viewBox="0 0 40 24" aria-hidden="true"><path d="M3 13 C 12 11, 22 12, 34 12" /><path d="M25 4 L 35 12 L 26 20" /></svg></span>
      </a>
    )}
  </div>

  <script is:inline define:vars={{ endsAt: EVENT.endsAt }}>
    // 12/8 18:00（日本時間）を過ぎたら、申し込みボタンを隠して「終了」を出す（ビルドし直さなくても切り替わる）
    if (Date.now() > Date.parse(endsAt)) {
      document.querySelectorAll('[data-ar-open]').forEach(function (el) { el.setAttribute('hidden', ''); });
      document.querySelectorAll('[data-ar-closed]').forEach(function (el) { el.removeAttribute('hidden'); });
    }
    // 下に送ったときに出る申し込みボタン（最初と途中と最後のボタンが見えている間は隠す）
    (function () {
      var fab = document.getElementById('float-apply');
      var top = document.getElementById('apply-top');
      if (!fab || !top || !('IntersectionObserver' in window)) return;
      var seen = { top: true, how: false, fin: false };
      var passed = false;
      function sync() { fab.classList.toggle('is-on', passed && !seen.top && !seen.how && !seen.fin); }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          var k = e.target.id === 'apply-top' ? 'top' : e.target.id === 'apply-how' ? 'how' : 'fin';
          seen[k] = e.isIntersecting;
          if (k === 'top') passed = !e.isIntersecting && e.boundingClientRect.top < 0;
        });
        sync();
      });
      ['apply-top', 'apply-how', 'apply-final'].forEach(function (id) { var el = document.getElementById(id); if (el) io.observe(el); });
    })();
  </script>

  <style>
    .brp {
      --ink: #1A1110;
      --red: #C30E23;
      --paper: #F3E8D2;
      --kraft: #D6B888;
      --tape: rgba(240, 229, 198, 0.8);
      --hand: 'Permanent Marker', 'Marker Felt', cursive;
      --type: 'Special Elite', 'Courier New', monospace;
      --script: 'Mr Dafoe', 'Brush Script MT', cursive;
      background-color: var(--color-deep-red);
      background-image: url(/assets/after-run/wall-grain.png);
      background-size: 256px;
      color: var(--ink);
      overflow-x: hidden;
      overflow-x: clip;
      padding: 104px 0 40px;
    }
    .sec { padding: 26px 24px; }
    .sec-hero { padding-top: 8px; }

    /* 紙・テープ */
    .paper { position: relative; background-color: var(--paper); background-image: url(/assets/after-run/paper-grain.png); background-size: 256px; box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06), 0 18px 30px -14px rgba(0, 0, 0, 0.7), 0 4px 10px rgba(0, 0, 0, 0.28); }
    .tape { position: absolute; z-index: 3; width: 128px; height: 32px; background: var(--tape); background-image: linear-gradient(90deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 45%, rgba(255, 255, 255, 0.14)); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2); clip-path: polygon(2% 0, 98% 5%, 100% 24%, 97% 46%, 100% 70%, 98% 100%, 3% 95%, 0 76%, 3% 52%, 0 28%); }
    .tape-tl { top: -13px; left: 22px; transform: rotate(-7deg); }
    .tape-tr { top: -13px; right: 22px; transform: rotate(6deg); }
    .tape-top { top: -15px; left: 50%; margin-left: -64px; transform: rotate(-3deg); }

    /* 手書きの書き込み */
    .scrawl { font-family: var(--hand); color: var(--red); line-height: 1.1; }

    /* ===== 1. チラシ ===== */
    .flyer { max-width: 980px; margin: 0 auto; padding: 50px 48px 46px; text-align: center; transform: rotate(-0.6deg); }
    .presents { font-family: var(--type); font-size: 14px; letter-spacing: 0.2em; margin-bottom: 14px; }
    .presents i { font-family: var(--script); font-style: normal; font-size: 28px; letter-spacing: 0; color: var(--red); margin-left: 4px; vertical-align: -3px; }
    .lockup { display: inline-flex; flex-direction: column; align-items: center; }
    .hotrod { font-family: var(--hand); font-size: clamp(14px, 2.45vw, 35px); letter-spacing: 0.07em; line-height: 1; white-space: nowrap; }   /* 名前の幅の8割5分ほどにそろえる（TAKE 11/24「タイトルもバランスよく」） */
    .title { font-family: var(--script); font-weight: 400; font-size: clamp(66px, 12vw, 172px); line-height: 0.86; color: var(--red); text-shadow: 3px 4px 0 var(--ink); transform: rotate(-4deg); margin: 10px 0 0; padding: 0 0.12em; white-space: nowrap; animation: br-in 0.7s cubic-bezier(0.2, 0.8, 0.3, 1.2) both; }
    .swash { display: block; width: 88%; height: auto; margin: -2px auto 0; transform: rotate(-4deg); fill: var(--ink); animation: br-draw 0.6s 0.45s ease-out both; }

    .hero-row { display: flex; justify-content: center; align-items: center; gap: 56px; margin-top: 30px; }
    .hero-row .cta { flex: none; }
    .when { display: flex; justify-content: center; align-items: center; gap: 22px; }
    .cal { flex: none; width: 122px; margin: 0; background: #FBF6EA; border: 3px solid var(--ink); border-radius: 4px; box-shadow: 4px 5px 0 var(--ink); transform: rotate(-3deg); text-align: center; overflow: hidden; }
    .cal-m { display: block; background: var(--red); color: #FBF6EA; font-family: var(--hand); font-size: 23px; letter-spacing: 0.14em; padding: 5px 0 2px; border-bottom: 3px solid var(--ink); }
    .cal-d { display: block; font-family: var(--hand); font-size: 68px; line-height: 1; padding-top: 8px; }
    .cal-w { display: block; font-family: var(--type); font-size: 13px; letter-spacing: 0.22em; padding: 2px 0 10px; }
    .when-lines { margin: 0; text-align: left; font-family: var(--type); font-size: 17px; line-height: 1.65; }
    .when-lines b { font-family: var(--hand); font-weight: 400; font-size: 23px; letter-spacing: 0.03em; }

    .lead { font-family: var(--hand); font-size: clamp(24px, 3.4vw, 34px); line-height: 1.15; margin: 18px 0 8px; }
    .lead-sub { font-family: var(--type); font-size: clamp(15px, 1.7vw, 17px); line-height: 1.7; max-width: 600px; margin: 0 auto; }

    .cta { position: relative; display: flex; flex-direction: column; align-items: center; }
    .apply { display: inline-flex; align-items: center; gap: 14px; white-space: nowrap; padding: 16px 38px 13px; background: var(--red); color: #FBF6EA; font-family: var(--hand); font-size: clamp(23px, 3vw, 29px); letter-spacing: 0.06em; line-height: 1.1; border: 3px solid var(--ink); border-radius: 16px 22px 14px 24px / 22px 14px 24px 16px; box-shadow: 5px 6px 0 var(--ink); transform: rotate(-1.5deg); transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease; }
    .arr { width: 1.2em; height: 0.72em; flex: none; fill: none; stroke: currentColor; stroke-width: 3.4; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.15s ease; }
    .apply:hover { background: #A80B1E; transform: rotate(-1.5deg) translate(-2px, -2px); box-shadow: 7px 8px 0 var(--ink); }
    .apply:hover .arr { transform: translateX(4px); }
    .apply:active { transform: rotate(-1.5deg) translate(3px, 4px); box-shadow: 2px 2px 0 var(--ink); }
    .apply-note { font-family: var(--type); font-size: 14px; line-height: 1.6; margin-top: 16px; }
    .apply-wrap { position: relative; display: inline-block; }
    .scrawl-cta { position: absolute; left: 56%; bottom: calc(100% + 8px); font-size: 20px; transform: rotate(-5deg); white-space: nowrap; }
    .scrawl-arrow { position: absolute; left: -44px; top: 12px; width: 42px; height: 28px; fill: none; stroke: var(--red); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
    .closed-msg { font-family: var(--hand); font-size: 22px; color: var(--red); }

    .stamp { position: absolute; margin: 0; color: var(--red); border: 3px solid currentColor; outline: 2px solid currentColor; outline-offset: 3px; padding: 7px 12px 5px; font-family: var(--type); font-weight: 700; font-size: 15px; line-height: 1.25; letter-spacing: 0.16em; text-align: center; opacity: 0.85; -webkit-mask-image: url(/assets/after-run/stamp-mask.png); mask-image: url(/assets/after-run/stamp-mask.png); -webkit-mask-size: 150px; mask-size: 150px; }
    
    /* ===== 2. 日程と写真 ===== */
    .grid-plan { max-width: 1040px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 44px; align-items: center; }
    .card { padding: 40px 38px 34px; }
