---
/**
 * AfterRunPage：ロッドショー後のアフターラン（2026-12-08 火）の特設ページ
 *
 * 経緯: BR定例 第12回（2026-11-23）で「有料のプラン ¥32,000（食事と高速代込み）・
 * 箱根 → OBBC でデザート → 七里ヶ浜で夕日」と決定。11/24 TAKE「特設ページを作って、
 * サイトのトップやチョッパーページのトップにリンク。Googleフォームで申し込み → Square のリンク決済」。
 *
 * - noindex（BaseLayout の noindex）＋ サイトマップから外す（astro.config.mjs の filter）
 * - 申し込みの流れ: フォーム → 店が免許と空きを確認 → 決済リンクをメールで送る → 払った順に確定
 *   （Square のリンクは定員で止まらないので、先にリンクを出さない）
 * - 未決（TBC）は EVENT の値が null / '' のとき「TBC / 未定」の印を出す。TAKE が決めたら値を入れる
 * - 12/8 18:00（日本時間）を過ぎたら、申し込みボタンを「終了」に切り替える（ビルド時と表示時の両方）
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdpChecker from '../../components/IdpChecker.astro';
import { getLangFromUrl, localePath } from '../../i18n/config';

const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';

// ===== 決まったら埋める（null / '' の間は TBC の印が出る） =====
const EVENT = {
  endsAt: '2026-12-08T18:00:00+09:00',
  formUrl: '',                       // Googleフォーム（変更提案の OK 後に作る）
  seats: null as number | null,      // 最大人数
  closesEn: '', closesJa: '',        // 申し込みの締め切り
  meetEn: '', meetJa: '',            // 集合の時間
  backEn: '', backJa: '',            // 店に戻る（解散）時間
  replyEn: '', replyJa: '',          // 申し込みへの返事の早さ（例: within 24 hours）
  fuelEn: '', fuelJa: '',            // ガソリン代の扱い
  helmetEn: '', helmetJa: '',        // ヘルメット・装備の扱い
  weatherEn: '', weatherJa: '',      // 雨・凍結のとき
  cancelEn: '', cancelJa: '',        // キャンセルの決まり
  lunchEn: '', lunchJa: '',          // 箱根の店
};
const closed = Date.now() > Date.parse(EVENT.endsAt);
const TBC = en ? 'TBC' : '未定';
const applyHref = EVENT.formUrl || '#how';

const T = en
  ? {
      metaTitle: 'AFTER RUN · Tue, Dec 8｜Ride Japan after the show｜BEETLE RIDER Kamakura',
      metaDesc: 'One day on vintage choppers with JOSE. Lunch in Hakone, dessert by the sea near Enoshima, sunset at Shichirigahama. Tuesday, December 8. ¥32,000 per rider. Only a few bikes.',
      tag: 'TUESDAY, DECEMBER 8 · ONE DAY ONLY',
      lead: 'After the show, ride Japan.',
      intro: 'The show is over. Before you fly home, take one day on our vintage choppers. Ride with JOSE. Lunch by Lake Ashi in Hakone, dessert by the sea, then the sun goes down over the water at Shichirigahama.',
      apply: 'APPLY FOR A BIKE',
      how: 'HOW IT WORKS',
      closedMsg: 'This ride has finished. Thank you for riding with us.',
      facts: [
        { k: 'DATE', v: 'Tue, Dec 8, 2026' },
        { k: 'PRICE', v: '¥32,000 per rider' },
        { k: 'INCLUDED', v: 'Your chopper for the day, lunch, dessert, expressway tolls' },
        { k: 'BIKES', v: null as string | null },
      ],
      bikesValue: (n: number) => `Only ${n} bikes`,
      dayLabel: 'THE DAY',
      dayTitle: 'Kamakura to Hakone and back to the sea.',
      day: [
        { time: EVENT.meetEn, needsTime: true, place: 'KAMAKURA', text: 'Meet at BEETLE RIDER Kamakura. Paperwork, license check and a short briefing on your bike.' },
        { time: '', place: 'HAKONE', text: 'West along the coast, then up into the mountains. We line the bikes up at Lake Ashi, take photos and have lunch.', note: EVENT.lunchEn, noteLabel: 'Lunch spot' },
        { time: '', place: 'ENOSHIMA', text: 'Back down to the sea. Dessert at OCEANBEETLE BREAKFAST CLUB, our cafe by the beach near Enoshima.' },
        { time: '4:30 PM', place: 'SHICHIRIGAHAMA', text: 'The sun goes down over the sea around 4:30 pm. On a clear day, Mt. Fuji and Enoshima sit right in front of you.' },
        { time: EVENT.backEn, needsTime: true, place: 'KAMAKURA', text: 'Back to the shop.' },
      ],
      joseLabel: 'RIDE WITH JOSE',
      joseTitle: 'The value of this day is the people you ride with.',
      joseText: [
        'JOSE runs our Kamakura shop and builds choppers (@build_by_jose). He leads the ride on roads he rides every week.',
        'Our crew rides with the group, speaks English and shoots photos and video along the way. No big event. Just a small pack of bikes and a long day in Japan.',
      ],
      whoLabel: 'WHO CAN JOIN',
      who: [
        'A full motorcycle license with no engine size limit.',
        'From overseas: an IDP with Category A, your home license and your passport. Germany, Switzerland, Taiwan, Monaco, Estonia and Slovenia: your home license with an official JAF translation. France and Belgium: either one.',
        'You are comfortable riding a heavy bike in a group, on mountain roads, in the cold.',
        'We check your documents again on the morning of the ride.',
      ],
      howLabel: 'HOW TO JOIN',
      howTitle: 'Three steps. Bikes go in the order payments arrive.',
      steps: [
        { n: '01', t: 'Apply', d: 'Send the form. It takes about two minutes. Tell us your license, your height and your riding experience.' },
        { n: '02', t: 'We check', d: 'We look at your license and email you a payment link (card, via Square).', extra: 'reply' },
        { n: '03', t: 'Pay and you are in', d: 'Your bike is confirmed when the payment arrives. If we are full, you go on the waitlist.' },
      ],
      closes: 'Applications close',
      replyLabel: 'We reply',
      knowLabel: 'GOOD TO KNOW',
      know: [
        { k: 'Included', v: 'Your chopper for the day, lunch in Hakone, dessert at OCEANBEETLE BREAKFAST CLUB, expressway tolls and third-party liability insurance.' },
        { k: 'Fuel', v: EVENT.fuelEn },
        { k: 'Helmet and gear', v: EVENT.helmetEn },
        { k: 'Not included', v: 'Hotels and travel to Kamakura. This is a day ride, not a tour package. Damage to the bike is not covered, same as our regular rental.' },
        { k: 'Bring', v: 'Your license documents and passport. Warm layers and gloves. Hakone in December is cold.' },
        { k: 'Rain or ice', v: EVENT.weatherEn },
        { k: 'Cancellation', v: EVENT.cancelEn },
        { k: 'Photos', v: 'Our crew shoots photos and video on the day. If you would rather not be in them, tell us in the form.' },
        { k: 'Meeting point', v: 'BEETLE RIDER Kamakura, 1-15-2 Komachi, Kamakura.', link: { href: localePath('/access', lang), label: 'ACCESS →' } },
      ],
      finalTitle: 'Only a few bikes. One day.',
      ask: 'Questions? Message us on Instagram',
    }
  : {
      metaTitle: 'AFTER RUN・12月8日（火）｜BEETLE RIDER 鎌倉',
      metaDesc: 'ロッドショーのあと、JOSE とビンテージのチョッパーで走る1日。箱根でお昼、江の島の近くでデザート、七里ヶ浜で夕日。12月8日（火）。¥32,000（食事・高速代込み）。台数わずか。',
      tag: '12月8日（火）・この日だけ',
      lead: 'ロッドショーのあと、日本を走る。',
      intro: 'ショーが終わって、国に帰る前の1日。うちのビンテージのチョッパーで、JOSE と走る。箱根の芦ノ湖でお昼、海に戻ってデザート、最後は七里ヶ浜で海に沈む夕日。',
      notice: '海外から日本に来ているお客さま向けのランです。案内は英語で行います。',
      toEn: 'ENGLISH PAGE →',
      apply: '申し込む',
      how: '申し込みの流れ',
      closedMsg: 'このランは終了しました。ありがとうございました。',
      facts: [
        { k: '日にち', v: '2026年12月8日（火）' },
        { k: '料金', v: '1人 ¥32,000' },
        { k: '含まれるもの', v: '1日分のチョッパー・お昼・デザート・高速代' },
        { k: '台数', v: null as string | null },
      ],
      bikesValue: (n: number) => `${n}台だけ`,
      dayLabel: 'THE DAY',
      dayTitle: '鎌倉から箱根へ、そして海に戻る。',
      day: [
        { time: EVENT.meetJa, needsTime: true, place: '鎌倉', text: 'BEETLE RIDER 鎌倉店に集合。書類と免許の確認、バイクの説明。' },
        { time: '', place: '箱根', text: '海沿いを西へ、そこから山へ。芦ノ湖でバイクを並べて写真を撮り、お昼。', note: EVENT.lunchJa, noteLabel: 'お店' },
        { time: '', place: '江の島', text: '海へ下りて、江の島の近くの OCEANBEETLE BREAKFAST CLUB でデザート。' },
        { time: '16:30ごろ', place: '七里ヶ浜', text: '16時半ごろ、海に夕日が沈む。晴れていれば、正面に富士山と江の島。' },
        { time: EVENT.backJa, needsTime: true, place: '鎌倉', text: '店に戻って解散。' },
      ],
      joseLabel: 'RIDE WITH JOSE',
      joseTitle: 'この日の価値は、誰と走るか。',
      joseText: [
        'JOSE は鎌倉店を任されていて、チョッパーも作る（@build_by_jose）。毎週走っている道を、先頭で案内します。',
        'スタッフも一緒に走り、英語で話し、写真と動画を撮ります。大きなイベントではなく、少ない台数で走る長い1日。',
      ],
      whoLabel: 'WHO CAN JOIN',
      who: [
        '排気量の制限のない二輪の免許（大型二輪）。',
        '海外の免許の方: Category A の入った国際免許（IDP）・母国の免許・パスポート。ドイツ・スイス・台湾・モナコ・エストニア・スロベニアは、母国の免許と JAF の翻訳文。フランスとベルギーはどちらでも可。',
        '重いバイクで、山道を、寒い中、何台かで走るのに慣れている方。',
        '当日の朝にも、書類をもう一度確認します。',
      ],
      howLabel: 'HOW TO JOIN',
      howTitle: '3つの手順。払った順に台が決まります。',
      steps: [
        { n: '01', t: '申し込む', d: 'フォームを送る（2分ほど）。免許・身長・乗った経験を書いてください。' },
        { n: '02', t: '店が確かめる', d: '免許を確かめて、決済のリンク（カード・Square）をメールで送ります。', extra: 'reply' },
        { n: '03', t: '払ったら確定', d: '払い終わった時点で台が決まります。いっぱいのときは、キャンセル待ちになります。' },
      ],
      closes: '申し込みの締め切り',
      replyLabel: '返事',
      knowLabel: 'GOOD TO KNOW',
      know: [
        { k: '含まれるもの', v: '1日分のチョッパー・箱根のお昼・OCEANBEETLE BREAKFAST CLUB のデザート・高速代・対人対物の保険。' },
        { k: 'ガソリン', v: EVENT.fuelJa },
        { k: 'ヘルメット・装備', v: EVENT.helmetJa },
        { k: '含まれないもの', v: '宿と鎌倉までの交通。日帰りのランで、旅行のパッケージではありません。車両の損害は、いつものレンタルと同じく補償の外です。' },
        { k: '持ち物', v: '免許の書類とパスポート。暖かい服と手袋（12月の箱根は寒い）。' },
        { k: '雨・凍結', v: EVENT.weatherJa },
        { k: 'キャンセル', v: EVENT.cancelJa },
        { k: '写真', v: '当日はスタッフが写真と動画を撮ります。写りたくない方はフォームで教えてください。' },
        { k: '集合場所', v: 'BEETLE RIDER 鎌倉店（鎌倉市小町1-15-2）', link: { href: localePath('/access', lang), label: 'アクセス →' } },
      ],
      finalTitle: '台数わずか。この日だけ。',
      ask: '質問はインスタの DM へ',
    };

const facts = T.facts.map((f) => (f.v === null ? { ...f, v: EVENT.seats ? T.bikesValue(EVENT.seats) : null } : f));
const replyValue = en ? EVENT.replyEn : EVENT.replyJa;
const closesValue = en ? EVENT.closesEn : EVENT.closesJa;
---

<BaseLayout title={T.metaTitle} description={T.metaDesc} activePage="chopper" headerLogo="chopper" ogImage="/assets/after-run/og.jpg" noindex={true}>

  <!-- Hero -->
  <section class="ar-hero">
    <img src="/assets/after-run/hero.webp" alt={en ? 'Our choppers lined up on the Shonan coast with Enoshima and Mt. Fuji' : '江の島と富士山を背に並んだチョッパー'} class="ar-hero-img" loading="eager" width="2000" height="1333" />
    <div class="ar-hero-shade"></div>
    <div class="ar-hero-inner">
      <p class="ar-tag">{T.tag}</p>
      <h1 class="ar-title">AFTER RUN</h1>
      <div class="ar-stripes" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <p class="ar-lead">{T.lead}</p>
      <p class="ar-intro">{T.intro}</p>
      {!en && (
        <p class="ar-notice">{(T as any).notice} <a href={localePath('/after-run', 'en')}>{(T as any).toEn}</a></p>
      )}
      <div class="ar-ctas" data-ar-open>
        {!closed && <a class="ar-btn" href={applyHref}>{T.apply}</a>}
        {!closed && <a class="ar-btn ar-btn-ghost" href="#how">{T.how}</a>}
        {closed && <p class="ar-closed">{T.closedMsg}</p>}
        {!closed && !EVENT.formUrl && <span class="ar-tbc">{en ? 'FORM LINK: TBC' : 'フォームのリンク: 未定'}</span>}
      </div>
      <p class="ar-closed" data-ar-closed hidden>{T.closedMsg}</p>
    </div>
  </section>

  <!-- Facts -->
  <section class="ar-sec ar-sec-tight">
    <div class="ar-wrap ar-facts">
      {facts.map((f) => (
        <div class="ar-fact">
          <p class="ar-fact-k">{f.k}</p>
          <p class="ar-fact-v">{f.v ?? <span class="ar-tbc">{TBC}</span>}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- The day -->
  <section class="ar-sec">
    <div class="ar-wrap">
      <p class="ar-label">{T.dayLabel}</p>
      <h2 class="ar-h2">{T.dayTitle}</h2>
      <ol class="ar-day">
        {T.day.map((d) => (
          <li class="ar-stop">
            <p class="ar-stop-time">{d.time ? d.time : ((d as any).needsTime ? <span class="ar-tbc">{TBC}</span> : '')}</p>
            <div>
              <p class="ar-stop-place">{d.place}</p>
              <p class="ar-stop-text">{d.text}</p>
              {'noteLabel' in d && (
                <p class="ar-stop-note">{(d as any).noteLabel}: {(d as any).note ? (d as any).note : <span class="ar-tbc">{TBC}</span>}</p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Ride with JOSE -->
  <section class="ar-sec">
    <div class="ar-wrap ar-jose">
      <div class="ar-jose-img">
        <img src="/assets/after-run/ride.webp" alt={en ? 'Riding together on our choppers' : 'チョッパーで一緒に走る'} loading="lazy" width="1600" height="1067" />
      </div>
      <div>
        <p class="ar-label">{T.joseLabel}</p>
        <h2 class="ar-h2">{T.joseTitle}</h2>
        {T.joseText.map((p) => <p class="ar-p">{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Who can join -->
  <section class="ar-sec">
    <div class="ar-wrap ar-narrow">
      <p class="ar-label">{T.whoLabel}</p>
      <ul class="ar-list">
        {T.who.map((w) => <li>{w}</li>)}
      </ul>
      <div class="ar-idp">
        <IdpChecker lang={lang} />
      </div>
    </div>
  </section>

  <!-- How to join -->
  <section class="ar-sec" id="how">
    <div class="ar-wrap">
      <p class="ar-label">{T.howLabel}</p>
      <h2 class="ar-h2">{T.howTitle}</h2>
      <div class="ar-steps">
        {T.steps.map((s) => (
          <div class="ar-step">
            <p class="ar-step-n">{s.n}</p>
            <p class="ar-step-t">{s.t}</p>
            <p class="ar-step-d">{s.d}</p>
            {s.extra === 'reply' && (
              <p class="ar-step-x">{T.replyLabel}: {replyValue ? replyValue : <span class="ar-tbc">{TBC}</span>}</p>
            )}
          </div>
        ))}
      </div>
      <div class="ar-apply-row" data-ar-open>
        {!closed && <a class="ar-btn" href={applyHref}>{T.apply}</a>}
        <p class="ar-closes">{T.closes}: {closesValue ? closesValue : <span class="ar-tbc">{TBC}</span>}</p>
      </div>
    </div>
  </section>

  <!-- Good to know -->
  <section class="ar-sec">
    <div class="ar-wrap ar-narrow">
      <p class="ar-label">{T.knowLabel}</p>
      <dl class="ar-know">
        {T.know.map((row) => (
          <div class="ar-know-row">
            <dt>{row.k}</dt>
            <dd>
              {row.v ? row.v : <span class="ar-tbc">{TBC}</span>}
              {'link' in row && row.link && <a class="ar-inline-link" href={row.link.href}>{row.link.label}</a>}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="ar-final">
    <div class="ar-stripes ar-stripes-wide" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="ar-wrap ar-final-inner">
      <p class="ar-final-date">{en ? 'TUE, DEC 8' : '12月8日（火）'}</p>
      <h2 class="ar-final-title">{T.finalTitle}</h2>
      <div data-ar-open>
        {!closed && <a class="ar-btn" href={applyHref}>{T.apply}</a>}
      </div>
      <p class="ar-ask">{T.ask} <a href="https://ig.me/m/beetlerider_japan" target="_blank" rel="noopener">@beetlerider_japan</a></p>
    </div>
  </section>

  <script is:inline define:vars={{ endsAt: EVENT.endsAt }}>
    // 12/8 18:00（日本時間）を過ぎたら、申し込みボタンを隠して「終了」を出す（ビルドし直さなくても切り替わる）
    if (Date.now() > Date.parse(endsAt)) {
      document.querySelectorAll('[data-ar-open]').forEach(function (el) { el.setAttribute('hidden', ''); });
      document.querySelectorAll('[data-ar-closed]').forEach(function (el) { el.removeAttribute('hidden'); });
    }
  </script>

  <style>
    .ar-hero { position: relative; min-height: 92svh; display: flex; align-items: flex-end; overflow: hidden; background: #111; padding-top: 66px; }
    .ar-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; filter: saturate(0.85) sepia(0.18) contrast(1.02); }
    .ar-hero-shade { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(20, 6, 4, 0.15) 0%, rgba(20, 6, 4, 0.25) 40%, rgba(45, 10, 10, 0.96) 100%); }
    .ar-hero-inner { position: relative; z-index: 2; width: 100%; max-width: 1000px; margin: 0 auto; padding: 0 24px 56px; }
    .ar-tag { font-size: 11px; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase; color: #F3E7CF; opacity: 0.85; margin-bottom: 14px; }
    .ar-title { font-family: var(--font-heading); font-size: clamp(64px, 14vw, 168px); line-height: 0.88; letter-spacing: -0.02em; color: #F3E7CF; margin: 0 0 18px; text-shadow: 0 4px 30px rgba(0, 0, 0, 0.35); }
    .ar-stripes { display: grid; gap: 5px; width: min(420px, 70%); margin-bottom: 22px; }
    .ar-stripes i { display: block; height: 7px; border-radius: 2px; }
    .ar-stripes i:nth-child(1) { background: var(--color-brand); }
    .ar-stripes i:nth-child(2) { background: #E2672B; }
    .ar-stripes i:nth-child(3) { background: #E9A93A; }
    .ar-stripes i:nth-child(4) { background: #F3E7CF; }
    .ar-lead { font-family: var(--font-heading); font-size: clamp(22px, 3.4vw, 38px); color: #fff; letter-spacing: -0.01em; margin-bottom: 14px; }
    .ar-intro { font-size: clamp(14px, 1.6vw, 17px); line-height: 1.85; color: rgba(255, 255, 255, 0.78); max-width: 640px; margin-bottom: 22px; }
    .ar-notice { font-size: 13px; line-height: 1.8; color: #F3E7CF; background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(243, 231, 207, 0.25); border-radius: 12px; padding: 10px 14px; max-width: 640px; margin-bottom: 22px; }
    .ar-notice a { font-weight: 700; text-decoration: underline; text-underline-offset: 3px; margin-left: 6px; white-space: nowrap; }
    .ar-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
    .ar-btn { display: inline-flex; align-items: center; justify-content: center; padding: 15px 28px; border-radius: 999px; background: var(--color-brand); color: #fff; font-weight: 800; font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; transition: transform 0.2s ease, background 0.2s ease; }
    .ar-btn:hover { transform: translateY(-2px); background: #a80b1e; }
    .ar-btn-ghost { background: transparent; border: 1px solid rgba(255, 255, 255, 0.4); }
    .ar-btn-ghost:hover { background: rgba(255, 255, 255, 0.08); }
    .ar-closed { font-size: 15px; font-weight: 700; color: #F3E7CF; }
    .ar-tbc { display: inline-block; padding: 1px 8px; border: 1px dashed #E9A93A; border-radius: 6px; color: #E9A93A; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; vertical-align: middle; }

    .ar-sec { background: var(--color-deep-red); padding: 72px 24px; }
    .ar-sec-tight { padding: 28px 24px 8px; }
    .ar-wrap { max-width: 1000px; margin: 0 auto; }
    .ar-narrow { max-width: 820px; }
