            <g transform="translate(846,54)">
              <circle r="13" fill="none" stroke="white" stroke-opacity="0.18"/>
              <path d="M 0,-8 L 3,3.5 L 0,1.6 L -3,3.5 Z" fill="var(--color-brand)" fill-opacity="0.8"/>
