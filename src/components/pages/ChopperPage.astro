  <!-- ============================
       Page-Scoped Styles (SVG map)
       ============================ -->
  <style>
    /* Hero Animations */
    @keyframes heroFadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes scrollBounce {
