  <!-- ============================
       Section 4: License Check（独立セクション）
       予約検討が始まる直前＝行き先で気分が上がった直後に「自分は乗れるか」を
       30秒で解消する配置（顧客動線: 車両・価格→行き先→★資格確認→ルール→予約）
       ============================ -->
  <section class="py-24 max-md:py-16 px-10 max-md:px-6 bg-deep-red border-y border-white/[0.05]" id="licenseCheck">
    <div class="max-w-[800px] mx-auto">
      <div class="text-center mb-10 reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-brand mb-4">LICENSE CHECK</p>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(26px,3.5vw,42px)] text-white tracking-[-0.02em] mb-4">{lang === 'en' ? 'Can You Ride?' : 'あなたの免許で乗れる？'}</h2>
        <p class="text-[13.5px] text-white/50 leading-[1.9]">{lang === 'en' ? 'Thirty seconds before you plan the ride — pick the country that issued your license, and we’ll tell you exactly what to bring.' : '予約の前に、30秒だけ。免許を発行した国を選ぶと、必要な書類がその場でわかります。'}</p>
      </div>
      <div class="reveal reveal-delay-1">
        <IdpChecker lang={lang} showHeader={false} />
      </div>
    </div>
  </section>

