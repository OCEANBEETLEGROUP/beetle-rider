---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVehicles, getDestinations } from '../../lib/microcms';
import { getLangFromUrl, localePath } from '../../i18n/config';
import { t } from '../../i18n/index';

const lang = getLangFromUrl(Astro.url);

const { contents: vehiclesRaw } = await getVehicles();
// Exclude 公開終了 items (closedAt present = ended publication, even if API key returns them)
const published = vehiclesRaw.filter(v => !(v as any).closedAt);
// Display logic: active → normal, maintenance → viewable/no booking, hidden → COMING SOON
const vehicles = published.map((v, i) => ({
  slug: v.slug,
  name: v.name,
  specs: `${v.base} — Hard Tail ${v.style || 'Chopper'}`,
  num: String(i + 1).padStart(2, '0'),
  img: v.thumbnail.url + '?w=800&q=80',
  status: v.status?.[0] || 'active',
}));

const { contents: destinationsRaw } = await getDestinations('chopper');
const destinations = destinationsRaw.map(d => ({
  img: d.image.url + '?w=800&q=80',
  name: d.name.toUpperCase(),
  desc: lang === 'en'
    ? `${d.name} — ${d.description?.split('.')[0] || ''}`
    : `${d.nameJp} — ${d.descriptionJp?.split('。')[0] || ''}`,
  time: d.timeFromBase || '',
  detail: lang === 'en'
    ? `<strong>${d.name}</strong><br>${d.description || ''}`
    : `<strong>${d.nameJp}</strong><br>${d.descriptionJp || ''}`,
}));

const faqKeys = ['license', 'alcohol', 'weather', 'checkin', 'equipment', 'clothing', 'fuel', 'insurance', 'tandem', 'luggage', 'extension', 'cancel'] as const;
const protocolItems = faqKeys.map(key => ({
  title: t(lang, `chopper.faq.${key}.title` as any) as string,
  content: t(lang, `chopper.faq.${key}.content` as any) as string,
}));

// SEO structured data (Service + FAQPage)
const chopperPageUrl = `https://beetlerider.com${Astro.url.pathname}`;
const chopperSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Motorcycle Rental',
    name: lang === 'en' ? 'Kamakura Chopper Rental' : '鎌倉 チョッパー・ハーレーレンタル',
    description: lang === 'en'
      ? 'Vintage chopper (Harley-based) motorcycle rental in Kamakura, Japan. License + IDP required.'
      : '鎌倉でのヴィンテージ・チョッパー（ハーレー）レンタル。要二輪免許。',
    provider: { '@id': 'https://beetlerider.com/#localbusiness' },
    areaServed: { '@type': 'City', name: 'Kamakura' },
    url: chopperPageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: protocolItems.map(f => ({
      '@type': 'Question',
      name: f.title,
      acceptedAnswer: { '@type': 'Answer', text: f.content.replace(/<[^>]+>/g, '') },
    })),
  },
];
---

<BaseLayout title={t(lang, 'meta.chopper.title') as string} description={t(lang, 'meta.chopper.desc') as string} activePage="chopper" headerLogo="chopper" schema={chopperSchema}>

  <!-- ============================
       Section 1: Hero — Cinematic
       ============================ -->
  <section class="relative h-screen max-lg:h-[100svh] min-h-[600px] max-md:min-h-0 flex items-center justify-center overflow-hidden" id="hero">
    <!-- Video Background -->
    <div class="absolute inset-0 bg-[#0a0a0a] z-0">
      <video autoplay muted loop playsinline preload="metadata" poster="/assets/chopper/promo/R0006459.webp" class="w-full h-full object-cover" id="heroVideo">
        <source src="/assets/video/CHOPPER.mp4" type="video/quicktime">
        <source src="/assets/video/CHOPPER.mp4" type="video/mp4">
      </video>
    </div>
    <!-- Overlay -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_80%,rgba(195,13,35,0.08)_0%,transparent_60%),linear-gradient(to_bottom,rgba(0,0,0,0.3)_0%,rgba(0,0,0,0.6)_100%)] z-[1]"></div>
    <!-- Film Grain Noise -->
    <div class="absolute inset-0 z-[1] opacity-40" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E&quot;)"></div>
    <!-- Content -->
    <div class="relative z-[2] text-center px-6">
      <p class="text-[11px] font-bold tracking-[0.4em] uppercase text-brand mb-6 opacity-0 animate-[heroFadeUp_1s_ease_forwards_0.6s]">{t(lang, 'chopper.hero.label')}</p>
      <h1 class="font-[family-name:var(--font-heading)] text-[clamp(56px,12vw,140px)] text-white tracking-[-0.03em] leading-[0.9] mb-4 opacity-0 animate-[heroFadeUp_1s_ease_forwards_0.8s]" set:html={(t(lang, 'chopper.hero.heading') as string).replace('\n', '<br>')} />
      <h2 class="font-[family-name:var(--font-heading)] text-[clamp(24px,5vw,56px)] text-white/85 tracking-[-0.01em] leading-[1.1] mb-6 opacity-0 animate-[heroFadeUp_1s_ease_forwards_1s]">{t(lang, 'chopper.hero.sub')}</h2>
      <p class="font-[family-name:var(--font-heading-jp)] text-[clamp(13px,1.5vw,17px)] font-medium text-white/40 tracking-[0.08em] opacity-0 animate-[heroFadeUp_1s_ease_forwards_1.2s]">{t(lang, 'chopper.hero.desc')}</p>
    </div>
    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-[2] flex flex-col items-center gap-2 opacity-0 animate-[heroFadeUp_1s_ease_forwards_1.5s]">
      <span class="text-[9px] font-semibold tracking-[0.3em] uppercase text-white/30">{t(lang, 'common.scroll')}</span>
      <svg class="w-5 h-5 text-white/30 animate-[scrollBounce_2s_ease-in-out_infinite]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  </section>

  <!-- ============================
       Section 2: Vehicle Gallery
       ============================ -->
  <section class="pt-20 pb-24 bg-deep-red relative overflow-hidden" id="gallery">
    <div class="text-center mb-10 px-10">
      <div class="reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">{t(lang, 'chopper.fleet.label')}</p>
      </div>
      <div class="reveal reveal-delay-1">
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(28px,4vw,52px)] text-white tracking-[-0.02em]">{t(lang, 'chopper.fleet.heading')}</h2>
      </div>
    </div>
    <div class="relative px-16 max-md:px-4">
      <!-- Prev Button -->
      <button class="absolute top-1/2 -translate-y-1/2 left-4 z-10 w-12 h-12 rounded-full bg-white/[0.08] border border-white/[0.12] backdrop-blur-[12px] flex items-center justify-center cursor-pointer transition-all duration-300 hover:bg-white/[0.16] hover:border-white/25 hover:-translate-y-1/2 hover:scale-105 max-md:hidden" id="galleryPrev" aria-label="Previous">
        <svg class="w-[18px] h-[18px] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <!-- Track -->
      <div class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth py-4 pb-10 cursor-grab [&:active]:cursor-grabbing [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden max-md:px-4" id="galleryTrack">
        {vehicles.map((v) => (
          v.status === 'hidden' ? (
            <div class="flex-none w-[400px] max-lg:w-[340px] max-md:w-[320px] aspect-[3/4] rounded-2xl overflow-hidden relative snap-center cursor-not-allowed select-none">
              <div class="absolute inset-0 bg-[#111]">
                <img src={v.img} alt={v.name} loading="lazy" class="w-full h-full object-cover blur-[6px] brightness-50" />
              </div>
              <div class="absolute inset-0 bg-black/40 z-[1]"></div>
              <div class="absolute inset-0 flex flex-col items-center justify-center z-[2]">
                <p class="font-[family-name:var(--font-heading)] text-[clamp(20px,2.5vw,28px)] text-white/80 tracking-[0.15em] uppercase">COMING SOON</p>
                <p class="font-[family-name:var(--font-heading)] text-sm text-white/40 tracking-wide mt-2">{v.name}</p>
              </div>
            </div>
          ) : (
            <a href={localePath('/chopper/' + v.slug, lang)} class="group flex-none w-[400px] max-lg:w-[340px] max-md:w-[320px] aspect-[3/4] rounded-2xl overflow-hidden relative snap-center transition-transform duration-500 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] hover:-translate-y-2 cursor-pointer">
              <div class="absolute inset-0 bg-[#111] transition-transform duration-600 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-hover:scale-[1.06]">
                <img src={v.img} alt={v.name} loading="lazy" class={`w-full h-full object-cover${v.status === 'maintenance' ? ' brightness-75 saturate-50' : ''}`} />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-black/20 z-[1]"></div>
              {v.status === 'maintenance' && (
                <div class="absolute top-4 left-4 z-[3] px-3 py-1.5 rounded-full bg-amber-500/90 backdrop-blur-[8px] text-[10px] font-bold tracking-[0.12em] uppercase text-white">
                  MAINTENANCE
                </div>
              )}
              <div class="absolute bottom-0 left-0 right-0 p-8 z-[2]">
                <p class="font-[family-name:var(--font-heading)] text-xs text-brand tracking-[0.15em] mb-3 opacity-70">{v.num}</p>
                <h3 class="font-[family-name:var(--font-heading)] text-[clamp(24px,3vw,32px)] text-white tracking-[-0.01em] leading-none mb-2">{v.name}</h3>
                <p class="text-xs font-medium text-white/45 tracking-[0.03em] leading-relaxed">{v.specs}</p>
                <div class="flex items-center gap-2 mt-5 text-[11px] font-bold tracking-[0.2em] uppercase text-white opacity-0 translate-y-2 transition-all duration-400 group-hover:opacity-100 group-hover:translate-y-0">
                  <span>{t(lang, 'chopper.fleet.viewDetails')}</span>
                  <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </div>
              </div>
            </a>
          )
        ))}
      </div>
      <!-- Next Button -->
      <button class="absolute top-1/2 -translate-y-1/2 right-4 z-10 w-12 h-12 rounded-full bg-white/[0.08] border border-white/[0.12] backdrop-blur-[12px] flex items-center justify-center cursor-pointer transition-all duration-300 hover:bg-white/[0.16] hover:border-white/25 hover:-translate-y-1/2 hover:scale-105 max-md:hidden" id="galleryNext" aria-label="Next">
        <svg class="w-[18px] h-[18px] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
    <!-- Dots -->
    <div class="flex justify-center gap-2 mt-6" id="galleryProgress">
      {vehicles.map((_, i) => (
        <button class:list={['h-2 rounded-full border-none cursor-pointer transition-all duration-300 p-0', i === 0 ? 'bg-brand w-6' : 'bg-white/15 w-2']} data-index={i} aria-label={`Slide ${i + 1}`}></button>
      ))}
    </div>
  </section>

  <!-- ============================
       Section 3: Route 134 Map
       ============================ -->
  <section class="py-24 px-10 max-md:py-16 max-md:px-4 bg-deep-red overflow-hidden reveal" id="routeMap">
    <div class="max-w-[1200px] mx-auto text-center">
      <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">{t(lang, 'chopper.route.label')}</p>
      <h2 class="font-[family-name:var(--font-heading)] text-[clamp(20px,3.5vw,36px)] text-white tracking-[-0.02em] mb-16">{t(lang, 'chopper.route.heading')}</h2>
      <div class="w-full mx-auto">
        <svg viewBox="0 0 1000 400" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
          <!-- Sagami Bay coastline -->
          <path class="fill-none stroke-white/[0.06] stroke-1" d="M 0,320 Q 120,310 250,305 Q 400,295 550,290 Q 650,285 750,295 Q 830,310 900,340 L 1000,370" />
          <!-- Route 134 main road -->
          <path class="route-map__road" d="M 80,240 C 150,235 200,230 250,225 C 350,215 380,210 420,205 C 480,198 520,195 550,195 C 620,195 650,200 680,210 C 720,222 750,240 780,260" />
          <!-- Branch road to Yokosuka -->
          <path class="route-map__branch" d="M 650,205 C 700,185 750,155 850,120" />
          <!-- Hakone -->
          <circle class="route-map__dot" cx="80" cy="240" r="5" />
          <text class="route-map__label" x="80" y="270">HAKONE</text>
          <!-- Odawara -->
          <circle class="route-map__dot" cx="250" cy="225" r="5" />
          <text class="route-map__label" x="250" y="255">ODAWARA</text>
          <!-- Enoshima -->
          <circle class="route-map__dot" cx="420" cy="205" r="5" />
          <text class="route-map__label" x="420" y="190">ENOSHIMA</text>
          <!-- Kamakura SHOP -->
          <circle class="route-map__dot route-map__dot--shop" cx="550" cy="195" r="7" />
          <polygon class="route-map__star" points="550,148 554,160 567,160 556,168 560,180 550,173 540,180 544,168 533,160 546,160" />
          <text class="route-map__label route-map__label--shop" x="550" y="136">KAMAKURA SHOP</text>
          <text class="route-map__label" x="550" y="228">KAMAKURA</text>
          <!-- Zushi -->
          <circle class="route-map__dot" cx="680" cy="210" r="5" />
          <text class="route-map__label" x="680" y="240">ZUSHI</text>
          <!-- Hayama -->
          <circle class="route-map__dot" cx="780" cy="260" r="5" />
          <text class="route-map__label" x="780" y="290">HAYAMA</text>
          <!-- Yokosuka -->
          <circle class="route-map__dot" cx="850" cy="120" r="5" />
          <text class="route-map__label" x="850" y="108">YOKOSUKA</text>
          <!-- Bay label -->
          <text style="font-family: var(--font-heading); font-size: 16px; fill: rgba(255,255,255,0.08); letter-spacing: 0.3em;" x="350" y="350">SAGAMI BAY</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- ============================
       Section 4: Destinations
       ============================ -->
  <section class="py-32 px-10 max-md:py-24 max-md:px-6 bg-deep-red" id="destinations">
    <div class="max-w-[1200px] mx-auto">
      <div class="text-center mb-16 reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">{t(lang, 'chopper.dest.label')}</p>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(28px,5vw,56px)] text-white tracking-[-0.02em]">{t(lang, 'chopper.dest.heading')}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 items-stretch">
        {destinations.map((d, i) => (
          <div class={`dest-card relative rounded-2xl overflow-hidden aspect-[3/4] max-lg:aspect-[4/3] cursor-pointer reveal reveal-delay-${i + 1}`} data-dest-card>
            <div class="absolute inset-0 bg-[#111] transition-transform duration-800 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] hover-parent-scale">
              <img src={d.img} alt={d.name} loading="lazy" class="w-full h-full object-cover" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-deep-red/85 via-deep-red/10 to-transparent z-[1]"></div>
            <!-- Time Badge -->
            <div class="absolute top-4 right-4 z-[3] flex items-center gap-1 px-2.5 py-1.5 rounded-full bg-black/55 backdrop-blur-[8px] border border-white/[0.12] text-[11px] font-semibold text-white tracking-[0.04em]">
              <svg class="w-3 h-3 text-brand shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {d.time}
            </div>
            <!-- Base Content -->
            <div class="absolute bottom-0 left-0 right-0 p-7 z-[2]">
              <h3 class="font-[family-name:var(--font-heading)] text-[clamp(22px,3.5vw,28px)] text-white tracking-[-0.01em]">{d.name}</h3>
              <p class="font-[family-name:var(--font-heading-jp)] text-[13px] text-white/60 mt-1 tracking-[0.02em] line-clamp-1">{d.desc}</p>
            </div>
            <!-- Expand Detail Panel -->
            <div class="dest-card__detail absolute bottom-0 left-0 right-0 z-[3] bg-gradient-to-t from-deep-red/95 via-deep-red/85 to-transparent px-6 pb-7 pt-20 transition-all duration-400 ease-[cubic-bezier(0.25,0.46,0.45,0.94)]" style="transform: translateY(100%); opacity: 0; pointer-events: none;">
              <p class="font-[family-name:var(--font-heading-jp)] text-[13px] text-white/75 leading-[1.8]" set:html={d.detail}></p>
            </div>
            <span class="dest-card__tap-hint absolute bottom-2 left-1/2 -translate-x-1/2 z-[3] text-[9px] font-semibold tracking-[0.15em] uppercase text-white/25 transition-opacity duration-300">{t(lang, 'chopper.dest.tap')}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================
       Section 5: Protocol
       ============================ -->
  <section class="py-32 px-10 max-md:py-24 max-md:px-6 bg-deep-red">
    <div class="max-w-[800px] mx-auto">
      <!-- Header -->
      <div class="text-center mb-16">
        <div class="reveal">
          <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">{t(lang, 'chopper.protocol.label')}</p>
        </div>
        <div class="reveal reveal-delay-1">
          <h2 class="font-[family-name:var(--font-heading)] text-[clamp(28px,4vw,48px)] text-white tracking-[-0.02em] mb-6">{t(lang, 'chopper.protocol.heading')}</h2>
        </div>
        <div class="reveal reveal-delay-2">
          <p class="font-[family-name:var(--font-heading-jp)] text-[15px] font-medium text-white/50 leading-[1.8] tracking-[0.03em]">{t(lang, 'chopper.protocol.body1')}</p>
          <p class="font-[family-name:var(--font-heading-jp)] text-[15px] font-medium text-white/50 leading-[1.8] tracking-[0.03em] mt-4">{t(lang, 'chopper.protocol.body2')}</p>
          <p class="font-[family-name:var(--font-accent)] text-[clamp(32px,6vw,56px)] font-bold text-brand leading-[1.3] tracking-[0.02em] mt-10 drop-shadow-[0_0_40px_rgba(195,13,35,0.3)]">{t(lang, 'chopper.protocol.cta')}</p>
        </div>
      </div>
      <!-- Accordion -->
      <div class="flex flex-col reveal reveal-delay-3">
        {protocolItems.map((item, i) => (
          <div class:list={['border-b border-white/10 overflow-hidden', i === 0 && 'border-t border-white/10']} data-accordion-item>
            <button class="w-full py-5 max-md:py-[18px] flex items-center justify-between gap-4 bg-transparent border-none cursor-pointer text-left font-[family-name:var(--font-heading-jp)] text-[15px] max-md:text-sm font-bold text-white tracking-[0.02em] transition-colors duration-300 hover:text-brand" data-accordion-trigger>
              <span>{item.title}</span>
              <div class="shrink-0 w-6 h-6 flex items-center justify-center transition-transform duration-300" data-accordion-icon>
                <svg class="w-4 h-4 text-white/40 transition-colors duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </div>
            </button>
            <div class="max-h-0 overflow-hidden transition-[max-height] duration-400 ease-[cubic-bezier(0.25,0.46,0.45,0.94)]" data-accordion-body>
              <div class="pb-5 max-md:pb-[18px] font-[family-name:var(--font-heading-jp)] text-sm text-white/45 leading-[1.9] tracking-[0.02em]" set:html={item.content}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Floating CTA -->
  <button class="fixed bottom-8 right-8 max-md:bottom-5 max-md:right-5 z-[90] inline-flex items-center gap-2.5 px-7 py-3.5 max-md:px-[22px] max-md:py-3 rounded-full bg-brand text-white text-xs max-md:text-[11px] font-bold tracking-[0.15em] uppercase shadow-[0_4px_16px_rgba(195,13,35,0.35),0_2px_8px_rgba(0,0,0,0.2)] cursor-pointer border-none transition-all duration-400 hover:bg-[#a80b1e] hover:-translate-y-0.5 hover:shadow-[0_6px_24px_rgba(195,13,35,0.45),0_4px_12px_rgba(0,0,0,0.25)]" id="floatingCta">
    <svg class="w-3.5 h-3.5 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
    <span>{t(lang, 'common.bookExperience')}</span>
  </button>

  <!-- ============================
       Page-Scoped Styles (SVG map)
       ============================ -->
  <style>
    /* Hero Animations */
    @keyframes heroFadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes scrollBounce {
      0%, 100% { transform: translateY(0); opacity: 0.3; }
      50% { transform: translateY(6px); opacity: 0.8; }
    }

    /* Route 134 SVG Map */
    .route-map__road {
      fill: none;
      stroke: var(--color-brand);
      stroke-width: 4;
      stroke-linecap: round;
      stroke-dasharray: 2000;
      stroke-dashoffset: 2000;
      transition: stroke-dashoffset 2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .visible .route-map__road {
      stroke-dashoffset: 0;
    }

    .route-map__branch {
      fill: none;
      stroke: var(--color-brand);
      stroke-width: 3;
      stroke-linecap: round;
      stroke-dasharray: 8 6;
      opacity: 0;
      transition: opacity 1.5s ease 1s;
    }
    .visible .route-map__branch {
      opacity: 0.6;
    }

    .route-map__dot {
      fill: rgba(255, 255, 255, 0.7);
      transition: fill 0.3s;
    }
    .route-map__dot:hover {
      fill: white;
    }
    .route-map__dot--shop {
      fill: var(--color-brand);
    }
    .route-map__star {
      fill: var(--color-brand);
      filter: drop-shadow(0 0 6px rgba(195, 13, 35, 0.6));
    }
    .route-map__label {
      font-family: var(--font-body);
      font-size: 12px;
      fill: rgba(255, 255, 255, 0.8);
      text-anchor: middle;
    }
    .route-map__label--shop {
      fill: white;
      font-weight: 700;
      font-size: 13px;
    }

    /* Destination Card Expand — handled by JS inline styles */
    .dest-card:hover > div:first-child {
      transform: scale(1.08);
    }

    /* Accordion Active State */
    [data-accordion-item].active [data-accordion-icon] {
      transform: rotate(45deg);
    }
    [data-accordion-item].active [data-accordion-icon] svg {
      color: var(--color-brand);
    }
    [data-accordion-item].active [data-accordion-body] {
      max-height: 500px;
    }
  </style>

  <!-- ============================
       Scripts
       ============================ -->
  <script>
    /* Gallery: Horizontal Scroll with Drag */
    (function() {
      const track = document.getElementById('galleryTrack');
      const prevBtn = document.getElementById('galleryPrev');
      const nextBtn = document.getElementById('galleryNext');
      const dots = document.querySelectorAll('#galleryProgress button');
      const cards = track?.querySelectorAll(':scope > a, :scope > div') ?? [];

      if (!track) return;

      function getCardWidth(): number {
        if (!cards[0]) return 400;
        return (cards[0] as HTMLElement).offsetWidth + 24;
      }

      function getCurrentIndex(): number {
        return Math.round(track.scrollLeft / getCardWidth());
      }

      function updateDots(): void {
        const idx = getCurrentIndex();
        dots.forEach((dot, i) => {
          if (i === idx) {
            dot.classList.add('bg-brand', 'w-6');
            dot.classList.remove('bg-white/15', 'w-2');
          } else {
            dot.classList.remove('bg-brand', 'w-6');
            dot.classList.add('bg-white/15', 'w-2');
          }
        });
      }

      prevBtn?.addEventListener('click', () => {
        track.scrollBy({ left: -getCardWidth(), behavior: 'smooth' });
      });
      nextBtn?.addEventListener('click', () => {
        track.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.getAttribute('data-index') || '0');
          track.scrollTo({ left: idx * getCardWidth(), behavior: 'smooth' });
        });
      });

      track.addEventListener('scroll', updateDots);

      // Drag to scroll (desktop)
      let isDown = false;
      let startX: number;
      let scrollLeft: number;

      track.addEventListener('mousedown', (e: MouseEvent) => {
        isDown = true;
        track.style.cursor = 'grabbing';
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
        e.preventDefault();
      });
      track.addEventListener('mouseleave', () => { isDown = false; track.style.cursor = 'grab'; });
      track.addEventListener('mouseup', () => { isDown = false; track.style.cursor = 'grab'; });
      track.addEventListener('mousemove', (e: MouseEvent) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 1.5;
        track.scrollLeft = scrollLeft - walk;
      });
    })();

    /* Accordion */
    document.querySelectorAll('[data-accordion-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('[data-accordion-item]');
        if (!item) return;
        const wasActive = item.classList.contains('active');
        document.querySelectorAll('[data-accordion-item]').forEach((el) => el.classList.remove('active'));
        if (!wasActive) item.classList.add('active');
      });
    });

    /* Destination Card Toggle */
    document.querySelectorAll('[data-dest-card]').forEach((card) => {
      card.addEventListener('click', () => {
        const wasExpanded = card.classList.contains('dest-card--expanded');

        // Close all
        document.querySelectorAll('[data-dest-card]').forEach((el) => {
          el.classList.remove('dest-card--expanded');
          const detail = el.querySelector('.dest-card__detail') as HTMLElement;
          if (detail) {
            detail.style.transform = 'translateY(100%)';
            detail.style.opacity = '0';
            detail.style.pointerEvents = 'none';
          }
          const hint = el.querySelector('.dest-card__tap-hint') as HTMLElement;
          if (hint) hint.style.opacity = '1';
        });

        // Toggle clicked
        if (!wasExpanded) {
          card.classList.add('dest-card--expanded');
          const detail = card.querySelector('.dest-card__detail') as HTMLElement;
          if (detail) {
            detail.style.transform = 'translateY(0)';
            detail.style.opacity = '1';
            detail.style.pointerEvents = 'all';
          }
          const hint = card.querySelector('.dest-card__tap-hint') as HTMLElement;
          if (hint) hint.style.opacity = '0';
        }
      });
    });

    /* Floating CTA */
    document.getElementById('floatingCta')?.addEventListener('click', () => {
      const el = document.getElementById('galleryTrack');
      if (el) {
        const top = el.getBoundingClientRect().top + window.scrollY - 100;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    });

    /* Video autoplay fallback */
    document.querySelectorAll('video[autoplay]').forEach((v) => {
      (v as HTMLVideoElement).play().catch(() => {});
    });
  </script>

</BaseLayout>
