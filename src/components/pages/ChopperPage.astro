---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CmsImage from '../../components/CmsImage.astro';
import TrustBar from '../../components/TrustBar.astro';
import Reviews from '../../components/Reviews.astro';
import IdpChecker from '../../components/IdpChecker.astro';
import { getVehicles } from '../../lib/microcms';
import { getLangFromUrl, localePath } from '../../i18n/config';
import { t } from '../../i18n/index';

const lang = getLangFromUrl(Astro.url);

const { contents: vehiclesRaw } = await getVehicles();
// Exclude 公開終了 items (closedAt present = ended publication, even if API key returns them)
const published = vehiclesRaw.filter(v => !(v as any).closedAt);
// Display logic: active → normal, maintenance → viewable/no booking, hidden → COMING SOON
const vehicles = published.map((v, i) => ({
  slug: v.slug,
  name: v.name,
  specs: `${v.base} — Hard Tail ${v.style || 'Chopper'}`,
  num: String(i + 1).padStart(2, '0'),
  img: v.thumbnail.url + '?w=800&q=80',
  imgW: v.thumbnail.width,
  imgH: v.thumbnail.height,
  price: v.dayRidePrice,
  status: v.status?.[0] || 'active',
}));

const faqKeys = ['license', 'alcohol', 'weather', 'checkin', 'equipment', 'clothing', 'fuel', 'toll', 'insurance', 'tandem', 'luggage', 'extension', 'cancel'] as const;
const protocolItems = faqKeys.map(key => ({
  title: t(lang, `chopper.faq.${key}.title` as any) as string,
  content: t(lang, `chopper.faq.${key}.content` as any) as string,
}));

// SEO structured data (Service + FAQPage)
const chopperPageUrl = `https://beetlerider.com${Astro.url.pathname}`;
const chopperSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Motorcycle Rental',
    name: lang === 'en' ? 'Kamakura Chopper Rental' : '鎌倉 チョッパー・ハーレーレンタル',
    description: lang === 'en'
      ? 'Vintage chopper (Harley-based) motorcycle rental in Kamakura, Japan. License + IDP required.'
      : '鎌倉でのヴィンテージ・チョッパー（ハーレー）レンタル。要二輪免許。',
    provider: { '@id': 'https://beetlerider.com/#localbusiness' },
    areaServed: { '@type': 'City', name: 'Kamakura' },
    url: chopperPageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: protocolItems.map(f => ({
      '@type': 'Question',
      name: f.title,
      acceptedAnswer: { '@type': 'Answer', text: f.content.replace(/<[^>]+>/g, '') },
    })),
  },
];
---

<BaseLayout title={t(lang, 'meta.chopper.title') as string} description={t(lang, 'meta.chopper.desc') as string} activePage="chopper" headerLogo="chopper" schema={chopperSchema}>

  <!-- ============================
       Section 1: Hero — Cinematic
       ============================ -->
  <section class="relative h-screen max-lg:h-[100svh] min-h-[600px] max-md:min-h-0 flex items-center justify-center overflow-hidden" id="hero">
    <!-- Video Background -->
    <div class="absolute inset-0 bg-[#0a0a0a] z-0">
      <video autoplay muted loop playsinline preload="metadata" poster="/assets/chopper/promo/R0006459.webp" class="w-full h-full object-cover" id="heroVideo">
        <source src="/assets/video/CHOPPER.mp4" type="video/quicktime">
        <source src="/assets/video/CHOPPER.mp4" type="video/mp4">
      </video>
    </div>
    <!-- Overlay -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_80%,rgba(195,13,35,0.08)_0%,transparent_60%),linear-gradient(to_bottom,rgba(0,0,0,0.3)_0%,rgba(0,0,0,0.6)_100%)] z-[1]"></div>
    <!-- Film Grain Noise -->
    <div class="absolute inset-0 z-[1] opacity-40" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E&quot;)"></div>
    <!-- Content -->
    <div class="relative z-[2] text-center px-6">
      <p class="text-[11px] font-bold tracking-[0.4em] uppercase text-brand mb-6 opacity-0 animate-[heroFadeUp_1s_ease_forwards_0.6s]">{t(lang, 'chopper.hero.label')}</p>
      <h1 class="font-[family-name:var(--font-heading)] text-[clamp(56px,12vw,140px)] text-white tracking-[-0.03em] leading-[0.9] mb-4 opacity-0 animate-[heroFadeUp_1s_ease_forwards_0.8s]" set:html={(t(lang, 'chopper.hero.heading') as string).replace('\n', '<br>')} />
      <h2 class="font-[family-name:var(--font-heading)] text-[clamp(24px,5vw,56px)] text-white/85 tracking-[-0.01em] leading-[1.1] mb-6 opacity-0 animate-[heroFadeUp_1s_ease_forwards_1s]">{t(lang, 'chopper.hero.sub')}</h2>
      <p class="font-[family-name:var(--font-heading-jp)] text-[clamp(13px,1.5vw,17px)] font-medium text-white/40 tracking-[0.08em] opacity-0 animate-[heroFadeUp_1s_ease_forwards_1.2s]">{t(lang, 'chopper.hero.desc')}</p>
    </div>
    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-[2] flex flex-col items-center gap-2 opacity-0 animate-[heroFadeUp_1s_ease_forwards_1.5s]">
      <span class="text-[9px] font-semibold tracking-[0.3em] uppercase text-white/30">{t(lang, 'common.scroll')}</span>
      <svg class="w-5 h-5 text-white/30 animate-[scrollBounce_2s_ease-in-out_infinite]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  </section>

  <TrustBar lang={lang} variant="chopper" />

  <!-- ============================
       Section 2: Vehicle Gallery
       ============================ -->
  <section class="pt-20 pb-24 bg-deep-red relative overflow-hidden" id="gallery">
    <div class="text-center mb-10 px-10">
      <div class="reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">{t(lang, 'chopper.fleet.label')}</p>
      </div>
      <div class="reveal reveal-delay-1">
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(28px,4vw,52px)] text-white tracking-[-0.02em]">{t(lang, 'chopper.fleet.heading')}</h2>
      </div>
    </div>
    <div class="relative px-16 max-md:px-4">
      <!-- Prev Button -->
      <button class="absolute top-1/2 -translate-y-1/2 left-4 z-10 w-12 h-12 rounded-full bg-white/[0.08] border border-white/[0.12] backdrop-blur-[12px] flex items-center justify-center cursor-pointer transition-all duration-300 hover:bg-white/[0.16] hover:border-white/25 hover:-translate-y-1/2 hover:scale-105 max-md:hidden" id="galleryPrev" aria-label="Previous">
        <svg class="w-[18px] h-[18px] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <!-- Track -->
      <div class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth py-4 pb-10 cursor-grab [&:active]:cursor-grabbing [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden max-md:px-4" id="galleryTrack">
        {vehicles.map((v) => (
          v.status === 'hidden' ? (
            <div class="flex-none w-[400px] max-lg:w-[340px] max-md:w-[320px] aspect-[3/4] rounded-2xl overflow-hidden relative snap-center cursor-not-allowed select-none">
              <div class="absolute inset-0 bg-[#111]">
                <CmsImage src={v.img} width={800} naturalWidth={v.imgW} naturalHeight={v.imgH} alt={v.name} loading="lazy" class="w-full h-full object-cover blur-[6px] brightness-50" />
              </div>
              <div class="absolute inset-0 bg-black/40 z-[1]"></div>
              <div class="absolute inset-0 flex flex-col items-center justify-center z-[2]">
                <p class="font-[family-name:var(--font-heading)] text-[clamp(20px,2.5vw,28px)] text-white/80 tracking-[0.15em] uppercase">COMING SOON</p>
                <p class="font-[family-name:var(--font-heading)] text-sm text-white/40 tracking-wide mt-2">{v.name}</p>
              </div>
            </div>
          ) : (
            <a href={localePath('/chopper/' + v.slug, lang)} class="group flex-none w-[400px] max-lg:w-[340px] max-md:w-[320px] aspect-[3/4] rounded-2xl overflow-hidden relative snap-center transition-transform duration-500 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] hover:-translate-y-2 cursor-pointer">
              <div class="absolute inset-0 bg-[#111] transition-transform duration-600 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-hover:scale-[1.06]">
                <CmsImage src={v.img} width={800} naturalWidth={v.imgW} naturalHeight={v.imgH} alt={v.name} loading="lazy" class={`w-full h-full object-cover${v.status === 'maintenance' ? ' brightness-75 saturate-50' : ''}`} />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-black/20 z-[1]"></div>
              {v.status === 'maintenance' && (
                <div class="absolute top-4 left-4 z-[3] px-3 py-1.5 rounded-full bg-amber-500/90 backdrop-blur-[8px] text-[10px] font-bold tracking-[0.12em] uppercase text-white">
                  MAINTENANCE
                </div>
              )}
              <div class="absolute bottom-0 left-0 right-0 p-8 z-[2]">
                <p class="font-[family-name:var(--font-heading)] text-xs text-brand tracking-[0.15em] mb-3 opacity-70">{v.num}</p>
                <h3 class="font-[family-name:var(--font-heading)] text-[clamp(24px,3vw,32px)] text-white tracking-[-0.01em] leading-none mb-2">{v.name}</h3>
                <p class="text-xs font-medium text-white/45 tracking-[0.03em] leading-relaxed">{v.specs}</p>
                {v.price && (
                  <p class="mt-3 font-[family-name:var(--font-heading)] text-[15px] text-white/90 tracking-wide">
                    ¥{v.price.toLocaleString()}<span class="font-[family-name:var(--font-body)] text-[10px] font-bold tracking-[0.15em] uppercase text-white/40"> / DAY</span>
                  </p>
                )}
                <div class="flex items-center gap-2 mt-5 text-[11px] font-bold tracking-[0.2em] uppercase text-white opacity-0 translate-y-2 transition-all duration-400 group-hover:opacity-100 group-hover:translate-y-0">
                  <span>{t(lang, 'chopper.fleet.viewDetails')}</span>
                  <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </div>
              </div>
            </a>
          )
        ))}
      </div>
      <!-- Next Button -->
      <button class="absolute top-1/2 -translate-y-1/2 right-4 z-10 w-12 h-12 rounded-full bg-white/[0.08] border border-white/[0.12] backdrop-blur-[12px] flex items-center justify-center cursor-pointer transition-all duration-300 hover:bg-white/[0.16] hover:border-white/25 hover:-translate-y-1/2 hover:scale-105 max-md:hidden" id="galleryNext" aria-label="Next">
        <svg class="w-[18px] h-[18px] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
    <!-- Dots -->
    <div class="flex justify-center gap-2 mt-6" id="galleryProgress">
      {vehicles.map((_, i) => (
        <button class:list={['h-2 rounded-full border-none cursor-pointer transition-all duration-300 p-0', i === 0 ? 'bg-brand w-6' : 'bg-white/15 w-2']} data-index={i} aria-label={`Slide ${i + 1}`}></button>
      ))}
    </div>
  </section>



  <!-- ============================
       Section 3: Route 134 Map
       ============================ -->
  <!-- 3a: 「134号線という聖域」バナー（走行写真背景・横長低め） -->
  <section class="pt-24 pb-8 px-10 max-md:pt-16 max-md:px-4 bg-deep-red overflow-hidden reveal" id="routeMap">
    <div class="max-w-[1200px] mx-auto text-left">
      <div class="relative rounded-[24px] overflow-hidden h-[250px] max-md:h-[200px] flex items-end">
        <img src="/assets/chopper/promo/674A3883.webp" alt="Riding Route 134 along the Shonan coast" class="absolute inset-0 w-full h-full object-cover object-[center_62%]" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/35 to-black/5"></div>
        <span class="absolute top-4 right-7 font-[family-name:var(--font-heading)] text-[clamp(64px,8vw,104px)] text-white/[0.15] leading-none select-none pointer-events-none">134</span>
        <div class="relative z-[2] p-8 max-md:p-6">
          <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/45 mb-2">{t(lang, 'chopper.route.label')}</p>
          <h2 class="font-[family-name:var(--font-heading)] text-[clamp(24px,3.5vw,40px)] text-white tracking-[-0.02em] mb-2">{t(lang, 'chopper.route.heading')}</h2>
          <p class="text-[12.5px] text-white/65 font-medium">{lang === 'en' ? 'Sagami Bay on your left. Enoshima ahead. Fuji on the horizon.' : '左手に相模湾、正面に江ノ島、水平線に富士。信号の少ない海沿いの7km。'}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3b: 行き先マップ（全幅・横長v7） -->
  <section class="pb-16 px-10 max-md:px-3 bg-deep-red overflow-hidden reveal" id="destMap">
    <div class="max-w-[1200px] mx-auto text-left">
      <div class="max-md:overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        <svg viewBox="0 0 1000 430" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto max-md:min-w-[760px]" aria-label="Destinations from Kamakura: Route 134, Atami-Izu, Hakone, Mt. Fuji, Yokohama, Daikoku PA, Shuto C1, Yokosuka">
          <!-- 海岸線 -->
          <path d="M -20,352 C 80,349 160,346 250,343 C 330,340.5 400,339 470,338 C 520,337.5 560,338.5 600,342 C 640,346 670,352 700,360 C 740,371 775,383 800,394" fill="none" stroke="#fff" stroke-opacity="0.16" stroke-width="1.5"/>
          <g stroke="#fff" stroke-opacity="0.05" stroke-width="1">
            <path d="M 210,392 h 44 M 222,401 h 36"/>
            <path d="M 420,398 h 40 M 432,407 h 30"/>
            <path d="M 620,398 h 32"/>
          </g>
          <!-- ROUTE 134 -->
          <path d="M 60,346 C 140,343 220,340 300,337.5 C 370,335.5 420,334.5 470,334 C 515,333.5 555,335 590,338" fill="none" stroke="var(--color-brand)" stroke-width="2.5" stroke-linecap="round" stroke-opacity="0.85"/>
          <text x="262" y="325" text-anchor="middle" fill="var(--color-brand)" fill-opacity="0.6" font-size="9.5" font-weight="800" letter-spacing="0.18em" style="font-family: var(--font-body)">ROUTE 134</text>
          <!-- 熱海・伊豆（134/135の先・左下へ） -->
          <path d="M 55,347 C 38,353 24,361 12,371" fill="none" stroke="var(--color-brand)" stroke-opacity="0.4" stroke-width="1.5" stroke-dasharray="4 5"/>
          <text x="12" y="392" fill="#fff" fill-opacity="0.5" font-size="9.5" font-weight="700" letter-spacing="0.08em" style="font-family: var(--font-body)">← ATAMI · IZU</text>
          <!-- 富士山（一番左） -->
          <path d="M 60,196 Q 112,124 118,124 Q 124,124 176,196" fill="none" stroke="#fff" stroke-opacity="0.3" stroke-width="1.8"/>
          <path d="M 103,148 l 5,-6 5,6 5,-6 5,6" fill="none" stroke="#fff" stroke-opacity="0.35" stroke-width="1.2"/>
          <text x="118" y="216" text-anchor="middle" fill="#fff" fill-opacity="0.55" font-size="10.5" font-weight="700" letter-spacing="0.1em" style="font-family: var(--font-body)">MT. FUJI</text>
          <text x="118" y="230" text-anchor="middle" fill="#fff" fill-opacity="0.35" font-size="8.5" font-weight="600" letter-spacing="0.1em" style="font-family: var(--font-body)">2 HRS</text>
          <!-- 箱根（左下） -->
          <path d="M 88,296 L 104,274 L 116,288 L 126,278 L 140,296" fill="none" stroke="#fff" stroke-opacity="0.3" stroke-width="1.5"/>
          <text x="114" y="316" text-anchor="middle" fill="#fff" fill-opacity="0.55" font-size="10.5" font-weight="700" letter-spacing="0.1em" style="font-family: var(--font-body)">HAKONE</text>
          <text x="114" y="330" text-anchor="middle" fill="#fff" fill-opacity="0.35" font-size="8.5" font-weight="600" letter-spacing="0.1em" style="font-family: var(--font-body)">90 MIN · ONSEN</text>
          <path d="M 143,338 C 132,328 124,318 118,306" fill="none" stroke="#fff" stroke-opacity="0.25" stroke-width="1.2" stroke-dasharray="4 4"/>
          <!-- 首都高C1（大きく・鎌倉の真上） -->
          <text x="470" y="76" text-anchor="middle" fill="#fff" fill-opacity="0.9" font-size="14" letter-spacing="0.1em" style="font-family: var(--font-heading)">TOKYO</text>
          <circle cx="470" cy="150" r="56" fill="none" stroke="var(--color-brand)" stroke-opacity="0.75" stroke-width="2.2"/>
          <text x="470" y="147" text-anchor="middle" fill="var(--color-brand)" fill-opacity="0.95" font-size="15" letter-spacing="0.08em" style="font-family: var(--font-heading)">C1</text>
          <text x="470" y="168" text-anchor="middle" fill="#fff" fill-opacity="0.45" font-size="8.5" font-weight="700" letter-spacing="0.12em" style="font-family: var(--font-body)">SHUTO · 70 MIN</text>
          <circle cx="425" cy="110" r="3" fill="#fff" fill-opacity="0.5"/>
          <text x="413" y="106" text-anchor="end" fill="#fff" fill-opacity="0.6" font-size="10" font-weight="700" letter-spacing="0.08em" style="font-family: var(--font-body)">SHIBUYA</text>
          <circle cx="523" cy="132" r="2.5" fill="#fff" fill-opacity="0.85"/>
          <text x="532" y="136" fill="#fff" fill-opacity="0.6" font-size="9.5" font-weight="700" letter-spacing="0.1em" style="font-family: var(--font-body)">GINZA</text>
          <!-- 湾岸線（C1右下→大黒PA→右へ） -->
          <path d="M 508,186 C 560,208 610,213 655,210 C 730,206 800,196 865,180" fill="none" stroke="var(--color-brand)" stroke-opacity="0.45" stroke-width="2" stroke-dasharray="6 5"/>
          <text x="790" y="166" fill="#fff" fill-opacity="0.4" font-size="8.5" font-weight="600" letter-spacing="0.12em" style="font-family: var(--font-body)">BAYSHORE · 湾岸線</text>
          <circle cx="655" cy="210" r="2.5" fill="#fff" fill-opacity="0.8"/>
          <text x="668" y="207" fill="#fff" fill-opacity="0.55" font-size="9.5" font-weight="700" letter-spacing="0.1em" style="font-family: var(--font-body)">DAIKOKU PA</text>
          <!-- 横浜（鎌倉→横浜→湾岸へ） -->
          <path d="M 470,334 C 495,300 530,268 570,246" fill="none" stroke="#fff" stroke-opacity="0.22" stroke-width="1.5" stroke-dasharray="4 5"/>
          <circle cx="585" cy="240" r="4" fill="none" stroke="#fff" stroke-opacity="0.6" stroke-width="1.5"/>
          <text x="599" y="236" fill="#fff" fill-opacity="0.6" font-size="10.5" font-weight="700" letter-spacing="0.08em" style="font-family: var(--font-body)">YOKOHAMA</text>
          <text x="599" y="250" fill="#fff" fill-opacity="0.35" font-size="8.5" font-weight="600" letter-spacing="0.1em" style="font-family: var(--font-body)">45 MIN</text>
          <!-- 横須賀（右端・横横道路） -->
          <path d="M 594,336 C 700,320 830,330 920,348" fill="none" stroke="#fff" stroke-opacity="0.22" stroke-width="1.5" stroke-dasharray="4 5"/>
          <circle cx="925" cy="350" r="3.5" fill="#fff" fill-opacity="0.55"/>
          <text x="925" y="373" text-anchor="middle" fill="#fff" fill-opacity="0.6" font-size="10.5" font-weight="700" letter-spacing="0.08em" style="font-family: var(--font-body)">YOKOSUKA</text>
          <text x="925" y="387" text-anchor="middle" fill="#fff" fill-opacity="0.35" font-size="8.5" font-weight="600" letter-spacing="0.1em" style="font-family: var(--font-body)">40 MIN</text>
          <!-- 海沿いノード -->
          <circle cx="150" cy="341" r="3.5" fill="#fff" fill-opacity="0.55"/>
          <text x="150" y="364" text-anchor="middle" fill="#fff" fill-opacity="0.6" font-size="10.5" font-weight="700" letter-spacing="0.08em" style="font-family: var(--font-body)">ODAWARA</text>
          <text x="150" y="378" text-anchor="middle" fill="#fff" fill-opacity="0.35" font-size="8.5" font-weight="600" letter-spacing="0.1em" style="font-family: var(--font-body)">60 MIN</text>
          <circle cx="300" cy="338" r="3.5" fill="#fff" fill-opacity="0.55"/>
          <text x="300" y="362" text-anchor="middle" fill="#fff" fill-opacity="0.6" font-size="10.5" font-weight="700" letter-spacing="0.08em" style="font-family: var(--font-body)">ENOSHIMA</text>
          <text x="300" y="376" text-anchor="middle" fill="#fff" fill-opacity="0.35" font-size="8.5" font-weight="600" letter-spacing="0.1em" style="font-family: var(--font-body)">15 MIN</text>
          <circle cx="590" cy="338" r="3.5" fill="#fff" fill-opacity="0.55"/>
          <text x="596" y="362" text-anchor="middle" fill="#fff" fill-opacity="0.6" font-size="10.5" font-weight="700" letter-spacing="0.08em" style="font-family: var(--font-body)">ZUSHI · HAYAMA</text>
          <text x="596" y="376" text-anchor="middle" fill="#fff" fill-opacity="0.35" font-size="8.5" font-weight="600" letter-spacing="0.1em" style="font-family: var(--font-body)">15–20 MIN</text>
          <!-- KAMAKURA -->
          <circle cx="470" cy="334" r="5.5" fill="var(--color-brand)" filter="drop-shadow(0 0 8px rgba(195,13,35,0.7))"/>
          <circle cx="470" cy="334" r="11" fill="none" stroke="var(--color-brand)" stroke-opacity="0.5" stroke-width="1.4"/>
          <circle cx="470" cy="334" r="17" fill="none" stroke="var(--color-brand)" stroke-width="1.1" opacity="0.3">
            <animate attributeName="r" from="13" to="30" dur="2.6s" repeatCount="indefinite"/>
