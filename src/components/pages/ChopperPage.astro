            <div class="absolute bottom-0 left-0 right-0 p-7 z-[2]">
              <h3 class="font-[family-name:var(--font-heading)] text-[clamp(22px,3.5vw,28px)] text-white tracking-[-0.01em]">{d.name}</h3>
              <p class="font-[family-name:var(--font-heading-jp)] text-[13px] text-white/60 mt-1 tracking-[0.02em] line-clamp-1">{d.desc}</p>
            </div>
            <!-- Expand Detail Panel -->
