  <!-- ============================
       Section 4: Destinations
       ============================ -->
  <section class="py-32 px-10 max-md:py-24 max-md:px-6 bg-deep-red" id="destinations">
    <div class="max-w-[1200px] mx-auto">
      <div class="text-center mb-16 reveal">
