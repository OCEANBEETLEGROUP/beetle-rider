---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CmsImage from '../../components/CmsImage.astro';
import TrustBar from '../../components/TrustBar.astro';
import Reviews from '../../components/Reviews.astro';
import IdpChecker from '../../components/IdpChecker.astro';
import { getVehicles } from '../../lib/microcms';
import { getLangFromUrl, localePath } from '../../i18n/config';
import { t } from '../../i18n/index';

const lang = getLangFromUrl(Astro.url);

const { contents: vehiclesRaw } = await getVehicles();
// Exclude 公開終了 items (closedAt present = ended publication, even if API key returns them)
const published = vehiclesRaw.filter(v => !(v as any).closedAt);
// Display logic: active → normal, maintenance → viewable/no booking, hidden → COMING SOON
const vehicles = published.map((v, i) => ({
  slug: v.slug,
  name: v.name,
  specs: `${v.base} — Hard Tail ${v.style || 'Chopper'}`,
  num: String(i + 1).padStart(2, '0'),
  img: v.thumbnail.url + '?w=800&q=80',
  imgW: v.thumbnail.width,
  imgH: v.thumbnail.height,
  price: v.dayRidePrice,
  status: v.status?.[0] || 'active',
}));

const faqKeys = ['license', 'alcohol', 'weather', 'checkin', 'equipment', 'clothing', 'fuel', 'toll', 'insurance', 'tandem', 'luggage', 'extension', 'cancel'] as const;
const protocolItems = faqKeys.map(key => ({
  title: t(lang, `chopper.faq.${key}.title` as any) as string,
  content: t(lang, `chopper.faq.${key}.content` as any) as string,
}));

// SEO structured data (Service + FAQPage)
const chopperPageUrl = `https://beetlerider.com${Astro.url.pathname}`;
const chopperSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Motorcycle Rental',
    name: lang === 'en' ? 'Kamakura Chopper Rental' : '鎌倉 チョッパー・ハーレーレンタル',
    description: lang === 'en'
      ? 'Vintage chopper (Harley-based) motorcycle rental in Kamakura, Japan. License + IDP required.'
      : '鎌倉でのヴィンテージ・チョッパー（ハーレー）レンタル。要二輪免許。',
    provider: { '@id': 'https://beetlerider.com/#localbusiness' },
    areaServed: { '@type': 'City', name: 'Kamakura' },
    url: chopperPageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: protocolItems.map(f => ({
      '@type': 'Question',
      name: f.title,
      acceptedAnswer: { '@type': 'Answer', text: f.content.replace(/<[^>]+>/g, '') },
    })),
  },
];
---

<BaseLayout title={t(lang, 'meta.chopper.title') as string} description={t(lang, 'meta.chopper.desc') as string} activePage="chopper" headerLogo="chopper" schema={chopperSchema}>

  <!-- ============================
       Section 1: Hero — Cinematic
       ============================ -->
  <section class="relative h-screen max-lg:h-[100svh] min-h-[600px] max-md:min-h-0 flex items-center justify-center overflow-hidden" id="hero">
    <!-- Video Background -->
    <div class="absolute inset-0 bg-[#0a0a0a] z-0">
      <video autoplay muted loop playsinline preload="metadata" poster="/assets/chopper/promo/R0006459.webp" class="w-full h-full object-cover" id="heroVideo">
        <source src="/assets/video/CHOPPER.mp4" type="video/quicktime">
        <source src="/assets/video/CHOPPER.mp4" type="video/mp4">
      </video>
    </div>
    <!-- Overlay -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_80%,rgba(195,13,35,0.08)_0%,transparent_60%),linear-gradient(to_bottom,rgba(0,0,0,0.3)_0%,rgba(0,0,0,0.6)_100%)] z-[1]"></div>
    <!-- Film Grain Noise -->
    <div class="absolute inset-0 z-[1] opacity-40" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E&quot;)"></div>
    <!-- Content -->
    <div class="relative z-[2] text-center px-6">
      <p class="text-[11px] font-bold tracking-[0.4em] uppercase text-brand mb-6 opacity-0 animate-[heroFadeUp_1s_ease_forwards_0.6s]">{t(lang, 'chopper.hero.label')}</p>
      <h1 class="font-[family-name:var(--font-heading)] text-[clamp(56px,12vw,140px)] text-white tracking-[-0.03em] leading-[0.9] mb-4 opacity-0 animate-[heroFadeUp_1s_ease_forwards_0.8s]" set:html={(t(lang, 'chopper.hero.heading') as string).replace('\n', '<br>')} />
      <h2 class="font-[family-name:var(--font-heading)] text-[clamp(24px,5vw,56px)] text-white/85 tracking-[-0.01em] leading-[1.1] mb-6 opacity-0 animate-[heroFadeUp_1s_ease_forwards_1s]">{t(lang, 'chopper.hero.sub')}</h2>
      <p class="font-[family-name:var(--font-heading-jp)] text-[clamp(13px,1.5vw,17px)] font-medium text-white/40 tracking-[0.08em] opacity-0 animate-[heroFadeUp_1s_ease_forwards_1.2s]">{t(lang, 'chopper.hero.desc')}</p>
    </div>
    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-[2] flex flex-col items-center gap-2 opacity-0 animate-[heroFadeUp_1s_ease_forwards_1.5s]">
      <span class="text-[9px] font-semibold tracking-[0.3em] uppercase text-white/30">{t(lang, 'common.scroll')}</span>
      <svg class="w-5 h-5 text-white/30 animate-[scrollBounce_2s_ease-in-out_infinite]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  </section>

  <TrustBar lang={lang} variant="chopper" />

  <!-- ============================
       Section 2: Vehicle Gallery
       ============================ -->
  <section class="pt-20 pb-24 bg-deep-red relative overflow-hidden" id="gallery">
    <div class="text-center mb-10 px-10">
      <div class="reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">{t(lang, 'chopper.fleet.label')}</p>
      </div>
      <div class="reveal reveal-delay-1">
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(28px,4vw,52px)] text-white tracking-[-0.02em]">{t(lang, 'chopper.fleet.heading')}</h2>
      </div>
    </div>
    <div class="relative px-16 max-md:px-4">
      <!-- Prev Button -->
      <button class="absolute top-1/2 -translate-y-1/2 left-4 z-10 w-12 h-12 rounded-full bg-white/[0.08] border border-white/[0.12] backdrop-blur-[12px] flex items-center justify-center cursor-pointer transition-all duration-300 hover:bg-white/[0.16] hover:border-white/25 hover:-translate-y-1/2 hover:scale-105 max-md:hidden" id="galleryPrev" aria-label="Previous">
        <svg class="w-[18px] h-[18px] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <!-- Track -->
      <div class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth py-4 pb-10 cursor-grab [&:active]:cursor-grabbing [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden max-md:px-4" id="galleryTrack">
        {vehicles.map((v) => (
          v.status === 'hidden' ? (
            <div class="flex-none w-[400px] max-lg:w-[340px] max-md:w-[320px] aspect-[3/4] rounded-2xl overflow-hidden relative snap-center cursor-not-allowed select-none">
              <div class="absolute inset-0 bg-[#111]">
                <CmsImage src={v.img} width={800} naturalWidth={v.imgW} naturalHeight={v.imgH} alt={v.name} loading="lazy" class="w-full h-full object-cover blur-[6px] brightness-50" />
              </div>
              <div class="absolute inset-0 bg-black/40 z-[1]"></div>
              <div class="absolute inset-0 flex flex-col items-center justify-center z-[2]">
                <p class="font-[family-name:var(--font-heading)] text-[clamp(20px,2.5vw,28px)] text-white/80 tracking-[0.15em] uppercase">COMING SOON</p>
                <p class="font-[family-name:var(--font-heading)] text-sm text-white/40 tracking-wide mt-2">{v.name}</p>
              </div>
            </div>
          ) : (
            <a href={localePath('/chopper/' + v.slug, lang)} class="group flex-none w-[400px] max-lg:w-[340px] max-md:w-[320px] aspect-[3/4] rounded-2xl overflow-hidden relative snap-center transition-transform duration-500 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] hover:-translate-y-2 cursor-pointer">
              <div class="absolute inset-0 bg-[#111] transition-transform duration-600 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-hover:scale-[1.06]">
                <CmsImage src={v.img} width={800} naturalWidth={v.imgW} naturalHeight={v.imgH} alt={v.name} loading="lazy" class={`w-full h-full object-cover${v.status === 'maintenance' ? ' brightness-75 saturate-50' : ''}`} />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-black/20 z-[1]"></div>
              {v.status === 'maintenance' && (
                <div class="absolute top-4 left-4 z-[3] px-3 py-1.5 rounded-full bg-amber-500/90 backdrop-blur-[8px] text-[10px] font-bold tracking-[0.12em] uppercase text-white">
                  MAINTENANCE
                </div>
              )}
              <div class="absolute bottom-0 left-0 right-0 p-8 z-[2]">
                <p class="font-[family-name:var(--font-heading)] text-xs text-brand tracking-[0.15em] mb-3 opacity-70">{v.num}</p>
                <h3 class="font-[family-name:var(--font-heading)] text-[clamp(24px,3vw,32px)] text-white tracking-[-0.01em] leading-none mb-2">{v.name}</h3>
                <p class="text-xs font-medium text-white/45 tracking-[0.03em] leading-relaxed">{v.specs}</p>
                {v.price && (
                  <p class="mt-3 font-[family-name:var(--font-heading)] text-[15px] text-white/90 tracking-wide">
                    ¥{v.price.toLocaleString()}<span class="font-[family-name:var(--font-body)] text-[10px] font-bold tracking-[0.15em] uppercase text-white/40"> / DAY</span>
                  </p>
                )}
                <div class="flex items-center gap-2 mt-5 text-[11px] font-bold tracking-[0.2em] uppercase text-white opacity-0 translate-y-2 transition-all duration-400 group-hover:opacity-100 group-hover:translate-y-0">
                  <span>{t(lang, 'chopper.fleet.viewDetails')}</span>
                  <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </div>
              </div>
            </a>
          )
        ))}
      </div>
      <!-- Next Button -->
      <button class="absolute top-1/2 -translate-y-1/2 right-4 z-10 w-12 h-12 rounded-full bg-white/[0.08] border border-white/[0.12] backdrop-blur-[12px] flex items-center justify-center cursor-pointer transition-all duration-300 hover:bg-white/[0.16] hover:border-white/25 hover:-translate-y-1/2 hover:scale-105 max-md:hidden" id="galleryNext" aria-label="Next">
        <svg class="w-[18px] h-[18px] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
    <!-- Dots -->
    <div class="flex justify-center gap-2 mt-6" id="galleryProgress">
      {vehicles.map((_, i) => (
        <button class:list={['h-2 rounded-full border-none cursor-pointer transition-all duration-300 p-0', i === 0 ? 'bg-brand w-6' : 'bg-white/15 w-2']} data-index={i} aria-label={`Slide ${i + 1}`}></button>
      ))}
    </div>
  </section>



  <!-- ============================
       Section 3: Route 134 Map
       ============================ -->
  <section class="py-24 px-10 max-md:py-16 max-md:px-4 bg-deep-red overflow-hidden reveal" id="routeMap">
    <div class="max-w-[1200px] mx-auto text-center">
      <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">{t(lang, 'chopper.route.label')}</p>
      <h2 class="font-[family-name:var(--font-heading)] text-[clamp(20px,3.5vw,36px)] text-white tracking-[-0.02em] mb-16">{t(lang, 'chopper.route.heading')}</h2>
      <!-- Route 134 v5 — 走行写真 × ミニマル行き先マップ + 連泊誘導 -->
      <div class="mt-2 text-left">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 items-stretch reveal">
          <!-- 左: 134走行写真 -->
          <div class="relative rounded-2xl overflow-hidden min-h-[380px] max-md:min-h-[300px]">
            <img src="/assets/chopper/promo/674A3883.webp" alt="Riding Route 134 along the Shonan coast" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-black/10"></div>
            <span class="absolute top-5 right-6 font-[family-name:var(--font-heading)] text-[clamp(56px,7vw,88px)] text-white/[0.16] leading-none select-none pointer-events-none">134</span>
            <div class="absolute bottom-0 left-0 right-0 p-7">
              <p class="font-[family-name:var(--font-heading)] text-[clamp(16px,2vw,22px)] text-white tracking-tight mb-1">{lang === 'en' ? '7km of coastline. Barely a traffic light.' : '信号の少ない、海沿いの7km。'}</p>
              <p class="text-[12px] text-white/60 font-medium">{lang === 'en' ? 'Sagami Bay on your left. Enoshima ahead. Fuji on the horizon.' : '左手に相模湾、正面に江ノ島、水平線に富士。'}</p>
            </div>
          </div>

          <!-- 右: 行き先マップ（鎌倉ハブ・134・首都高C1・湾岸線・富士・横浜） -->
          <div class="rounded-2xl border border-white/[0.08] bg-white/[0.02] p-3 flex items-center">
            <svg viewBox="0 0 460 560" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto max-h-[520px] mx-auto" aria-label="Destinations from Kamakura: Route 134, Yokohama, Shuto Expressway C1, Mt. Fuji, Hakone">
              <!-- 海岸線 -->
              <path d="M -10,470 C 60,468 120,452 175,438 C 200,431 215,428 228,432 C 244,438 256,448 264,462 C 276,484 284,512 288,545" fill="none" stroke="#fff" stroke-opacity="0.18" stroke-width="1.5"/>
              <path d="M 322,545 C 318,500 310,440 300,380 C 293,330 289,272 293,225 C 296,180 304,140 316,105 C 322,88 330,72 338,60" fill="none" stroke="#fff" stroke-opacity="0.18" stroke-width="1.5"/>
              <!-- ROUTE 134 -->
              <path d="M 40,462 C 95,455 150,442 200,431 C 216,435 228,441 238,450" fill="none" stroke="var(--color-brand)" stroke-width="3" stroke-linecap="round" stroke-opacity="0.85"/>
              <text x="86" y="480" fill="var(--color-brand)" fill-opacity="0.7" font-size="9" font-weight="800" letter-spacing="0.18em" transform="rotate(-6 86 480)" style="font-family: var(--font-body)">ROUTE 134</text>
              <!-- 横浜方面（横横道路） -->
              <path d="M 200,428 C 235,370 265,300 291,232" fill="none" stroke="#fff" stroke-opacity="0.22" stroke-width="1.5" stroke-dasharray="4 5"/>
              <!-- 湾岸線: 横浜 → C1 -->
              <path d="M 293,218 C 305,185 315,150 323,118" fill="none" stroke="var(--color-brand)" stroke-opacity="0.5" stroke-width="2" stroke-dasharray="6 5"/>
              <text x="330" y="172" fill="#fff" fill-opacity="0.45" font-size="8.5" font-weight="700" letter-spacing="0.14em" transform="rotate(-72 330 172)" style="font-family: var(--font-body)">湾岸線 BAYSHORE</text>
              <!-- 首都高 C1 ループ -->
              <text x="330" y="42" text-anchor="middle" fill="#fff" fill-opacity="0.9" font-size="13" letter-spacing="0.1em" style="font-family: var(--font-heading)">TOKYO</text>
              <text x="330" y="58" text-anchor="middle" fill="#fff" fill-opacity="0.45" font-size="8.5" font-weight="700" letter-spacing="0.16em" style="font-family: var(--font-body)">SHUTO EXPWY</text>
              <circle cx="330" cy="97" r="20" fill="none" stroke="var(--color-brand)" stroke-opacity="0.75" stroke-width="2"/>
              <text x="330" y="101" text-anchor="middle" fill="var(--color-brand)" fill-opacity="0.9" font-size="11" letter-spacing="0.08em" style="font-family: var(--font-heading)">C1</text>
              <circle cx="348" cy="106" r="2.5" fill="#fff" fill-opacity="0.85"/>
              <text x="356" y="110" fill="#fff" fill-opacity="0.55" font-size="8.5" font-weight="700" letter-spacing="0.1em" style="font-family: var(--font-body)">GINZA</text>
              <!-- YOKOHAMA -->
              <circle cx="293" cy="225" r="4" fill="#fff" fill-opacity="0.75"/>
              <text x="305" y="222" fill="#fff" fill-opacity="0.75" font-size="11" font-weight="700" letter-spacing="0.08em" style="font-family: var(--font-body)">YOKOHAMA</text>
              <text x="305" y="236" fill="#fff" fill-opacity="0.4" font-size="8" font-weight="600" letter-spacing="0.1em" style="font-family: var(--font-body)">MINATO MIRAI · 40 MIN</text>
              <!-- FUJI -->
              <path d="M 28,362 Q 58,318 61,318 Q 64,318 94,362" fill="none" stroke="#fff" stroke-opacity="0.25" stroke-width="1.6"/>
              <path d="M 50,336 l 4,-5 4,5 4,-5 4,5" fill="none" stroke="#fff" stroke-opacity="0.3" stroke-width="1.1"/>
              <text x="61" y="380" text-anchor="middle" fill="#fff" fill-opacity="0.5" font-size="9.5" font-weight="700" letter-spacing="0.1em" style="font-family: var(--font-body)">MT. FUJI</text>
              <text x="61" y="393" text-anchor="middle" fill="#fff" fill-opacity="0.32" font-size="7.5" font-weight="600" letter-spacing="0.08em" style="font-family: var(--font-body)">2 HRS · VIA HAKONE</text>
              <!-- ODAWARA / HAKONE -->
              <circle cx="52" cy="459" r="3" fill="#fff" fill-opacity="0.5"/>
              <text x="52" y="447" text-anchor="middle" fill="#fff" fill-opacity="0.42" font-size="8.5" font-weight="600" letter-spacing="0.08em" style="font-family: var(--font-body)">ODAWARA · 60 MIN</text>
              <path d="M 52,462 C 58,480 65,500 73,514" fill="none" stroke="var(--color-brand)" stroke-opacity="0.5" stroke-width="1.8" stroke-dasharray="4 4"/>
              <path d="M 60,506 l 7,-9 5,6 4,-7 7,10" fill="none" stroke="#fff" stroke-opacity="0.3" stroke-width="1.3"/>
              <circle cx="75" cy="518" r="4.5" fill="var(--color-brand)" filter="drop-shadow(0 0 6px rgba(195,13,35,0.6))"/>
              <text x="92" y="522" fill="var(--color-brand)" fill-opacity="0.9" font-size="10.5" font-weight="800" letter-spacing="0.1em" style="font-family: var(--font-body)">HAKONE</text>
              <text x="92" y="535" fill="#fff" fill-opacity="0.4" font-size="8" font-weight="600" letter-spacing="0.1em" style="font-family: var(--font-body)">90 MIN · ONSEN</text>
              <!-- ZUSHI・HAYAMA -->
              <circle cx="247" cy="452" r="3" fill="#fff" fill-opacity="0.5"/>
              <text x="258" y="456" fill="#fff" fill-opacity="0.45" font-size="8.5" font-weight="600" letter-spacing="0.08em" style="font-family: var(--font-body)">ZUSHI · HAYAMA</text>
              <!-- KAMAKURA hub -->
              <g filter="url(#rmGlow5)">
                <path d="M 200,418.3 L 203.2,426.1 L 211.7,426.1 L 205,431.5 L 207.6,439.8 L 200,435 L 192.4,439.8 L 195,431.5 L 188.3,426.1 L 196.8,426.1 Z" fill="var(--color-brand)"/>
              </g>
              <defs>
                <filter id="rmGlow5" x="-80%" y="-80%" width="260%" height="260%">
                  <feGaussianBlur stdDeviation="3.5" result="b"/>
                  <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
                </filter>
              </defs>
              <circle cx="200" cy="429" r="14" fill="none" stroke="var(--color-brand)" stroke-opacity="0.45" stroke-width="1.4"/>
              <circle cx="200" cy="429" r="20" fill="none" stroke="var(--color-brand)" stroke-width="1.1" opacity="0.25">
                <animate attributeName="r" from="16" to="34" dur="2.6s" repeatCount="indefinite"/>
                <animate attributeName="opacity" from="0.3" to="0" dur="2.6s" repeatCount="indefinite"/>
              </circle>
              <text x="200" y="404" text-anchor="middle" fill="#fff" fill-opacity="0.95" font-size="15" letter-spacing="0.12em" style="font-family: var(--font-heading)">KAMAKURA</text>
              <!-- ENOSHIMA -->
              <circle cx="152" cy="443" r="3" fill="#fff" fill-opacity="0.6"/>
              <text x="148" y="425" text-anchor="middle" fill="#fff" fill-opacity="0.5" font-size="8.5" font-weight="600" letter-spacing="0.08em" style="font-family: var(--font-body)">ENOSHIMA · 15 MIN</text>
              <!-- 海域 -->
              <text x="110" y="548" fill="#fff" fill-opacity="0.07" font-size="12" letter-spacing="0.3em" style="font-family: var(--font-heading)">SAGAMI BAY</text>
              <text x="378" y="250" fill="#fff" fill-opacity="0.07" font-size="9" font-weight="700" letter-spacing="0.26em" transform="rotate(80 378 250)" style="font-family: var(--font-body)">TOKYO BAY</text>
              <!-- compass -->
              <g transform="translate(424,516)" opacity="0.6">
                <circle r="10" fill="none" stroke="#fff" stroke-opacity="0.2"/>
                <path d="M 0,-6 L 2.3,3 L 0,1.4 L -2.3,3 Z" fill="var(--color-brand)" fill-opacity="0.8"/>
                <text y="-15" text-anchor="middle" fill="#fff" fill-opacity="0.35" font-size="8" font-weight="600" style="font-family: var(--font-body)">N</text>
              </g>
            </svg>
          </div>
        </div>

        <!-- 連泊・ナイトラン誘導（各専用ページへ） -->
        <div class="mt-10 reveal reveal-delay-1">
          <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-brand mb-4 md:text-center">{lang === 'en' ? 'GO FURTHER' : 'さらに遠くへ'}</p>
          <div class="grid grid-cols-3 max-md:grid-cols-1 gap-3">
            {[
              { href: '/hakone', img: '/assets/route/HAKONE.webp', name: 'HAKONE', sub: lang === 'en' ? 'ONSEN · DAY TRIP / OVERNIGHT' : '温泉・日帰り / 1泊2日' },
