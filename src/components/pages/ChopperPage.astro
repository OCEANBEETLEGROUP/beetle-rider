              <p class="font-[family-name:var(--font-heading-jp)] text-[13px] text-white/75 leading-[1.8]" set:html={d.detail}></p>
            </div>
            <span class="dest-card__tap-hint absolute bottom-2 left-1/2 -translate-x-1/2 z-[3] text-[9px] font-semibold tracking-[0.15em] uppercase text-white/25 transition-opacity duration-300">{t(lang, 'chopper.dest.tap')}</span>
          </div>
