          <a href={localePath(r.href, lang)} class="group relative rounded-2xl overflow-hidden aspect-[3/4] max-md:aspect-[4/5] flex items-end">
            <img src={r.img} alt={r.name} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-black/10"></div>
            <div class="relative z-[2] p-6 w-full flex items-end justify-between">
