---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CmsImage from '../../components/CmsImage.astro';
import TrustBar from '../../components/TrustBar.astro';
import CountriesBar from '../../components/CountriesBar.astro';
import Reviews from '../../components/Reviews.astro';
import IdpChecker from '../../components/IdpChecker.astro';
import { getVehicles } from '../../lib/microcms';
import { getLangFromUrl, localePath } from '../../i18n/config';
import { t } from '../../i18n/index';

const lang = getLangFromUrl(Astro.url);

const { contents: vehiclesRaw } = await getVehicles();
// Exclude 公開終了 items (closedAt present = ended publication, even if API key returns them)
const published = vehiclesRaw.filter(v => !(v as any).closedAt);
// Display logic: active → normal, maintenance → viewable/no booking, hidden → COMING SOON
const vehicles = published.map((v, i) => ({
  slug: v.slug,
  name: v.name,
  specs: `${v.base} — Hard Tail ${v.style || 'Chopper'}`,
  num: String(i + 1).padStart(2, '0'),
  img: v.thumbnail.url + '?w=800&q=80',
  imgW: v.thumbnail.width,
  imgH: v.thumbnail.height,
  price: v.dayRidePrice,
  status: v.status?.[0] || 'active',
}));

const faqKeys = ['license', 'alcohol', 'weather', 'checkin', 'equipment', 'clothing', 'fuel', 'toll', 'insurance', 'tandem', 'luggage', 'extension', 'cancel'] as const;
const protocolItems = faqKeys.map(key => ({
  title: t(lang, `chopper.faq.${key}.title` as any) as string,
  content: t(lang, `chopper.faq.${key}.content` as any) as string,
}));

// SEO structured data (Service + FAQPage)
const chopperPageUrl = `https://beetlerider.com${Astro.url.pathname}`;
const chopperSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Motorcycle Rental',
    name: lang === 'en' ? 'Kamakura Chopper Rental' : '鎌倉 チョッパー・ハーレーレンタル',
    description: lang === 'en'
      ? 'Vintage chopper (Harley-based) motorcycle rental in Kamakura, Japan. License + IDP required.'
      : '鎌倉でのヴィンテージ・チョッパー（ハーレー）レンタル。要二輪免許。',
    provider: { '@id': 'https://beetlerider.com/#localbusiness' },
    areaServed: { '@type': 'City', name: 'Kamakura' },
    url: chopperPageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: protocolItems.map(f => ({
      '@type': 'Question',
      name: f.title,
      acceptedAnswer: { '@type': 'Answer', text: f.content.replace(/<[^>]+>/g, '') },
    })),
  },
];
---

<BaseLayout title={t(lang, 'meta.chopper.title') as string} description={t(lang, 'meta.chopper.desc') as string} activePage="chopper" headerLogo="chopper" schema={chopperSchema}>

  <!-- ============================
       Section 1: Hero — Cinematic
       ============================ -->
  <section class="relative h-screen max-lg:h-[100svh] min-h-[600px] max-md:min-h-0 flex items-center justify-center overflow-hidden" id="hero">
    <!-- Video Background -->
    <div class="absolute inset-0 bg-[#0a0a0a] z-0">
      <video autoplay muted loop playsinline preload="metadata" poster="/assets/chopper/promo/R0006459.webp" class="w-full h-full object-cover" id="heroVideo">
        <source src="/assets/video/CHOPPER.mp4" type="video/quicktime">
        <source src="/assets/video/CHOPPER.mp4" type="video/mp4">
      </video>
    </div>
    <!-- Overlay -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_80%,rgba(195,13,35,0.08)_0%,transparent_60%),linear-gradient(to_bottom,rgba(0,0,0,0.3)_0%,rgba(0,0,0,0.6)_100%)] z-[1]"></div>
    <!-- Film Grain Noise -->
    <div class="absolute inset-0 z-[1] opacity-40" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E&quot;)"></div>
    <!-- Content -->
    <div class="relative z-[2] text-center px-6">
      <p class="text-[11px] font-bold tracking-[0.4em] uppercase text-brand mb-6 opacity-0 animate-[heroFadeUp_1s_ease_forwards_0.6s]">{t(lang, 'chopper.hero.label')}</p>
      <h1 class="font-[family-name:var(--font-heading)] text-[clamp(56px,12vw,140px)] text-white tracking-[-0.03em] leading-[0.9] mb-4 opacity-0 animate-[heroFadeUp_1s_ease_forwards_0.8s]" set:html={(t(lang, 'chopper.hero.heading') as string).replace('\n', '<br>')} />
      <h2 class="font-[family-name:var(--font-heading)] text-[clamp(24px,5vw,56px)] text-white/85 tracking-[-0.01em] leading-[1.1] mb-6 opacity-0 animate-[heroFadeUp_1s_ease_forwards_1s]">{t(lang, 'chopper.hero.sub')}</h2>
      <p class="font-[family-name:var(--font-heading-jp)] text-[clamp(13px,1.5vw,17px)] font-medium text-white/40 tracking-[0.08em] opacity-0 animate-[heroFadeUp_1s_ease_forwards_1.2s]">{t(lang, 'chopper.hero.desc')}</p>
    </div>
    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-[2] flex flex-col items-center gap-2 opacity-0 animate-[heroFadeUp_1s_ease_forwards_1.5s]">
      <span class="text-[9px] font-semibold tracking-[0.3em] uppercase text-white/30">{t(lang, 'common.scroll')}</span>
      <svg class="w-5 h-5 text-white/30 animate-[scrollBounce_2s_ease-in-out_infinite]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  </section>

  <TrustBar lang={lang} variant="chopper" />
  <!-- チョッパー実績バナー（貸渡簿の住所+電話国番号から算出 2026-07-10: 56人・10カ国。更新時はDB再集計） -->
  <CountriesBar lang={lang} theme="brand" count={10} riders={56} codes={['us', 'au', 'jp', 'de', 'gb', 'ca', 'sg', 'tr', 'mt', 'id']} />

  <!-- ============================
       Section 2: Vehicle Gallery
       ============================ -->
  <section class="pt-20 pb-24 bg-deep-red relative overflow-hidden" id="gallery">
    <div class="text-center mb-10 px-10">
      <div class="reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">{t(lang, 'chopper.fleet.label')}</p>
      </div>
      <div class="reveal reveal-delay-1">
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(28px,4vw,52px)] text-white tracking-[-0.02em]">{t(lang, 'chopper.fleet.heading')}</h2>
      </div>
    </div>
    <div class="relative px-16 max-md:px-4">
      <!-- Prev Button -->
      <button class="absolute top-1/2 -translate-y-1/2 left-4 z-10 w-12 h-12 rounded-full bg-white/[0.08] border border-white/[0.12] backdrop-blur-[12px] flex items-center justify-center cursor-pointer transition-all duration-300 hover:bg-white/[0.16] hover:border-white/25 hover:-translate-y-1/2 hover:scale-105 max-md:hidden" id="galleryPrev" aria-label="Previous">
        <svg class="w-[18px] h-[18px] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <!-- Track -->
      <div class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth py-4 pb-10 cursor-grab [&:active]:cursor-grabbing [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden max-md:px-4" id="galleryTrack">
        {vehicles.map((v) => (
          v.status === 'hidden' ? (
            <div class="flex-none w-[400px] max-lg:w-[340px] max-md:w-[320px] aspect-[3/4] rounded-2xl overflow-hidden relative snap-center cursor-not-allowed select-none">
              <div class="absolute inset-0 bg-[#111]">
                <CmsImage src={v.img} width={800} naturalWidth={v.imgW} naturalHeight={v.imgH} alt={v.name} loading="lazy" class="w-full h-full object-cover blur-[6px] brightness-50" />
              </div>
              <div class="absolute inset-0 bg-black/40 z-[1]"></div>
              <div class="absolute inset-0 flex flex-col items-center justify-center z-[2]">
                <p class="font-[family-name:var(--font-heading)] text-[clamp(20px,2.5vw,28px)] text-white/80 tracking-[0.15em] uppercase">COMING SOON</p>
                <p class="font-[family-name:var(--font-heading)] text-sm text-white/40 tracking-wide mt-2">{v.name}</p>
              </div>
            </div>
          ) : (
            <a href={localePath('/chopper/' + v.slug, lang)} class="group flex-none w-[400px] max-lg:w-[340px] max-md:w-[320px] aspect-[3/4] rounded-2xl overflow-hidden relative snap-center transition-transform duration-500 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] hover:-translate-y-2 cursor-pointer">
              <div class="absolute inset-0 bg-[#111] transition-transform duration-600 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-hover:scale-[1.06]">
                <CmsImage src={v.img} width={800} naturalWidth={v.imgW} naturalHeight={v.imgH} alt={v.name} loading="lazy" class={`w-full h-full object-cover${v.status === 'maintenance' ? ' brightness-75 saturate-50' : ''}`} />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-black/20 z-[1]"></div>
              {v.status === 'maintenance' && (
                <div class="absolute top-4 left-4 z-[3] px-3 py-1.5 rounded-full bg-amber-500/90 backdrop-blur-[8px] text-[10px] font-bold tracking-[0.12em] uppercase text-white">
                  MAINTENANCE
                </div>
              )}
              <div class="absolute bottom-0 left-0 right-0 p-8 z-[2]">
                <p class="font-[family-name:var(--font-heading)] text-xs text-brand tracking-[0.15em] mb-3 opacity-70">{v.num}</p>
                <h3 class="font-[family-name:var(--font-heading)] text-[clamp(24px,3vw,32px)] text-white tracking-[-0.01em] leading-none mb-2">{v.name}</h3>
                <p class="text-xs font-medium text-white/45 tracking-[0.03em] leading-relaxed">{v.specs}</p>
                {v.price && (
                  <p class="mt-3 font-[family-name:var(--font-heading)] text-[15px] text-white/90 tracking-wide">
                    ¥{v.price.toLocaleString()}<span class="font-[family-name:var(--font-body)] text-[10px] font-bold tracking-[0.15em] uppercase text-white/40"> / DAY</span>
                  </p>
                )}
                <div class="flex items-center gap-2 mt-5 text-[11px] font-bold tracking-[0.2em] uppercase text-white opacity-0 translate-y-2 transition-all duration-400 group-hover:opacity-100 group-hover:translate-y-0">
                  <span>{t(lang, 'chopper.fleet.viewDetails')}</span>
                  <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </div>
              </div>
            </a>
          )
        ))}
      </div>
      <!-- Next Button -->
      <button class="absolute top-1/2 -translate-y-1/2 right-4 z-10 w-12 h-12 rounded-full bg-white/[0.08] border border-white/[0.12] backdrop-blur-[12px] flex items-center justify-center cursor-pointer transition-all duration-300 hover:bg-white/[0.16] hover:border-white/25 hover:-translate-y-1/2 hover:scale-105 max-md:hidden" id="galleryNext" aria-label="Next">
        <svg class="w-[18px] h-[18px] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
    <!-- Dots -->
    <div class="flex justify-center gap-2 mt-6" id="galleryProgress">
      {vehicles.map((_, i) => (
        <button class:list={['h-2 rounded-full border-none cursor-pointer transition-all duration-300 p-0', i === 0 ? 'bg-brand w-6' : 'bg-white/15 w-2']} data-index={i} aria-label={`Slide ${i + 1}`}></button>
      ))}
    </div>
  </section>



  <!-- ============================
       Section 3: Route 134 Map
       ============================ -->
  <!-- 3a: 「134号線という聖域」ヘッダー（背景画像なし・センター揃え TAKE指示 2026-07-10） -->
  <section class="pt-24 pb-10 px-10 max-md:pt-16 max-md:px-6 bg-deep-red overflow-hidden reveal" id="routeMap">
    <div class="max-w-[1200px] mx-auto text-center relative">
      <span class="absolute inset-x-0 -top-8 max-md:-top-4 font-[family-name:var(--font-heading)] text-[clamp(96px,14vw,180px)] text-white/[0.045] leading-none select-none pointer-events-none" aria-hidden="true">134</span>
      <div class="relative z-[1] pt-14 max-md:pt-8">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-brand mb-4">{t(lang, 'chopper.route.label')}</p>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(30px,4.5vw,56px)] text-white tracking-[-0.02em] mb-4">{t(lang, 'chopper.route.heading')}</h2>
        <p class="text-[13px] max-md:text-[12.5px] text-white/55 font-medium">{lang === 'en' ? 'An hour from Tokyo — and this coastal road runs straight on to Hakone and Mt. Fuji.' : '東京から60分。この海沿いの一本道は、箱根へ、富士へと、そのまま一直線につながっている。'}</p>
      </div>
    </div>
  </section>

  <!-- 3b: 行き先マップ（全幅・横長v7） -->
  <section class="pb-16 px-10 max-md:px-3 bg-deep-red overflow-hidden reveal" id="destMap">
    <div class="max-w-[1200px] mx-auto text-left">
      <!-- 行き先マップ v9 — コード製ジオラマ（MAP LAB R4採用・2026-07-08）
           台形富士・箱根=2面立体 / C1=柱付き高架リング+ビル群 / ベイブリッジ / ターンパイク /
           走行ライト3系統(134=鎌倉発往復・ターンパイク往復・C1周回、オレンジ・最前面レイヤー) -->
      <div id="dioScroll" class="max-md:overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <svg viewBox="0 0 1440 640" xmlns="http://www.w3.org/2000/svg" class="dio w-full h-auto max-md:min-w-[920px]" aria-label="Destinations from Kamakura, drawn in code: Route 134, Turnpike to Hakone, Mt. Fuji, Atami-Izu, Shuto C1 loop with Shibuya Shinjuku Ueno Ginza, Bayshore Route, Bay Bridge, Daikoku PA, Yokohama, Yokosuka">
        <defs>
          <filter id="dglow" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="4.5" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <filter id="dglow2" x="-60%" y="-60%" width="220%" height="220%">
            <feGaussianBlur stdDeviation="7" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <linearGradient id="dsea" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0.035"/><stop offset="1" stop-color="#ffffff" stop-opacity="0"/>
          </linearGradient>
        </defs>

        <!-- ===== 地形(奥の稜線) ===== -->
        <path d="M 580,478 L 650,432 L 705,460 L 760,428 L 830,458 L 900,435 L 965,464 L 1030,442 L 1080,478 L 1080,512 L 580,512 Z" fill="#000" opacity="0.22"/>

        <!-- ===== 富士山(2面+雪冠) ===== -->
        <path d="M 150,415 C 192,392 226,342 238,292 L 260,292 L 260,415 Z" fill="#ffffff" fill-opacity="0.045"/>
        <path d="M 260,292 L 282,292 C 294,342 328,392 370,415 L 260,415 Z" fill="#000" fill-opacity="0.38"/>
        <path d="M 150,415 C 192,392 226,342 238,292 L 282,292 C 294,342 328,392 370,415" fill="none" stroke="#ffffff" stroke-opacity="0.28" stroke-width="1.6" stroke-linejoin="round"/>
        <path d="M 238,292 L 282,292 L 287,308 L 274,300 L 264,313 L 252,302 L 242,311 L 234,303 Z" fill="#ffffff" fill-opacity="0.5"/>
        <text x="260" y="442" text-anchor="middle" class="dt-town">MT. FUJI</text>
        <text x="260" y="460" text-anchor="middle" class="dt-dist">2 HRS</text>

        <!-- ===== 箱根(3峰・2面) ===== -->
        <path d="M 430,505 L 485,432 L 522,505 Z" fill="#ffffff" fill-opacity="0.045"/>
        <path d="M 485,432 L 522,505 L 485,505 Z" fill="#000" fill-opacity="0.32"/>
        <path d="M 498,505 L 542,450 L 575,505 Z" fill="#ffffff" fill-opacity="0.04"/>
        <path d="M 542,450 L 575,505 L 542,505 Z" fill="#000" fill-opacity="0.3"/>
        <path d="M 430,505 L 485,432 L 522,505 M 498,505 L 542,450 L 575,505" fill="none" stroke="#ffffff" stroke-opacity="0.22" stroke-width="1.3" stroke-linejoin="round"/>
        <text x="600" y="450" class="dt-town">HAKONE</text>
        <text x="600" y="466" class="dt-dist">90 MIN · ONSEN</text>

        <!-- ===== 海(相模湾) ===== -->
        <path d="M 100,632 C 240,590 340,565 440,554 C 560,545 700,540 940,537 C 1060,536 1180,545 1340,585 L 1440,610 L 1440,640 L 0,640 L 0,650 Z" fill="url(#dsea)"/>
        <g stroke="#ffffff" stroke-opacity="0.05" stroke-width="1">
          <path d="M 460,600 h 60 M 476,610 h 46"/><path d="M 760,596 h 54 M 774,606 h 40"/><path d="M 1050,600 h 44"/>
        </g>
        <text x="520" y="636" text-anchor="middle" class="dt-ghost">SAGAMI BAY</text>

        <!-- ===== 海岸線 ===== -->
        <path d="M 120,625 C 230,588 330,562 420,552 C 530,541 620,538 700,536 C 790,533.5 870,532 935,532 C 1030,532 1110,535 1170,541 C 1245,549 1300,564 1345,582" fill="none" stroke="#ffffff" stroke-opacity="0.15" stroke-width="1.5"/>

        <!-- ===== ROUTE 134(太い海沿いロード: 下地+グロー+コア) ===== -->
        <path d="M 168,610 C 260,580 340,558 420,548 C 530,537 620,534 700,532 C 790,529.5 870,528 935,528 C 1030,528 1095,530.5 1150,536" fill="none" stroke="#40080e" stroke-opacity="0.9" stroke-width="8" stroke-linecap="round"/>
        <g filter="url(#dglow)">
          <path d="M 168,610 C 260,580 340,558 420,548 C 530,537 620,534 700,532 C 790,529.5 870,528 935,528 C 1030,528 1095,530.5 1150,536" fill="none" stroke="var(--color-brand)" stroke-opacity="0.9" stroke-width="4.2" stroke-linecap="round"/>
        </g>
        <text x="700" y="512" text-anchor="middle" class="dt-roadname">ROUTE 134</text>
        <!-- ライダーの光 -->
        <circle class="orbit-light" r="3.2" fill="#FFA640" opacity="0.95" filter="url(#dglow2)">
          <animateMotion dur="18s" repeatCount="indefinite" rotate="none" calcMode="linear"
            keyPoints="0.78;1;0.78;0;0.78" keyTimes="0;0.13;0.36;0.86;1"
            path="M 168,610 C 260,580 340,558 420,548 C 530,537 620,534 700,532 C 790,529.5 870,528 935,528 C 1030,528 1095,530.5 1150,536"/>
        </circle>
        <!-- ターンパイク往復の光 -->
        <circle class="orbit-light" r="2.4" fill="#FFA640" opacity="0.9" filter="url(#dglow2)">
          <animateMotion dur="7s" repeatCount="indefinite" rotate="none" calcMode="linear"
            keyPoints="0;1;0" keyTimes="0;0.5;1"
            path="M 412,545 C 400,536 380,533 372,524 C 363,514 386,510 396,502 C 406,494 380,488 371,481 C 362,474 385,468 397,462 C 405,458 407,452 404,446"/>
        </circle>

        <!-- ===== ターンパイク(小さめのうねうね) ===== -->
        <g filter="url(#dglow)">
          <path d="M 412,545 C 400,536 380,533 372,524 C 363,514 386,510 396,502 C 406,494 380,488 371,481 C 362,474 385,468 397,462 C 405,458 407,452 404,446" fill="none" stroke="var(--color-brand)" stroke-opacity="0.7" stroke-width="2.6" stroke-linecap="round"/>
        </g>
        <text x="262" y="498" class="dt-roadname" text-anchor="middle">TURNPIKE</text>

        <!-- ===== 熱海・伊豆 ===== -->
        <circle cx="168" cy="610" r="4" fill="#fff" fill-opacity="0.5"/>
        <text x="186" y="632" class="dt-town">ATAMI · IZU</text>

        <!-- ===== TOKYO都市+C1(高架リング) ===== -->
        <text x="780" y="56" text-anchor="middle" class="dt-hero">TOKYO</text>
        <rect x="640" y="138" width="26" height="70" fill="#150609" stroke="rgba(255,255,255,0.06)" stroke-width="0.8"/>
      <line x1="649.1" y1="145" x2="649.1" y2="201" stroke="#ffca8f" stroke-opacity="0.16" stroke-width="1.4" stroke-dasharray="2 4.5"/>
      <line x1="658.7" y1="145" x2="658.7" y2="201" stroke="#ffca8f" stroke-opacity="0.16" stroke-width="1.4" stroke-dasharray="2 4.5"/>
      <rect x="672" y="113" width="20" height="95" fill="#150609" stroke="rgba(255,255,255,0.06)" stroke-width="0.8"/>
      <line x1="679.0" y1="120" x2="679.0" y2="201" stroke="#ffca8f" stroke-opacity="0.16" stroke-width="1.4" stroke-dasharray="2 4.5"/>
      <line x1="686.4" y1="120" x2="686.4" y2="201" stroke="#ffca8f" stroke-opacity="0.16" stroke-width="1.4" stroke-dasharray="2 4.5"/>
      <rect x="696" y="88" width="30" height="120" fill="#150609" stroke="rgba(255,255,255,0.06)" stroke-width="0.8"/>
      <line x1="706.5" y1="95" x2="706.5" y2="201" stroke="#ffca8f" stroke-opacity="0.16" stroke-width="1.4" stroke-dasharray="2 4.5"/>
      <line x1="717.6" y1="95" x2="717.6" y2="201" stroke="#ffca8f" stroke-opacity="0.16" stroke-width="1.4" stroke-dasharray="2 4.5"/>
      <rect x="730" y="123" width="22" height="85" fill="#150609" stroke="rgba(255,255,255,0.06)" stroke-width="0.8"/>
      <line x1="737.7" y1="130" x2="737.7" y2="201" stroke="#ffca8f" stroke-opacity="0.16" stroke-width="1.4" stroke-dasharray="2 4.5"/>
