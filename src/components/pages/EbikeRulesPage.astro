---
/**
 * E-BIKE RULES v2 — 店舗の使用説明書（Notion「E-BIKE-交通ルール/Traffic Rules」）準拠。
 * 信号比較画像は自社アセット(GitHub raw→self-host)。左側通行・二段階右折は
 * 著作権回避のためSVG図を自作（TAKE指示 2026-07-07）。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, localePath } from '../../i18n/config';

const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';

const L = en ? {
  metaTitle: 'E-Bike Riding Rules｜BEETLE RIDER Kamakura',
  metaDesc: 'The complete riding rules for BEETLE RIDER e-bikes: follow the CAR traffic lights, keep to the far-left edge, two-step right turns, 20km/h, one rider, no alcohol.',
  label: 'RIDE RULES',
  heading: 'Ride Right.',
  sub: 'Four big rules, four small ones. Three minutes — then the coast is yours.',
  bigIdea: 'THE BIG IDEA',
  bigIdeaTitle: 'Your E-BIKE is a VEHICLE.',
  bigIdeaBody: 'By Japanese law, this e-bike is a small motor vehicle — not a toy, and not a pedestrian. There is really only one thing to remember:',
  bigIdeaQuote: 'Ride like a small motorbike: on the road, at the far-left edge, obeying the CAR traffic lights.',
  r1t: 'RULE 1 — Obey the CAR traffic light',
  r1do: ['Car light green → go. Car light red → stop.'],
  r1dont: ['Never move or stop based on the PEDESTRIAN light.', 'Pedestrian green + car red = you do NOT go.'],
  r1note: 'To use a sidewalk or pedestrian signal, get off and PUSH the e-bike — then you count as a pedestrian.',
  r2t: 'RULE 2 & 3 — Keep left, ride the far-left edge',
  r2do: ['Ride the SAME direction as cars, on the left half of the road.', 'Stay as far to the left edge as you safely can.'],
  r2dont: ['Riding on the right side (facing traffic) is the most dangerous violation.', 'No riding on sidewalks — they belong to pedestrians.'],
  r4t: 'RULE 4 — Right turns: ALWAYS two steps',
  r4steps: ['Go STRAIGHT across the intersection to the far corner.', 'Stop, turn your bike to the right, and go when the light ahead is green.'],
  r4dont: 'Never swing diagonally across from the middle of the lane.',
  smallTitle: 'And the four small rules',
  small: [
    ['MAX 20 KM/H', 'Speed is capped automatically. Don\'t fight it.'],
    ['ONE RIDER ONLY', 'No passengers, no children on board.'],
    ['NO ALCOHOL · PHONE · EARPHONES', 'All three are against the law while riding.'],
    ['PARK IN DESIGNATED SPOTS', 'Bicycle lots or motorcycle bays. Fat tire won\'t fit the rack rail? Use the motorcycle bay.'],
  ],
  safetyTitle: 'For your safety',
  safety: 'We strongly recommend a helmet (free to borrow). Lights on at night.',
  oneLine: 'Ride on the road, at the left edge, obey the car lights, ride solo. Two-step every right turn. Stay off the sidewalk.',
  cta: 'RULES CLEAR? BOOK YOUR E-BIKE',
  faqLink: 'More questions? Read the FAQ',
  imgAltSignal: 'Follow the car traffic light, not the pedestrian light',
} : {
  metaTitle: 'E-BIKEの交通ルール｜BEETLE RIDER 鎌倉',
  metaDesc: 'BEETLE RIDERのE-BIKE交通ルール完全版。クルマの信号に従う・車道の左端を走る・二段階右折・20km/h・1人乗り・飲酒禁止。',
  label: 'RIDE RULES',
  heading: 'Ride Right.',
  sub: '大きなルール4つ、小さなルール4つ。3分で読めば、海はあなたのものです。',
  bigIdea: 'THE BIG IDEA',
  bigIdeaTitle: 'このE-BIKEは「クルマ」です。',
  bigIdeaBody: '法律上、このE-BIKEは「特定小型原動機付自転車」＝小さなバイクです。おもちゃでも歩行者でもありません。覚えることは、たった1つ：',
  bigIdeaQuote: '小さなバイクのように、車道を、左端を、クルマの信号に従って走る。',
  r1t: 'ルール1 — 信号は「クルマの信号」に従う',
  r1do: ['クルマ用の信号が青 → 進む／赤 → 止まる。'],
  r1dont: ['歩行者用の信号を見て進む・止まるのはNG。', '歩行者用が青でも、クルマ用が赤なら進まない。'],
  r1note: '歩道や歩行者用信号を使うときは、必ずE-BIKEから降りて押して歩く——そのときは歩行者として扱われます。',
  r2t: 'ルール2・3 — 左側通行、車道の一番左端を走る',
  r2do: ['クルマと同じ方向に、道路の左半分を走る。', 'その中でも、できるだけ左の端に寄る。'],
  r2dont: ['右側を走る「逆走」は最も危険な違反です。', '歩道は走らない——歩道は歩行者のものです。'],
  r4t: 'ルール4 — 右折は必ず「二段階右折」',
  r4steps: ['交差点の向こう側の角まで、まず直進する。', 'そこで止まって右に向きを変え、正面の信号が青になったら直進する。'],
  r4dont: '車線の真ん中から斜めに右折するのはNG。「二段階右折禁止」の標識は原付用で、このE-BIKEには適用されません。',
  smallTitle: '小さなルール4つ',
  small: [
    ['最高20KM/H', '速度は自動制限されています。無理に出そうとしないこと。'],
    ['1台に1人', '二人乗り・お子様の同乗はできません。'],
    ['飲酒・スマホ・イヤホン禁止', '3つとも走行中は法律違反です。'],
    ['駐輪は決められた場所に', '駐輪場かバイク（原付）用スペースへ。タイヤが太くてラックに入らない時はバイク枠へ。'],
  ],
  safetyTitle: '安全のために',
  safety: 'ヘルメットの着用を強くおすすめします（無料でお貸しします）。夜はライトを点けてください。',
  oneLine: '車道の左端を、クルマの信号に従って、一人で走る。右折は必ず二段階。歩道は走らない。',
  cta: 'ルールOK？ E-BIKEを予約する',
  faqLink: 'ほかの疑問はFAQへ',
  imgAltSignal: '歩行者用ではなくクルマ用の信号に従う',
};
---

<BaseLayout title={L.metaTitle} description={L.metaDesc} activePage="ebike" headerLogo="ebike">
  <!-- Hero -->
  <section class="pt-36 pb-12 px-6 md:px-10 bg-ebike text-center">
    <p class="text-[11px] font-bold tracking-[0.35em] uppercase text-white/60 mb-4">{L.label}</p>
    <h1 class="font-[family-name:var(--font-heading)] text-[clamp(38px,6vw,72px)] text-white tracking-tight leading-none mb-3">{L.heading}</h1>
    <p class="font-[family-name:var(--font-heading-jp)] text-[14px] text-white/65 font-medium">{L.sub}</p>
  </section>

  <!-- 大原則 -->
  <section class="pb-12 px-6 md:px-10 bg-ebike">
    <div class="max-w-[760px] mx-auto rounded-2xl bg-white p-8 md:p-10 text-center">
      <p class="text-[10px] font-bold tracking-[0.25em] uppercase text-ebike mb-3">{L.bigIdea}</p>
      <h2 class="font-[family-name:var(--font-heading)] text-[clamp(20px,3vw,28px)] text-[#1A1A1A] tracking-tight mb-3">{L.bigIdeaTitle}</h2>
      <p class="text-[13.5px] text-[#1A1A1A]/70 leading-[1.9] mb-5">{L.bigIdeaBody}</p>
      <p class="font-[family-name:var(--font-heading-jp)] text-[15px] md:text-[17px] font-bold text-ebike leading-relaxed">“{L.bigIdeaQuote}”</p>
    </div>
  </section>

  <!-- ルール1: 信号（実写真） -->
  <section class="pb-12 px-6 md:px-10 bg-ebike">
    <div class="max-w-[760px] mx-auto rounded-2xl bg-white/[0.08] border border-white/[0.14] overflow-hidden">
      <div class="px-6 pt-6">
        <img src="/assets/rules/signal_compare.png" alt={L.imgAltSignal} class="w-full rounded-xl" loading="lazy" />
      </div>
      <div class="p-7 md:p-8">
        <h2 class="font-[family-name:var(--font-heading)] text-[17px] text-white tracking-wide mb-4">🚦 {L.r1t}</h2>
        <ul class="flex flex-col gap-2 mb-4">
          {L.r1do.map((x) => <li class="text-[13px] text-white/80 leading-[1.8]"><span class="text-green-300 font-bold">✓</span> {x}</li>)}
          {L.r1dont.map((x) => <li class="text-[13px] text-white/80 leading-[1.8]"><span class="text-white font-bold">✕</span> {x}</li>)}
        </ul>
        <p class="text-[12px] text-white/60 leading-[1.8] border-t border-white/15 pt-4">🚶 {L.r1note}</p>
      </div>
    </div>
  </section>

  <!-- ルール2・3: 左側通行＋左端（自作SVG図） -->
  <section class="pb-12 px-6 md:px-10 bg-ebike">
    <div class="max-w-[760px] mx-auto rounded-2xl bg-white/[0.08] border border-white/[0.14] overflow-hidden">
      <div class="px-6 pt-6">
        <!-- AI生成イラスト（fal.ai nano-banana・著作権フリー自社生成）+ バイリンガルラベル -->
        <div class="relative rounded-xl overflow-hidden bg-[#26060b] max-w-[540px] mx-auto">
          <img src="/assets/rules/keepleft_ai.webp" alt="Keep left: ride in the left lane with the flow. Riding against traffic is prohibited. 左側通行・逆走禁止" class="w-full h-auto block" loading="lazy" />
          <span class="absolute left-[3%] bottom-[4%] px-2 py-1 md:px-3 md:py-1.5 rounded-full bg-green-500 text-white text-[8.5px] md:text-[11.5px] font-bold tracking-wide whitespace-nowrap shadow-lg">✓ KEEP LEFT — 左側を走る</span>
          <span class="absolute right-[3%] top-[54%] px-2 py-1 md:px-3 md:py-1.5 rounded-full bg-white/95 text-[#8e1d40] text-[8.5px] md:text-[11.5px] font-bold tracking-wide whitespace-nowrap shadow-lg">✕ WRONG WAY — 逆走禁止</span>
          <span class="absolute right-[3%] top-[22%] px-2 py-1 md:px-3 md:py-1.5 rounded-full bg-black/55 text-white/80 text-[8px] md:text-[10.5px] font-bold tracking-wide whitespace-nowrap backdrop-blur-sm">対向車線 / ONCOMING LANE</span>
        </div>
      </div>
      <div class="p-7 md:p-8">
        <h2 class="font-[family-name:var(--font-heading)] text-[17px] text-white tracking-wide mb-4">⬅️ {L.r2t}</h2>
        <ul class="flex flex-col gap-2">
          {L.r2do.map((x) => <li class="text-[13px] text-white/80 leading-[1.8]"><span class="text-green-300 font-bold">✓</span> {x}</li>)}
          {L.r2dont.map((x) => <li class="text-[13px] text-white/80 leading-[1.8]"><span class="text-white font-bold">✕</span> {x}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ルール4: 二段階右折（自作SVG図） -->
  <section class="pb-12 px-6 md:px-10 bg-ebike">
    <div class="max-w-[760px] mx-auto rounded-2xl bg-white/[0.08] border border-white/[0.14] overflow-hidden">
      <div class="px-6 pt-6">
        <!-- AI生成イラスト（fal.ai nano-banana・著作権フリー自社生成）+ ステップラベル -->
        <div class="relative rounded-xl overflow-hidden bg-[#26060b] max-w-[540px] mx-auto">
          <img src="/assets/rules/twostep_ai.webp" alt="Two-step right turn: go straight across the intersection, stop, turn your bike right, then go when the light turns green. Never cut diagonally. 二段階右折" class="w-full h-auto block" loading="lazy" />
          <span class="absolute left-[53%] top-[66%] px-2 py-1 md:px-3 md:py-1.5 rounded-full bg-[#B42550] text-white text-[8.5px] md:text-[11px] font-bold tracking-wide whitespace-nowrap shadow-lg">① GO STRAIGHT — まず直進</span>
          <span class="absolute left-[24%] top-[41%] px-2 py-1 md:px-3 md:py-1.5 rounded-full bg-[#B42550] text-white text-[8.5px] md:text-[11px] font-bold tracking-wide whitespace-nowrap shadow-lg">② STOP & TURN — 停止して右を向く</span>
          <span class="absolute right-[2%] top-[34%] px-2 py-1 md:px-3 md:py-1.5 rounded-full bg-[#B42550] text-white text-[8.5px] md:text-[11px] font-bold tracking-wide whitespace-nowrap shadow-lg">③ GO — 青で直進</span>
          <span class="absolute left-[4%] top-[81%] px-2 py-1 md:px-3 md:py-1.5 rounded-full bg-white/95 text-[#8e1d40] text-[8.5px] md:text-[11px] font-bold tracking-wide whitespace-nowrap shadow-lg">✕ NO DIAGONAL — 斜め右折禁止</span>
        </div>
      </div>
      <div class="p-7 md:p-8">
        <h2 class="font-[family-name:var(--font-heading)] text-[17px] text-white tracking-wide mb-4">↱ {L.r4t}</h2>
        <ol class="flex flex-col gap-2 mb-4">
          {L.r4steps.map((x, i) => <li class="text-[13px] text-white/80 leading-[1.8]"><span class="inline-flex w-5 h-5 rounded-full bg-white/20 text-white text-[10px] font-bold items-center justify-center mr-1.5">{i + 1}</span>{x}</li>)}
        </ol>
        <p class="text-[12px] text-white/60 leading-[1.8] border-t border-white/15 pt-4">✕ {L.r4dont}</p>
      </div>
    </div>
  </section>

  <!-- 小ルール4つ -->
  <section class="pb-12 px-6 md:px-10 bg-ebike">
    <div class="max-w-[760px] mx-auto">
      <h2 class="font-[family-name:var(--font-heading)] text-[clamp(18px,2.5vw,24px)] text-white tracking-tight mb-5">{L.smallTitle}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {L.small.map(([title, body]) => (
          <div class="rounded-2xl bg-white/[0.08] border border-white/[0.14] p-6">
            <h3 class="text-[12px] font-bold tracking-[0.14em] uppercase text-white mb-2">{title}</h3>
            <p class="text-[13px] text-white/70 leading-[1.85]">{body}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 text-[12.5px] text-white/60 leading-relaxed">🪖 <strong class="text-white/85">{L.safetyTitle}:</strong> {L.safety}</p>
    </div>
  </section>

  <!-- 一行まとめ -->
  <section class="py-12 px-6 md:px-10 bg-ebike text-center">
    <div class="max-w-[760px] mx-auto border-y border-white/25 py-8">
      <p class="font-[family-name:var(--font-heading-jp)] text-[clamp(15px,2.2vw,20px)] font-bold text-white leading-[1.9]">{L.oneLine}</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-20 px-6 md:px-10 bg-ebike text-center">
    <a href={localePath('/ebike', lang) + '#plans'} class="inline-flex items-center gap-2.5 px-9 py-4 rounded-full bg-white text-ebike text-[12.5px] font-bold tracking-[0.15em] uppercase hover:-translate-y-0.5 hover:shadow-[0_10px_30px_rgba(0,0,0,0.2)] transition-all">
      {L.cta}
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
    <p class="mt-6">
      <a href={localePath('/faq', lang) + '#ebike'} class="text-[12px] font-semibold text-white/60 underline hover:text-white transition-colors">{L.faqLink}</a>
    </p>
  </section>
</BaseLayout>
