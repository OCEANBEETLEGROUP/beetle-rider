---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdpChecker from '../../components/IdpChecker.astro';
import CmsImage from '../../components/CmsImage.astro';
import { getVehicles } from '../../lib/microcms';
import { getLangFromUrl, localePath } from '../../i18n/config';

const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';

const { contents: vehiclesRaw } = await getVehicles();
const vehicles = vehiclesRaw
  .filter(v => !(v as any).closedAt && (v.status?.[0] || 'active') === 'active' && v.multiDayPrice)
  .map(v => ({
    slug: v.slug, name: v.name, base: v.base,
    price: v.multiDayPrice,
    img: v.thumbnail.url,
    imgW: v.thumbnail.width, imgH: v.thumbnail.height,
  }));

const L = en ? {
  metaTitle: 'Multi-Day Motorcycle Touring from Kamakura｜BEETLE RIDER',
  metaDesc: 'Rent a custom chopper for 2+ days and tour Hakone, Mt. Fuji and the Miura Peninsula from Kamakura. Multi-day motorcycle rental near Tokyo, one-of-one machines.',
  label: 'MULTI-DAY / TOURING',
  heading: 'TAKE IT\nFURTHER.',
  sub: 'Two days or more. Hakone, Fuji, and beyond — on a machine that exists nowhere else.',
  routesLabel: 'WHERE TO GO',
  routesHeading: 'Three Rides Worth the Nights.',
  routes: [
    { img: '/assets/route/HAKONE.webp', name: 'HAKONE LOOP', time: 'DAY TRIP — 45KM ONE WAY', desc: 'Route 134 west, then climb into the hairpins of Hakone. Onsen towns, mountain passes, and the descent back along the coast at golden hour.' },
    { img: '/assets/route/MT FUJI VIEW.webp', name: 'FUJI & LAKES', time: 'OVERNIGHT — 2 DAYS', desc: 'Push past Hakone to Lake Kawaguchiko. Wake up under Mt. Fuji, ride the lake roads at sunrise before the tour buses arrive.' },
    { img: '/assets/route/ZUSHI.webp', name: 'MIURA COASTAL', time: 'HALF DAY — 40KM LOOP', desc: 'Zushi, Hayama, and the fishing ports of the Miura Peninsula. Fresh seafood lunch, empty coastal backroads, Tokyo Bay on the return.' },
  ],
  pricingLabel: 'MULTI-DAY RATES',
  pricingHeading: 'Your Machine, For Days.',
  pricingNote: en2 => `2-day rate. Longer rentals by request — DM or book a request through the vehicle page.`,
  from: 'FROM',
  days2: '/ 2 DAYS',
  book: 'VIEW & BOOK',
  requestNote: 'Multi-day bookings are request-based: submit the dates and we confirm within 24h. Free cancellation until 5 days before.',
  idpNote: 'Riding multiple days means covering serious distance — double-check your license situation first.',
} : {
  metaTitle: '連泊ツーリング・複数日レンタル｜BEETLE RIDER 鎌倉',
  metaDesc: 'カスタムチョッパーを2日以上借りて、鎌倉から箱根・富士・三浦半島へ。世界に1台のマシンで行く連泊ツーリング。',
  label: 'MULTI-DAY / TOURING',
  heading: 'TAKE IT\nFURTHER.',
  sub: '2日以上、もっと遠くへ。箱根、富士、その先へ——世界に1台のマシンで。',
  routesLabel: 'WHERE TO GO',
  routesHeading: '泊まる価値のある3ルート。',
  routes: [
    { img: '/assets/route/HAKONE.webp', name: 'HAKONE LOOP', time: '日帰り — 片道45KM', desc: '134号線を西へ、箱根のワインディングへ。温泉街と峠道、夕暮れの海沿いを戻るゴールデンアワーの下り。' },
    { img: '/assets/route/MT FUJI VIEW.webp', name: 'FUJI & LAKES', time: '1泊2日', desc: '箱根を越えて河口湖へ。富士の麓で目覚め、観光バスが来る前の湖畔道路を朝日とともに走る。' },
    { img: '/assets/route/ZUSHI.webp', name: 'MIURA COASTAL', time: '半日 — 40KMループ', desc: '逗子、葉山、三浦半島の漁港めぐり。海鮮ランチと空いた海沿いの裏道、帰りは東京湾を眺めて。' },
  ],
  pricingLabel: 'MULTI-DAY RATES',
  pricingHeading: '数日間、あなたのマシンに。',
  pricingNote: () => '2日料金。3日以上はリクエストにて——車両ページから日程を送信してください。',
  from: 'FROM',
  days2: '/ 2日',
  book: '車両を見る・予約',
  requestNote: '連泊予約はリクエスト制です。日程送信後、24時間以内に確定をご連絡します。5日前まで無料キャンセル。',
  idpNote: '連泊ツーリングは走行距離も長くなります。まず免許の有効性を確認しておきましょう。',
};
---

<BaseLayout title={L.metaTitle} description={L.metaDesc} activePage="touring" headerLogo="chopper">
  <!-- Hero -->
  <section class="relative h-[62vh] min-h-[440px] flex items-end overflow-hidden">
    <div class="absolute inset-0 bg-[#111]">
      <img src="/assets/chopper/promo/R0006463.webp" alt="Multi-day chopper touring from Kamakura" class="w-full h-full object-cover" loading="eager" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/30 to-[rgba(45,10,10,0.97)]"></div>
    <div class="relative z-[2] px-6 md:px-10 pb-14 max-w-[1100px] mx-auto w-full">
      <p class="text-[11px] font-bold tracking-[0.35em] uppercase text-brand mb-4">{L.label}</p>
      <h1 class="font-[family-name:var(--font-heading)] text-[clamp(44px,8vw,96px)] text-white tracking-tight leading-[0.92] mb-4" set:html={L.heading.replace('\n', '<br>')} />
      <p class="font-[family-name:var(--font-heading-jp)] text-[clamp(13px,1.5vw,16px)] text-white/55 font-medium max-w-[560px] leading-relaxed">{L.sub}</p>
    </div>
  </section>

  <!-- Routes -->
  <section class="py-20 px-6 md:px-10 bg-deep-red">
    <div class="max-w-[1100px] mx-auto">
      <div class="text-center mb-12 reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">{L.routesLabel}</p>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(24px,3.5vw,44px)] text-white tracking-tight">{L.routesHeading}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {L.routes.map((r, i) => (
          <div class={`relative rounded-2xl overflow-hidden aspect-[3/4] max-md:aspect-[4/3] reveal reveal-delay-${i + 1}`}>
            <img src={r.img} alt={r.name} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-[rgba(20,4,5,0.92)] via-black/25 to-black/10"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 z-[2]">
              <p class="text-[9.5px] font-bold tracking-[0.2em] uppercase text-brand mb-2">{r.time}</p>
              <h3 class="font-[family-name:var(--font-heading)] text-[clamp(20px,2.5vw,26px)] text-white tracking-tight mb-2">{r.name}</h3>
              <p class="text-[12.5px] text-white/60 leading-[1.8]">{r.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-16 px-6 md:px-10 bg-deep-red">
    <div class="max-w-[900px] mx-auto">
      <div class="text-center mb-10 reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">{L.pricingLabel}</p>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(24px,3.5vw,40px)] text-white tracking-tight">{L.pricingHeading}</h2>
      </div>
      <div class="flex flex-col gap-3 reveal reveal-delay-1">
        {vehicles.map((v) => (
          <a href={localePath('/chopper/' + v.slug, lang)} class="group flex flex-wrap items-center gap-x-5 gap-y-2 rounded-2xl border border-white/[0.08] bg-white/[0.03] p-4 md:pr-6 hover:border-brand/50 hover:bg-white/[0.05] transition-all">
            <div class="w-20 h-20 md:w-24 md:h-24 rounded-xl overflow-hidden shrink-0 bg-[#111]">
              <CmsImage src={v.img} width={200} naturalWidth={v.imgW} naturalHeight={v.imgH} quality={70} alt={v.name} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="flex-1 min-w-[130px]">
              <h3 class="font-[family-name:var(--font-heading)] text-lg md:text-xl text-white tracking-tight">{v.name}</h3>
              <p class="text-[11.5px] text-white/40 font-medium">{v.base}</p>
            </div>
            <div class="text-right shrink-0 max-md:w-full max-md:text-left max-md:pl-[100px]">
              <p class="text-[9px] font-bold tracking-[0.2em] uppercase text-white/30">{L.from}</p>
              <p class="font-[family-name:var(--font-heading)] text-xl md:text-2xl text-white">¥{v.price.toLocaleString()}<span class="text-[11px] text-white/40 font-[family-name:var(--font-body)] font-semibold"> {L.days2}</span></p>
              <p class="text-[10px] font-bold tracking-[0.15em] uppercase text-brand mt-1 opacity-0 group-hover:opacity-100 transition-opacity">{L.book} →</p>
            </div>
          </a>
        ))}
      </div>
      <p class="text-[12px] text-white/40 leading-relaxed mt-6 text-center">{L.pricingNote()}<br>{L.requestNote}</p>
    </div>
  </section>

  <!-- IDP -->
  <section class="py-16 px-6 md:px-10 bg-deep-red">
    <div class="max-w-[800px] mx-auto">
      <p class="text-[12.5px] text-white/45 text-center mb-6">{L.idpNote}</p>
      <IdpChecker lang={lang} />
    </div>
  </section>
</BaseLayout>
