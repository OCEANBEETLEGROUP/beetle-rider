---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, localePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/index';
import TrustBar from '../../components/TrustBar.astro';
import Reviews from '../../components/Reviews.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('meta.home.title') as string} description={t('meta.home.desc') as string} activePage="home" headerLogo="chopper">

  <!-- Section 1: Split Hero -->
  <section class="flex h-screen max-lg:h-auto max-lg:min-h-0 p-1.5 gap-1.5 pt-[66px] pb-1.5 bg-deep-red max-lg:flex-col lg:p-2 lg:gap-2 lg:pt-[72px]" style="--mobile-card-h: calc((100svh - 66px - 6px) / 2);">
    <a href={localePath('/ebike', lang)} class="group relative flex-1 max-lg:h-[var(--mobile-card-h)] max-lg:flex-none rounded-[32px] overflow-hidden cursor-pointer transition-[flex] duration-600 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] hover:flex-[1.15]">
      <div class="absolute inset-0 bg-[#111] transition-transform duration-800 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-hover:scale-105">
        <video autoplay muted loop playsinline preload="metadata" poster="/assets/ebike/ebike0010.webp" class="w-full h-full object-cover">
          <source src="/assets/video/E_BIKE.mp4" type="video/mp4">
        </video>
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/10 to-black/50 group-hover:from-black/5 group-hover:to-black/40 transition-all duration-500"></div>
      <div class="absolute bottom-0 left-0 right-0 p-12 max-md:p-6 z-[2]">
        <div class="flex items-center gap-2 mb-2 max-md:mb-1">
          <div class="w-2 h-2 rounded-full bg-ebike shadow-[0_0_12px_var(--color-ebike)] animate-pulse"></div>
          <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-white/60">{t('home.hero.ebike.label')}</span>
        </div>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(36px,5vw,64px)] text-white tracking-tight leading-none mb-3">E-BIKE</h2>
        <p class="text-sm max-md:text-xs font-medium text-white/70 tracking-wide max-w-[300px] ">{t('home.hero.ebike.sub')}</p>
      </div>
      <div class="absolute bottom-12 right-10 w-14 h-14 rounded-full bg-white/10 border border-white/20 flex items-center justify-center z-[2] group-hover:bg-white/20 group-hover:translate-x-1 transition-all duration-400">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
    </a>

    <a href={localePath('/chopper', lang)} class="group relative flex-1 max-lg:h-[var(--mobile-card-h)] max-lg:flex-none rounded-[32px] overflow-hidden cursor-pointer transition-[flex] duration-600 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] hover:flex-[1.15]">
      <div class="absolute inset-0 bg-[#111] transition-transform duration-800 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-hover:scale-105">
        <video autoplay muted loop playsinline preload="metadata" poster="/assets/chopper/promo/R0006459.webp" class="w-full h-full object-cover">
          <source src="/assets/video/CHOPPER.mp4" type="video/quicktime">
          <source src="/assets/video/CHOPPER.mp4" type="video/mp4">
        </video>
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/10 to-black/50 group-hover:from-black/5 group-hover:to-black/40 transition-all duration-500"></div>
      <div class="absolute bottom-0 left-0 right-0 p-12 max-md:p-6 z-[2]">
        <div class="flex items-center gap-2 mb-2 max-md:mb-1">
          <div class="w-2 h-2 rounded-full bg-brand shadow-[0_0_12px_var(--color-brand)] animate-pulse"></div>
          <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-white/60">{t('home.hero.chopper.label')}</span>
        </div>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(36px,5vw,64px)] text-white tracking-tight leading-none mb-3">CHOPPER</h2>
        <p class="text-sm max-md:text-xs font-medium text-white/70 tracking-wide max-w-[300px] ">{t('home.hero.chopper.sub')}</p>
      </div>
      <div class="absolute bottom-12 right-10 w-14 h-14 rounded-full bg-white/10 border border-white/20 flex items-center justify-center z-[2] group-hover:bg-white/20 group-hover:translate-x-1 transition-all duration-400">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
    </a>
  </section>

  <!-- Section 2: Statement -->
  <section class="py-32 px-10 bg-deep-red text-center flex flex-col items-center justify-center min-h-[60vh]">
    <div class="reveal">
      <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-6">{t('home.statement.location')}</p>
    </div>
    <div class="reveal reveal-delay-1">
      <h2 class="font-[family-name:var(--font-accent)] text-[clamp(22px,4vw,48px)] text-white tracking-tight leading-[1.2] max-w-[900px] mb-10">
        Not Just a Rental. We Deliver<br class="md:hidden"> <em class="not-italic text-brand">Chopper Orgasm.</em>
      </h2>
    </div>
    <div class="reveal reveal-delay-2">
      <div class="w-12 h-px bg-white/15 mx-auto mb-10"></div>
    </div>
    <div class="reveal reveal-delay-3">
      <p class="text-sm text-white/60 leading-relaxed max-w-[600px]" set:html={
        (t('home.statement.body') as string).replace(/\n/g, '<br class="hidden md:block">')
      } />
    </div>
  </section>

  <TrustBar lang={lang} variant="home" />

  <!-- Section 3: Access Map -->
  <section class="py-16 px-10 bg-deep-red">
    <div class="max-w-[1200px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div>
        <div class="reveal">
          <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">{t('home.access.label')}</p>
          <h2 class="font-[family-name:var(--font-heading)] text-[clamp(28px,3.5vw,48px)] text-white leading-tight mb-2">
            60 Min From Tokyo.
          </h2>
          <span class="block font-[family-name:var(--font-heading-jp)] text-sm text-white/40 font-bold mb-6">{t('home.access.subtitle')}</span>
        </div>
        <div class="reveal reveal-delay-1">
          <p class="text-sm text-white/50 leading-relaxed mb-8">
            {t('home.access.body')}
          </p>
        </div>
        <div class="reveal reveal-delay-2 flex gap-12">
          <div>
            <span class="block font-[family-name:var(--font-heading)] text-[48px] text-white leading-none">60</span>
            <span class="text-[11px] font-semibold tracking-[0.15em] uppercase text-white/35">{t('home.access.minFromTokyo')}</span>
          </div>
          <div>
            <span class="block font-[family-name:var(--font-heading)] text-[48px] text-white leading-none">5</span>
            <span class="text-[11px] font-semibold tracking-[0.15em] uppercase text-white/35">{t('home.access.minWalk')}</span>
          </div>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <!-- Access Radius v3 — 東京60分＋ライド圏レーダー -->
        <svg viewBox="0 0 560 520" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto" aria-label="Access radius: 60 minutes from Tokyo, ride range from Kamakura">
          <defs>
            <filter id="hmGlow" x="-80%" y="-80%" width="260%" height="260%">
              <feGaussianBlur stdDeviation="4" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <radialGradient id="arSweep" gradientUnits="userSpaceOnUse" cx="230" cy="330" r="300">
              <stop offset="0" stop-color="#ffffff" stop-opacity="0.06"/>
              <stop offset="1" stop-color="#ffffff" stop-opacity="0"/>
            </radialGradient>
          </defs>

          <!-- クロスヘア + スイープ -->
          <line x1="230" y1="24" x2="230" y2="500" stroke="#fff" stroke-opacity="0.045"/>
          <line x1="16" y1="330" x2="544" y2="330" stroke="#fff" stroke-opacity="0.045"/>
          <path d="M230,330 L230,34 A296,296 0 0 1 378,78 Z" fill="url(#arSweep)" opacity="0.6">
            <animateTransform attributeName="transform" type="rotate" from="0 230 330" to="360 230 330" dur="18s" repeatCount="indefinite"/>
          </path>

          <!-- レンジリング -->
          <circle cx="230" cy="330" r="100" fill="none" stroke="#fff" stroke-opacity="0.11" stroke-dasharray="3 7"/>
          <circle cx="230" cy="330" r="200" fill="none" stroke="#fff" stroke-opacity="0.07" stroke-dasharray="3 7"/>
          <g class="hm-fade hm-d2">
            <text class="hm-t hm-micro" x="322" y="374">15 MIN RIDE</text>
            <text class="hm-t hm-micro" x="413" y="417">90 MIN RIDE</text>
          </g>

          <!-- 波・湾ラベル -->
          <g class="hm-wave hm-fade hm-d2">
            <path d="M 56,432 h 44 M 68,441 h 40 M 60,450 h 32"/>
            <path d="M 150,462 h 40 M 160,471 h 34"/>
          </g>
          <text class="hm-t hm-bay" x="52" y="490">SAGAMI BAY</text>

          <!-- JR横須賀線: 鎌倉 → 東京 -->
          <path class="hm-rail" d="M230,330 C 280,255 340,160 430,80"/>
          <path class="hm-rail-dash" d="M230,330 C 280,255 340,160 430,80"/>

          <!-- 60 MIN カプセル -->
          <g class="hm-cap">
            <g transform="translate(330,205)">
              <rect x="-40" y="-14" width="80" height="28" rx="14" fill="var(--color-brand)"/>
              <text class="hm-t hm-cap-t" x="0" y="4.5" text-anchor="middle">60 MIN</text>
            </g>
          </g>

          <!-- TOKYO / YOKOHAMA -->
          <g class="hm-fade hm-d2">
            <circle cx="430" cy="80" r="6.5" fill="none" stroke="white" stroke-opacity="0.85" stroke-width="1.8"/>
            <circle cx="430" cy="80" r="2.3" fill="white" fill-opacity="0.9"/>
            <text class="hm-t hm-city" x="446" y="76">TOKYO</text>
            <text class="hm-t hm-small" x="446" y="94">JR DIRECT — 60 MIN</text>
            <circle cx="355" cy="190" r="3.5" fill="white" fill-opacity="0.5"/>
            <text class="hm-t hm-small" x="369" y="194">YOKOHAMA</text>
          </g>

          <!-- ライド圏スポーク: 江ノ島(白) / 箱根(赤) -->
          <g class="hm-fade hm-d3">
            <line x1="230" y1="330" x2="140" y2="355" stroke="white" stroke-opacity="0.16" stroke-width="1.5"/>
            <circle cx="140" cy="355" r="3.5" fill="white" fill-opacity="0.55"/>
            <text class="hm-t hm-small" x="128" y="351" text-anchor="end">ENOSHIMA</text>
            <text class="hm-t hm-micro" x="128" y="367" text-anchor="end">15 MIN RIDE</text>
          </g>
          <path class="hm-134" d="M230,330 L52,398"/>
          <g class="hm-fade hm-d3">
            <path d="M 36,384 l 8,-11 6,7 5,-9 8,13" fill="none" stroke="white" stroke-opacity="0.3" stroke-width="1.4"/>
            <circle cx="52" cy="398" r="4" fill="var(--color-brand)" filter="url(#hmGlow)"/>
            <text class="hm-t hm-small" x="62" y="422" text-anchor="middle">HAKONE</text>
            <text class="hm-t hm-micro" x="62" y="438" text-anchor="middle">90 MIN RIDE</text>
            <path d="M 44,196 Q 68,164 70,164 Q 72,164 96,196" fill="none" stroke="white" stroke-opacity="0.2" stroke-width="1.4"/>
            <text class="hm-t hm-micro" x="70" y="212" text-anchor="middle">MT. FUJI — 2 HRS</text>
          </g>

          <!-- ハブ: KAMAKURA -->
          <g filter="url(#hmGlow)">
            <circle cx="230" cy="330" r="6" fill="var(--color-brand)"/>
          </g>
          <circle cx="230" cy="330" r="12" fill="none" stroke="var(--color-brand)" stroke-opacity="0.55" stroke-width="1.5"/>
          <circle cx="230" cy="330" r="18" fill="none" stroke="var(--color-brand)" stroke-width="1.2" opacity="0.3">
            <animate attributeName="r" from="14" to="34" dur="2.6s" repeatCount="indefinite"/>
            <animate attributeName="opacity" from="0.35" to="0" dur="2.6s" repeatCount="indefinite"/>
          </circle>
          <text class="hm-t hm-kamakura" x="230" y="382" text-anchor="middle">KAMAKURA</text>

          <!-- 凡例・コンパス -->
          <g class="hm-fade hm-d4">
            <line x1="26" y1="514" x2="46" y2="514" stroke="var(--color-brand)" stroke-width="2.5" stroke-linecap="round" stroke-opacity="0.8"/>
            <text class="hm-t hm-legend" x="52" y="517">CHOPPER RANGE</text>
            <line x1="180" y1="514" x2="200" y2="514" stroke="white" stroke-opacity="0.7" stroke-width="2.5"/>
            <line x1="180" y1="514" x2="200" y2="514" stroke="#2D0A0A" stroke-width="2.5" stroke-dasharray="3 5"/>
            <text class="hm-t hm-legend" x="206" y="517">JR LINE — 60 MIN FROM TOKYO</text>
            <g transform="translate(532,466)">
              <circle r="11" fill="none" stroke="white" stroke-opacity="0.18"/>
              <path d="M 0,-7 L 2.6,3 L 0,1.4 L -2.6,3 Z" fill="var(--color-brand)" fill-opacity="0.8"/>
              <text class="hm-t hm-micro" y="-16" text-anchor="middle">N</text>
            </g>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <!-- Section 4: Highlights -->
  <section class="py-16 px-10 bg-deep-red">
    <div class="max-w-[1200px] mx-auto">
      <div class="text-center mb-12 reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">{t('home.choose.label')}</p>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(28px,3.5vw,48px)] text-white leading-tight">{t('home.choose.heading')}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <a href={localePath('/ebike', lang)} class="group relative aspect-[4/3] md:aspect-[3/2] rounded-2xl overflow-hidden cursor-pointer reveal reveal-delay-1">
          <div class="absolute inset-0 transition-transform duration-500 group-hover:scale-105">
            <img src="/assets/ebike/ebike0035.webp" alt="E-BIKE" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-8 z-[2]">
            <span class="inline-block px-3 py-1 rounded-full bg-ebike text-[10px] font-bold tracking-[0.15em] uppercase text-white mb-3">{t('home.choose.ebike.heading')}</span>
            <h3 class="font-[family-name:var(--font-heading)] text-[clamp(20px,2.5vw,32px)] text-white leading-tight mb-2">No License.<br>Just Ride.</h3>
            <p class="text-sm text-white/60 max-w-[320px]">{t('home.choose.ebike.sub')}</p>
          </div>
        </a>
        <a href={localePath('/chopper', lang)} class="group relative aspect-[4/3] md:aspect-[3/2] rounded-2xl overflow-hidden cursor-pointer reveal reveal-delay-2">
          <div class="absolute inset-0 transition-transform duration-500 group-hover:scale-105">
            <img src="/assets/chopper/promo/R0006459.webp" alt="CHOPPER" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-8 z-[2]">
            <span class="inline-block px-3 py-1 rounded-full bg-brand text-[10px] font-bold tracking-[0.15em] uppercase text-white mb-3">{t('home.choose.chopper.heading')}</span>
            <h3 class="font-[family-name:var(--font-heading)] text-[clamp(20px,2.5vw,32px)] text-white leading-tight mb-2">{t('home.choose.chopper.oneOfOne')}</h3>
            <p class="text-sm text-white/60 max-w-[320px]">{t('home.choose.chopper.sub')}</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <Reviews lang={lang} accent="brand" product="all" />

  <!-- Access Map v2 styles -->
  <style>
    .hm-coast { fill: none; stroke: #fff; stroke-opacity: 0.26; stroke-width: 1.6; }
    .hm-wave path { stroke: #fff; stroke-opacity: 0.06; stroke-width: 1; fill: none; }

    /* ROUTE 134 draw-in */
    .hm-134 {
      fill: none; stroke: var(--color-brand); stroke-width: 3; stroke-linecap: round; stroke-opacity: 0.85;
      stroke-dasharray: 700; stroke-dashoffset: 700;
      transition: stroke-dashoffset 1.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 1.1s;
    }
    .reveal.visible .hm-134 { stroke-dashoffset: 0; }

    /* JR rail draw-in + 枕木ダッシュ */
    .hm-rail {
      fill: none; stroke: #fff; stroke-opacity: 0.85; stroke-width: 3.2; stroke-linecap: round;
      stroke-dasharray: 640; stroke-dashoffset: 640;
      transition: stroke-dashoffset 1.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.35s;
    }
    .reveal.visible .hm-rail { stroke-dashoffset: 0; }
    .hm-rail-dash {
      fill: none; stroke: #2D0A0A; stroke-width: 3.2; stroke-dasharray: 4 14;
      opacity: 0; transition: opacity 0.6s ease 1.9s;
    }
    .reveal.visible .hm-rail-dash { opacity: 1; }

    /* 60 MIN capsule pop */
    .hm-cap {
      opacity: 0; transform: scale(0.7); transform-box: fill-box; transform-origin: center;
      transition: opacity 0.5s ease 1.9s, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.9s;
    }
    .reveal.visible .hm-cap { opacity: 1; transform: scale(1); }

    /* staged fade */
    .hm-fade { opacity: 0; transition: opacity 0.9s ease; }
    .reveal.visible .hm-fade { opacity: 1; }
    .reveal.visible .hm-d1 { transition-delay: 0.15s; }
    .reveal.visible .hm-d2 { transition-delay: 0.5s; }
    .reveal.visible .hm-d3 { transition-delay: 0.9s; }
    .reveal.visible .hm-d4 { transition-delay: 1.5s; }

    /* typography */
    .hm-t { font-family: var(--font-body); fill: #fff; }
    .hm-city { font-family: var(--font-heading); font-size: 14px; letter-spacing: 0.08em; fill-opacity: 0.8; }
    .hm-city2 { font-size: 11.5px; font-weight: 700; letter-spacing: 0.07em; fill-opacity: 0.5; }
    .hm-small { font-size: 10px; font-weight: 600; letter-spacing: 0.06em; fill-opacity: 0.42; }
    .hm-micro { font-size: 8.5px; font-weight: 600; letter-spacing: 0.08em; fill-opacity: 0.3; }
    .hm-134label { font-size: 10px; font-weight: 800; letter-spacing: 0.18em; fill: var(--color-brand); fill-opacity: 0.6; }
    .hm-cap-t { font-family: var(--font-heading); font-size: 13px; letter-spacing: 0.12em; }
    .hm-kamakura { font-family: var(--font-heading); font-size: 17px; letter-spacing: 0.14em; fill-opacity: 0.95; }
    .hm-bay { font-family: var(--font-heading); font-size: 15px; letter-spacing: 0.32em; fill-opacity: 0.09; }
    .hm-bay2 { font-size: 10.5px; font-weight: 700; letter-spacing: 0.3em; fill-opacity: 0.08; }
    .hm-legend { font-size: 8.5px; font-weight: 600; letter-spacing: 0.08em; fill-opacity: 0.35; }

    /* mobile: ラベル拡大（560→343px縮小時の可読性） */
    @media (max-width: 767px) {
      .hm-city { font-size: 17px; }
      .hm-city2 { font-size: 14px; }
      .hm-small { font-size: 12.5px; }
      .hm-kamakura { font-size: 21px; }
      .hm-cap-t { font-size: 15px; }
      .hm-134label { font-size: 12px; }
      .hm-legend { font-size: 10.5px; }
    }
  </style>

  <script>
    document.querySelectorAll('video[autoplay]').forEach(v => {
      (v as HTMLVideoElement).play().catch(() => {});
    });
  </script>
</BaseLayout>
