---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, localePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/index';
import TrustBar from '../../components/TrustBar.astro';
import Reviews from '../../components/Reviews.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('meta.home.title') as string} description={t('meta.home.desc') as string} activePage="home" headerLogo="chopper">

  <!-- Section 1: Split Hero -->
  <section class="flex h-screen max-lg:h-auto max-lg:min-h-0 p-1.5 gap-1.5 pt-[66px] pb-1.5 bg-deep-red max-lg:flex-col lg:p-2 lg:gap-2 lg:pt-[72px]" style="--mobile-card-h: calc((100svh - 66px - 6px) / 2);">
    <a href={localePath('/ebike', lang)} class="group relative flex-1 max-lg:h-[var(--mobile-card-h)] max-lg:flex-none rounded-[32px] overflow-hidden cursor-pointer transition-[flex] duration-600 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] hover:flex-[1.15]">
      <div class="absolute inset-0 bg-[#111] transition-transform duration-800 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-hover:scale-105">
        <video autoplay muted loop playsinline preload="metadata" poster="/assets/ebike/ebike0010.webp" class="w-full h-full object-cover">
          <source src="/assets/video/E_BIKE.mp4" type="video/mp4">
        </video>
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/10 to-black/50 group-hover:from-black/5 group-hover:to-black/40 transition-all duration-500"></div>
      <div class="absolute bottom-0 left-0 right-0 p-12 max-md:p-6 z-[2]">
        <div class="flex items-center gap-2 mb-2 max-md:mb-1">
          <div class="w-2 h-2 rounded-full bg-ebike shadow-[0_0_12px_var(--color-ebike)] animate-pulse"></div>
          <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-white/60">{t('home.hero.ebike.label')}</span>
        </div>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(36px,5vw,64px)] text-white tracking-tight leading-none mb-3">E-BIKE</h2>
        <p class="text-sm max-md:text-xs font-medium text-white/70 tracking-wide max-w-[300px] ">{t('home.hero.ebike.sub')}</p>
      </div>
      <div class="absolute bottom-12 right-10 w-14 h-14 rounded-full bg-white/10 border border-white/20 flex items-center justify-center z-[2] group-hover:bg-white/20 group-hover:translate-x-1 transition-all duration-400">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
    </a>

    <a href={localePath('/chopper', lang)} class="group relative flex-1 max-lg:h-[var(--mobile-card-h)] max-lg:flex-none rounded-[32px] overflow-hidden cursor-pointer transition-[flex] duration-600 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] hover:flex-[1.15]">
      <div class="absolute inset-0 bg-[#111] transition-transform duration-800 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-hover:scale-105">
        <video autoplay muted loop playsinline preload="metadata" poster="/assets/chopper/promo/R0006459.webp" class="w-full h-full object-cover">
          <source src="/assets/video/CHOPPER.mp4" type="video/quicktime">
          <source src="/assets/video/CHOPPER.mp4" type="video/mp4">
        </video>
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/10 to-black/50 group-hover:from-black/5 group-hover:to-black/40 transition-all duration-500"></div>
      <div class="absolute bottom-0 left-0 right-0 p-12 max-md:p-6 z-[2]">
        <div class="flex items-center gap-2 mb-2 max-md:mb-1">
          <div class="w-2 h-2 rounded-full bg-brand shadow-[0_0_12px_var(--color-brand)] animate-pulse"></div>
          <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-white/60">{t('home.hero.chopper.label')}</span>
        </div>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(36px,5vw,64px)] text-white tracking-tight leading-none mb-3">CHOPPER</h2>
        <p class="text-sm max-md:text-xs font-medium text-white/70 tracking-wide max-w-[300px] ">{t('home.hero.chopper.sub')}</p>
      </div>
      <div class="absolute bottom-12 right-10 w-14 h-14 rounded-full bg-white/10 border border-white/20 flex items-center justify-center z-[2] group-hover:bg-white/20 group-hover:translate-x-1 transition-all duration-400">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
    </a>
  </section>

  <!-- Section 2: Statement -->
  <section class="py-32 px-10 bg-deep-red text-center flex flex-col items-center justify-center min-h-[60vh]">
    <div class="reveal">
      <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-6">{t('home.statement.location')}</p>
    </div>
    <div class="reveal reveal-delay-1">
      <h2 class="font-[family-name:var(--font-accent)] text-[clamp(22px,4vw,48px)] text-white tracking-tight leading-[1.2] max-w-[900px] mb-10">
        Not Just a Rental. We Deliver<br class="md:hidden"> <em class="not-italic text-brand">Chopper Orgasm.</em>
      </h2>
    </div>
    <div class="reveal reveal-delay-2">
      <div class="w-12 h-px bg-white/15 mx-auto mb-10"></div>
    </div>
    <div class="reveal reveal-delay-3">
      <p class="text-sm text-white/60 leading-relaxed max-w-[600px]" set:html={
        (t('home.statement.body') as string).replace(/\n/g, '<br class="hidden md:block">')
      } />
    </div>
  </section>

  <TrustBar lang={lang} variant="home" />

  <!-- Section 3: Access Map -->
  <section class="py-16 px-10 bg-deep-red">
    <div class="max-w-[1200px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div>
        <div class="reveal">
          <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">{t('home.access.label')}</p>
          <h2 class="font-[family-name:var(--font-heading)] text-[clamp(28px,3.5vw,48px)] text-white leading-tight mb-2">
            60 Min From Tokyo.
          </h2>
          <span class="block font-[family-name:var(--font-heading-jp)] text-sm text-white/40 font-bold mb-6">{t('home.access.subtitle')}</span>
        </div>
        <div class="reveal reveal-delay-1">
          <p class="text-sm text-white/50 leading-relaxed mb-8">
            {t('home.access.body')}
          </p>
        </div>
        <div class="reveal reveal-delay-2 flex gap-12">
          <div>
            <span class="block font-[family-name:var(--font-heading)] text-[48px] text-white leading-none">60</span>
            <span class="text-[11px] font-semibold tracking-[0.15em] uppercase text-white/35">{t('home.access.minFromTokyo')}</span>
          </div>
          <div>
            <span class="block font-[family-name:var(--font-heading)] text-[48px] text-white leading-none">5</span>
            <span class="text-[11px] font-semibold tracking-[0.15em] uppercase text-white/35">{t('home.access.minWalk')}</span>
          </div>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <!-- Access v4 — 路線図式ダイアグラム + 実地図（土地勘は本物の地図で） -->
        <div class="flex flex-col gap-5">
          <div class="rounded-2xl border border-white/[0.08] bg-white/[0.03] px-6 py-7">
            <div class="flex items-center">
              <div class="flex flex-col items-center shrink-0">
                <span class="w-4 h-4 rounded-full border-[2.5px] border-white"></span>
                <span class="mt-2 text-[11px] font-bold tracking-[0.1em] text-white font-[family-name:var(--font-heading)]">TOKYO</span>
              </div>
              <div class="flex-1 flex flex-col items-center px-2">
                <span class="text-[8.5px] font-bold tracking-[0.15em] text-white/40 mb-1.5 whitespace-nowrap">JR YOKOSUKA LINE</span>
                <span class="w-full border-t-2 border-dashed border-white/50"></span>
                <span class="mt-1.5 px-2.5 py-0.5 rounded-full bg-brand text-white text-[10px] font-bold tracking-[0.12em]">60 MIN</span>
              </div>
              <div class="flex flex-col items-center shrink-0">
                <span class="w-4 h-4 rounded-full bg-white"></span>
                <span class="mt-2 text-[11px] font-bold tracking-[0.1em] text-white font-[family-name:var(--font-heading)]">KAMAKURA</span>
              </div>
              <div class="flex-1 flex flex-col items-center px-2 max-w-[110px]">
                <span class="text-[8.5px] font-bold tracking-[0.15em] text-white/40 mb-1.5">WALK</span>
                <span class="w-full border-t-2 border-white/50"></span>
                <span class="mt-1.5 text-[10px] font-bold tracking-[0.12em] text-white/60">4 MIN</span>
              </div>
              <div class="flex flex-col items-center shrink-0">
                <span class="relative flex w-4 h-4">
                  <span class="absolute inline-flex h-full w-full rounded-full bg-brand opacity-60 animate-ping"></span>
                  <span class="relative inline-flex rounded-full w-4 h-4 bg-brand"></span>
                </span>
                <span class="mt-2 text-[11px] font-bold tracking-[0.1em] text-brand font-[family-name:var(--font-heading)]">BASE</span>
              </div>
            </div>
            <p class="mt-5 text-[10.5px] text-white/35 font-semibold tracking-[0.08em] text-center">{lang === 'en' ? 'TOKYO STA. → KAMAKURA STA. — DIRECT, NO TRANSFERS' : '東京駅 → 鎌倉駅 直通・乗り換えなし'}</p>
          </div>
          <div class="rounded-2xl overflow-hidden border border-white/[0.08]">
            <iframe
              src={`https://www.google.com/maps?q=Kamakura,+Kanagawa,+Japan&z=9&output=embed&hl=${lang}`}
              width="100%"
              height="300"
              style="border:0; filter: grayscale(1) invert(0.92) contrast(0.9);"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Kamakura location"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Highlights -->
  <section class="py-16 px-10 bg-deep-red">
    <div class="max-w-[1200px] mx-auto">
      <div class="text-center mb-12 reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">{t('home.choose.label')}</p>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(28px,3.5vw,48px)] text-white leading-tight">{t('home.choose.heading')}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <a href={localePath('/ebike', lang)} class="group relative aspect-[4/3] md:aspect-[3/2] rounded-2xl overflow-hidden cursor-pointer reveal reveal-delay-1">
          <div class="absolute inset-0 transition-transform duration-500 group-hover:scale-105">
            <img src="/assets/ebike/ebike0035.webp" alt="E-BIKE" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-8 z-[2]">
            <span class="inline-block px-3 py-1 rounded-full bg-ebike text-[10px] font-bold tracking-[0.15em] uppercase text-white mb-3">{t('home.choose.ebike.heading')}</span>
            <h3 class="font-[family-name:var(--font-heading)] text-[clamp(20px,2.5vw,32px)] text-white leading-tight mb-2">No License.<br>Just Ride.</h3>
            <p class="text-sm text-white/60 max-w-[320px]">{t('home.choose.ebike.sub')}</p>
          </div>
        </a>
        <a href={localePath('/chopper', lang)} class="group relative aspect-[4/3] md:aspect-[3/2] rounded-2xl overflow-hidden cursor-pointer reveal reveal-delay-2">
          <div class="absolute inset-0 transition-transform duration-500 group-hover:scale-105">
            <img src="/assets/chopper/promo/R0006459.webp" alt="CHOPPER" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-8 z-[2]">
            <span class="inline-block px-3 py-1 rounded-full bg-brand text-[10px] font-bold tracking-[0.15em] uppercase text-white mb-3">{t('home.choose.chopper.heading')}</span>
            <h3 class="font-[family-name:var(--font-heading)] text-[clamp(20px,2.5vw,32px)] text-white leading-tight mb-2">{t('home.choose.chopper.oneOfOne')}</h3>
            <p class="text-sm text-white/60 max-w-[320px]">{t('home.choose.chopper.sub')}</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <Reviews lang={lang} accent="brand" product="all" />



  <script>
    document.querySelectorAll('video[autoplay]').forEach(v => {
      (v as HTMLVideoElement).play().catch(() => {});
    });
  </script>
</BaseLayout>
