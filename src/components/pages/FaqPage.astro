---
/**
 * FAQ v2 — CHOPPER / E-BIKE タブ式（TAKE指示 2026-07-06）
 * 参考にした型: 大手ツアー/レンタル系（GetYourGuide, Klook, 国内レンタルバイク）の
 * 「カテゴリタブ → 最重要4項目のクイックファクト → アコーディオン」構成。
 * 免許まわりを各タブの先頭に固定。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdpChecker from '../../components/IdpChecker.astro';
import { getLangFromUrl, localePath } from '../../i18n/config';
import { t } from '../../i18n/index';

const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';

const chopperKeys = ['license', 'alcohol', 'weather', 'checkin', 'equipment', 'clothing', 'fuel', 'toll', 'insurance', 'tandem', 'luggage', 'extension', 'cancel'] as const;
const ebikeKeys = ['license', 'helmet', 'tandem', 'alcohol', 'weather', 'checkin', 'insurance', 'luggage', 'extension', 'cancel'] as const;

const chopperFaq = chopperKeys.map(k => ({
  title: t(lang, `chopper.faq.${k}.title` as any) as string,
  content: t(lang, `chopper.faq.${k}.content` as any) as string,
}));
const ebikeFaq = ebikeKeys.map(k => ({
  title: t(lang, `ebike.faq.${k}.title` as any) as string,
  content: t(lang, `ebike.faq.${k}.content` as any) as string,
}));

const chopperFacts = en
  ? [['LICENSE', 'Large motorcycle license + IDP (Category A)'], ['CANCEL', 'Free until 5 days before'], ['INSURANCE', 'Liability insurance included'], ['FUEL', 'Return with a full tank (high-octane / YELLOW nozzle)']]
  : [['免許', '大型二輪免許＋IDP（Category A）必須'], ['キャンセル', '5日前まで無料'], ['保険', '対人・対物保険込み'], ['ガソリン', '満タン返し（ハイオク、イエロー）']];
const ebikeFacts = en
  ? [['LICENSE', 'No license required'], ['HELMET', 'Optional — free rental, recommended'], ['AGE', '16 or older only'], ['TANDEM', 'One rider per bike — no passengers']]
  : [['免許', '不要'], ['ヘルメット', '任意（無料貸出・着用推奨）'], ['年齢', '16歳以上'], ['二人乗り', '不可（1台1名）']];

const metaTitle = en ? 'FAQ — Chopper & E-Bike Rental｜BEETLE RIDER Kamakura' : 'よくある質問（FAQ）｜BEETLE RIDER 鎌倉';
const metaDesc = en
  ? 'Everything you need to know before riding in Kamakura: license & IDP rules, helmet and age rules for e-bikes, cancellation, insurance, weather and more.'
  : '鎌倉でのライド前に知っておきたいこと。チョッパーの免許・IDP、E-BIKEの免許不要・年齢・ヘルメット、キャンセル、保険、雨天対応まで。';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [...chopperFaq, ...ebikeFaq].map(f => ({
    '@type': 'Question',
    name: f.title,
    acceptedAnswer: { '@type': 'Answer', text: f.content.replace(/<[^>]+>/g, '') },
  })),
};
---

<BaseLayout title={metaTitle} description={metaDesc} activePage="faq" headerLogo="chopper" schema={[faqSchema]}>
  <section class="pt-36 pb-8 px-6 md:px-10 bg-deep-red text-center">
    <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">BEFORE YOU RIDE</p>
    <h1 class="font-[family-name:var(--font-heading)] text-[clamp(32px,5vw,60px)] text-white tracking-tight">FAQ</h1>
  </section>

  <!-- タブ -->
  <section class="pb-8 px-6 md:px-10 bg-deep-red">
    <div class="max-w-[800px] mx-auto flex justify-center gap-3">
      <button id="tabChopper" data-tab="chopper" class="faq-tab px-8 py-3.5 rounded-full text-[12px] font-bold tracking-[0.18em] uppercase cursor-pointer border transition-all bg-brand border-brand text-white">CHOPPER</button>
      <button id="tabEbike" data-tab="ebike" class="faq-tab px-8 py-3.5 rounded-full text-[12px] font-bold tracking-[0.18em] uppercase cursor-pointer border transition-all bg-white/[0.06] border-white/15 text-white/60 hover:text-white">E-BIKE</button>
    </div>
  </section>

  <section class="pb-24 px-6 md:px-10 bg-deep-red">
    <div class="max-w-[800px] mx-auto">

      <!-- CHOPPER panel -->
      <div id="panelChopper" data-panel="chopper">
        <div class="grid grid-cols-2 gap-3 mb-8">
          {chopperFacts.map(([k, v]) => (
            <div class="rounded-xl border border-white/[0.08] bg-white/[0.03] px-5 py-4">
              <p class="text-[9.5px] font-bold tracking-[0.2em] uppercase text-brand mb-1.5">{k}</p>
              <p class="text-[12.5px] font-semibold text-white/80 leading-snug">{v}</p>
            </div>
          ))}
        </div>
        <div class="mb-10">
          <IdpChecker lang={lang} />
        </div>
        <div class="flex flex-col" data-faq-group>
          {chopperFaq.map((item, i) => (
            <div class:list={['border-b border-white/10 overflow-hidden', i === 0 && 'border-t border-white/10']} data-faq-item>
              <button class="w-full py-5 flex items-center justify-between gap-4 bg-transparent border-none cursor-pointer text-left font-[family-name:var(--font-heading-jp)] text-[15px] max-md:text-sm font-bold text-white tracking-[0.02em] transition-colors duration-300 hover:text-brand" data-faq-trigger>
                <span>{item.title}</span>
                <div class="shrink-0 w-6 h-6 flex items-center justify-center transition-transform duration-300" data-faq-icon>
                  <svg class="w-4 h-4 text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </div>
              </button>
              <div class="max-h-0 overflow-hidden transition-[max-height] duration-400 ease-[cubic-bezier(0.25,0.46,0.45,0.94)]" data-faq-body>
                <div class="pb-5 font-[family-name:var(--font-heading-jp)] text-sm text-white/50 leading-[1.9]" set:html={item.content}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- E-BIKE panel -->
      <div id="panelEbike" data-panel="ebike" class="hidden">
        <div class="grid grid-cols-2 gap-3 mb-8">
          {ebikeFacts.map(([k, v]) => (
            <div class="rounded-xl border border-white/[0.08] bg-white/[0.03] px-5 py-4">
              <p class="text-[9.5px] font-bold tracking-[0.2em] uppercase text-ebike mb-1.5">{k}</p>
              <p class="text-[12.5px] font-semibold text-white/80 leading-snug">{v}</p>
            </div>
          ))}
        </div>
        <a href={localePath('/ebike-rules', lang)} class="flex items-center justify-between gap-4 rounded-xl border border-ebike/40 bg-ebike/[0.08] px-6 py-4 mb-10 hover:bg-ebike/[0.15] transition-colors group">
          <div>
            <p class="text-[9.5px] font-bold tracking-[0.2em] uppercase text-ebike mb-1">RIDE RULES</p>
            <p class="text-[13.5px] font-bold text-white">{en ? 'E-Bike riding rules — the 3-minute read' : 'E-BIKEの交通ルールまとめ（3分で読めます）'}</p>
          </div>
          <svg class="w-4 h-4 text-white/50 group-hover:translate-x-1 transition-transform shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <div class="flex flex-col" data-faq-group>
          {ebikeFaq.map((item, i) => (
            <div class:list={['border-b border-white/10 overflow-hidden', i === 0 && 'border-t border-white/10']} data-faq-item>
              <button class="w-full py-5 flex items-center justify-between gap-4 bg-transparent border-none cursor-pointer text-left font-[family-name:var(--font-heading-jp)] text-[15px] max-md:text-sm font-bold text-white tracking-[0.02em] transition-colors duration-300 hover:text-ebike" data-faq-trigger>
                <span>{item.title}</span>
                <div class="shrink-0 w-6 h-6 flex items-center justify-center transition-transform duration-300" data-faq-icon>
                  <svg class="w-4 h-4 text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </div>
              </button>
              <div class="max-h-0 overflow-hidden transition-[max-height] duration-400 ease-[cubic-bezier(0.25,0.46,0.45,0.94)]" data-faq-body>
                <div class="pb-5 font-[family-name:var(--font-heading-jp)] text-sm text-white/50 leading-[1.9]" set:html={item.content}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <p class="text-center text-[13px] text-white/40 mt-12">
        {en ? 'Still have a question? ' : 'ほかに聞きたいことがあれば '}
        <a href="https://ig.me/m/beetlerider_japan" target="_blank" rel="noopener" class="text-white/70 underline hover:text-white transition-colors">
          {en ? 'DM us on Instagram' : 'InstagramでDM'}
        </a>
      </p>
    </div>
  </section>

  <style>
    [data-faq-item].active [data-faq-icon] { transform: rotate(45deg); }
    [data-faq-item].active [data-faq-body] { max-height: 640px; }
  </style>

  <script>
    // タブ切替（#ebike で直接E-BIKEタブを開ける）
    const tabs = document.querySelectorAll('.faq-tab');
    function activate(name: string) {
      document.querySelectorAll('[data-panel]').forEach((p) => p.classList.toggle('hidden', p.getAttribute('data-panel') !== name));
      tabs.forEach((b) => {
        const on = b.getAttribute('data-tab') === name;
        const isEbike = b.getAttribute('data-tab') === 'ebike';
        b.className = 'faq-tab px-8 py-3.5 rounded-full text-[12px] font-bold tracking-[0.18em] uppercase cursor-pointer border transition-all ' +
          (on
            ? (isEbike ? 'bg-ebike border-ebike text-white' : 'bg-brand border-brand text-white')
            : 'bg-white/[0.06] border-white/15 text-white/60 hover:text-white');
      });
    }
    tabs.forEach((b) => b.addEventListener('click', () => activate(b.getAttribute('data-tab') || 'chopper')));
    if (location.hash === '#ebike') activate('ebike');

    // アコーディオン（パネル内で1つだけ開く）
    document.querySelectorAll('[data-faq-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('[data-faq-item]');
        const group = trigger.closest('[data-faq-group]');
        if (!item || !group) return;
        const wasActive = item.classList.contains('active');
        group.querySelectorAll('[data-faq-item]').forEach((el) => el.classList.remove('active'));
        if (!wasActive) item.classList.add('active');
      });
    });
  </script>
</BaseLayout>
