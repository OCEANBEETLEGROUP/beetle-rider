---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookNowButton from '../../components/BookNowButton.astro';
import { EBIKE_WIDGETS } from '../../lib/bokun';
import { getDestinations } from '../../lib/microcms';
import { getLangFromUrl } from '../../i18n/config';
import { t } from '../../i18n/index';

const lang = getLangFromUrl(Astro.url);

const { contents: destinationsRaw } = await getDestinations('ebike');

const fallbackDestinations = [
  {
    img: '/assets/route/KAMAKURA_HACHIMANGU1.webp',
    name: 'SHRINE',
    descJp: '鶴岡八幡宮 — 鎌倉の象徴を参拝する',
    descEn: 'Tsurugaoka Hachimangu — The iconic shrine of Kamakura',
    time: '~5 min',
    detailJp: '<strong>鶴岡八幡宮</strong><br>鎌倉幕府の守護神。境内の石段や源平池など見どころ多数。小町通りを抜けてすぐ。E-BIKEは鳥居前の駐輪場へ。',
    detailEn: '<strong>Tsurugaoka Hachimangu</strong><br>Guardian deity of the Kamakura Shogunate. Stone steps, Genpei Pond, and more. Just past Komachi Street. Park your E-BIKE at the torii gate.',
  },
  {
    img: '/assets/route/KAMAKURA_BIG BUDA1.webp',
    name: 'BIG BUDDHA',
    descJp: '鎌倉大仏 — 国宝の青銅仏を間近で',
    descEn: 'Great Buddha — See the national treasure up close',
    time: '~15 min',
    detailJp: '<strong>鎌倉大仏（高徳院）</strong><br>高さ約13mの国宝青銅阿弥陀如来像。胎内拝観も可能。長谷エリアは紫陽花の名所・長谷寺もすぐ近く。',
    detailEn: '<strong>Great Buddha (Kotoku-in)</strong><br>A 13m national treasure bronze Amida Buddha. You can enter inside. Hase area also features Hase-dera temple, famous for hydrangeas.',
  },
  {
    img: '/assets/route/ENOSHIMA2.webp',
    name: 'ENOSHIMA',
    descJp: '江ノ島 — 海沿いを走り島へ渡る',
    descEn: 'Enoshima — Ride the coast to the island',
    time: '~20 min',
    detailJp: '<strong>江ノ島</strong><br>134号線の海沿いルートは最高のE-BIKEコース。島内では展望灯台・岩屋洞窟・しらすグルメが楽しめる。',
    detailEn: '<strong>Enoshima</strong><br>The Route 134 coastal path is the ultimate E-BIKE course. On the island: observation lighthouse, sea caves, and fresh shirasu cuisine.',
  },
  {
    img: '/assets/route/KAMAKURA_BEACH1.webp',
    name: 'BEACH',
    descJp: '湘南のビーチ沿いを風を感じて走る',
    descEn: 'Feel the breeze along Shonan beaches',
    time: '~10 min',
    detailJp: '<strong>湘南ビーチ</strong><br>由比ヶ浜・材木座から稲村ヶ崎へ。海風を感じながら走るシーサイドルート。夕暮れ時は富士山のシルエットも。',
    detailEn: '<strong>Shonan Beach</strong><br>From Yuigahama and Zaimokuza to Inamuragasaki. A seaside route with ocean breeze. Catch Mt. Fuji\'s silhouette at sunset.',
  },
];

const destinations = destinationsRaw.length > 0
  ? destinationsRaw.map(d => ({
      img: d.image.url + '?w=800&q=80',
      name: d.name.toUpperCase(),
      desc: lang === 'en'
        ? `${d.name} — ${d.description?.split('.')[0] || ''}`
        : `${d.nameJp} — ${d.descriptionJp?.split('。')[0] || ''}`,
      time: d.timeFromBase || '',
      detail: lang === 'en'
        ? `<strong>${d.name}</strong><br>${d.description || ''}`
        : `<strong>${d.nameJp}</strong><br>${d.descriptionJp || ''}`,
    }))
  : fallbackDestinations.map(d => ({
      img: d.img,
      name: d.name,
      desc: lang === 'en' ? d.descEn : d.descJp,
      time: d.time,
      detail: lang === 'en' ? d.detailEn : d.detailJp,
    }));

const faqKeys = ['license', 'alcohol', 'weather', 'checkin', 'insurance', 'luggage', 'extension', 'cancel'] as const;
const faqItems = faqKeys.map(key => ({
  title: t(lang, `ebike.faq.${key}.title` as any) as string,
  content: t(lang, `ebike.faq.${key}.content` as any) as string,
}));
---

<BaseLayout title={t(lang, 'meta.ebike.title') as string} description={t(lang, 'meta.ebike.desc') as string} activePage="ebike" headerLogo="ebike">

  <!-- Section 1: Hero (Video) -->
  <section class="relative h-screen max-lg:h-[100svh] min-h-[600px] max-lg:min-h-0 flex items-end justify-start overflow-hidden">
    <!-- Hero Background -->
    <div class="absolute inset-0 bg-[#0a0a0a] z-0">
      <video autoplay muted loop playsinline preload="metadata" poster="/assets/ebike/ebike0010.webp" class="w-full h-full object-cover">
        <source src="/assets/video/E_BIKE.mp4" type="video/mp4">
      </video>
    </div>
    <!-- Gradient Overlay fading to #B42550 -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-[rgba(0,0,0,0.15)]  to-[rgba(180,37,80,0.95)] z-[1]" style="background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.15) 40%, rgba(180,37,80,0.7) 80%, rgba(180,37,80,0.95) 100%);"></div>
    <!-- Content -->
    <div class="relative z-[2] px-10 pb-32 max-w-[900px] max-md:px-6 max-md:pb-24">
      <p class="text-[11px] font-bold tracking-[0.35em] uppercase text-ebike mb-4">{t(lang, 'ebike.hero.label')}</p>
      <h1 class="font-[family-name:var(--font-heading)] text-[clamp(40px,7vw,88px)] text-white tracking-tight leading-[0.95] mb-6" set:html={(t(lang, 'ebike.hero.heading') as string).replace('\n', '<br>')} />
      <p class="font-[family-name:var(--font-heading-jp)] text-[clamp(14px,1.5vw,20px)] font-medium text-white/50 tracking-wide">{t(lang, 'ebike.hero.sub')}</p>
    </div>
    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-0 right-0 z-[2] flex flex-col items-center gap-2 text-center animate-[scrollBounce_2s_ease-in-out_infinite]">
      <span class="text-[9px] font-bold tracking-[0.25em] uppercase text-white/30">{t(lang, 'common.scroll')}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white/30">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </div>
  </section>

  <!-- Section 2: Specs -->
  <section id="specs" class="py-32 px-10 bg-ebike max-md:py-24 max-md:px-6">
    <div class="max-w-[1100px] mx-auto">
      <!-- Header -->
      <div class="text-center mb-16 reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/40 mb-4">{t(lang, 'ebike.specs.label')}</p>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(24px,3vw,40px)] text-white tracking-tight">{t(lang, 'ebike.specs.heading')}</h2>
      </div>
      <!-- Grid -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- POWER -->
        <div class="bg-light border border-black/[0.08] rounded-2xl p-6 aspect-square lg:aspect-square max-lg:aspect-auto flex flex-col overflow-hidden transition-all duration-400 hover:-translate-y-1.5 hover:shadow-[0_20px_60px_rgba(0,0,0,0.15)] reveal reveal-delay-1">
          <div class="w-10 h-10 rounded-[10px] bg-ebike/12 flex items-center justify-center mb-4 shrink-0">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-ebike">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </div>
          <h3 class="font-[family-name:var(--font-heading)] text-[clamp(13px,1.3vw,16px)] text-[#2D0A0A] tracking-wide mb-1.5">{t(lang, 'ebike.specs.power')}</h3>
          <p class="font-[family-name:var(--font-heading)] text-[clamp(15px,1.5vw,22px)] text-ebike tracking-tight mb-2 whitespace-nowrap">{t(lang, 'ebike.specs.powerVal')}</p>
          <p class="text-[clamp(11px,1.1vw,14px)] text-[#2D0A0A]/70 leading-relaxed">{t(lang, 'ebike.specs.powerDesc')}</p>
          <p class="text-[clamp(10px,1vw,13px)] text-[#2D0A0A]/50 mt-1 font-medium">{t(lang, 'ebike.specs.powerDescEn')}</p>
        </div>
        <!-- RANGE -->
        <div class="bg-light border border-black/[0.08] rounded-2xl p-6 aspect-square lg:aspect-square max-lg:aspect-auto flex flex-col overflow-hidden transition-all duration-400 hover:-translate-y-1.5 hover:shadow-[0_20px_60px_rgba(0,0,0,0.15)] reveal reveal-delay-2">
          <div class="w-10 h-10 rounded-[10px] bg-ebike/12 flex items-center justify-center mb-4 shrink-0">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-ebike">
              <rect x="1" y="6" width="18" height="12" rx="2" ry="2"/><line x1="23" y1="13" x2="23" y2="11"/><line x1="5" y1="10" x2="5" y2="14"/><line x1="9" y1="10" x2="9" y2="14"/><line x1="13" y1="10" x2="13" y2="14"/>
            </svg>
          </div>
          <h3 class="font-[family-name:var(--font-heading)] text-[clamp(13px,1.3vw,16px)] text-[#2D0A0A] tracking-wide mb-1.5">{t(lang, 'ebike.specs.range')}</h3>
          <p class="font-[family-name:var(--font-heading)] text-[clamp(15px,1.5vw,22px)] text-ebike tracking-tight mb-2 whitespace-nowrap">{t(lang, 'ebike.specs.rangeVal')}</p>
          <p class="text-[clamp(11px,1.1vw,14px)] text-[#2D0A0A]/70 leading-relaxed">{t(lang, 'ebike.specs.rangeDesc')}</p>
          <p class="text-[clamp(10px,1vw,13px)] text-[#2D0A0A]/50 mt-1 font-medium">{t(lang, 'ebike.specs.rangeDescEn')}</p>
        </div>
        <!-- STYLE -->
        <div class="bg-light border border-black/[0.08] rounded-2xl p-6 aspect-square lg:aspect-square max-lg:aspect-auto flex flex-col overflow-hidden transition-all duration-400 hover:-translate-y-1.5 hover:shadow-[0_20px_60px_rgba(0,0,0,0.15)] reveal reveal-delay-3">
          <div class="w-10 h-10 rounded-[10px] bg-ebike/12 flex items-center justify-center mb-4 shrink-0">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-ebike">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <h3 class="font-[family-name:var(--font-heading)] text-[clamp(13px,1.3vw,16px)] text-[#2D0A0A] tracking-wide mb-1.5">{t(lang, 'ebike.specs.style')}</h3>
          <p class="font-[family-name:var(--font-heading)] text-[clamp(15px,1.5vw,22px)] text-ebike tracking-tight mb-2 whitespace-nowrap">{t(lang, 'ebike.specs.styleVal')}</p>
          <p class="text-[clamp(11px,1.1vw,14px)] text-[#2D0A0A]/70 leading-relaxed">{t(lang, 'ebike.specs.styleDesc')}</p>
          <p class="text-[clamp(10px,1vw,13px)] text-[#2D0A0A]/50 mt-1 font-medium">{t(lang, 'ebike.specs.styleDescEn')}</p>
        </div>
        <!-- LICENSE -->
        <div class="bg-light border border-black/[0.08] rounded-2xl p-6 aspect-square lg:aspect-square max-lg:aspect-auto flex flex-col overflow-hidden transition-all duration-400 hover:-translate-y-1.5 hover:shadow-[0_20px_60px_rgba(0,0,0,0.15)] reveal reveal-delay-4">
          <div class="w-10 h-10 rounded-[10px] bg-ebike/12 flex items-center justify-center mb-4 shrink-0">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-ebike">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <h3 class="font-[family-name:var(--font-heading)] text-[clamp(13px,1.3vw,16px)] text-[#2D0A0A] tracking-wide mb-1.5">{t(lang, 'ebike.specs.license')}</h3>
          <p class="font-[family-name:var(--font-heading)] text-[clamp(15px,1.5vw,22px)] text-ebike tracking-tight mb-2 whitespace-nowrap">{t(lang, 'ebike.specs.licenseVal')}</p>
          <p class="text-[clamp(11px,1.1vw,14px)] text-[#2D0A0A]/70 leading-relaxed">{t(lang, 'ebike.specs.licenseDesc')}</p>
          <p class="text-[clamp(10px,1vw,13px)] text-[#2D0A0A]/50 mt-1 font-medium">{t(lang, 'ebike.specs.licenseDescEn')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Plans -->
  <section id="plans" class="py-24 px-10 bg-ebike max-md:py-24 max-md:px-6">
    <div class="max-w-[1100px] mx-auto">
      <!-- Header -->
      <div class="text-center mb-10 reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/40 mb-4">{t(lang, 'ebike.plans.label')}</p>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(24px,3vw,40px)] text-white tracking-tight">{t(lang, 'ebike.plans.heading')}</h2>
      </div>
      <!-- Grid -->
      <div class="grid grid-cols-3 gap-6 items-stretch max-md:grid-cols-1" id="planCards">
        <!-- QUICK RIDE -->
        <div class="relative bg-light border-2 border-black/[0.08] rounded-2xl p-10 h-full flex flex-col shadow-[0_1px_3px_rgba(0,0,0,0.1),0_4px_12px_rgba(0,0,0,0.05)] transition-all duration-400 hover:-translate-y-1 hover:border-4 hover:border-[#2D0A0A] reveal reveal-delay-1">
          <h3 class="font-[family-name:var(--font-heading)] text-base text-[#2D0A0A]/60 tracking-wide mb-4">{t(lang, 'ebike.plans.quick.name')}</h3>
          <p class="font-[family-name:var(--font-heading)] text-[clamp(36px,4vw,48px)] text-[#2D0A0A] tracking-tight leading-none mb-1">{t(lang, 'ebike.plans.quick.price')}</p>
          <p class="text-sm font-semibold text-[#2D0A0A]/40 tracking-wide mb-6">{t(lang, 'ebike.plans.quick.time')}</p>
          <p class="text-sm text-[#2D0A0A]/70 leading-relaxed mb-auto pb-6">{t(lang, 'ebike.plans.quick.desc')}</p>
          <button class="bokunButton ebike-cv-btn block w-full py-3.5 px-6 bg-ebike text-white text-[13px] font-bold tracking-[0.15em] uppercase text-center border-none rounded-lg cursor-pointer transition-all duration-300 hover:bg-[#8e1d40] hover:-translate-y-0.5" data-src={`https://widgets.bokun.io/online-sales/44a9a7f7-bf0a-4945-ab64-57a5d5ebbaf3/experience/${EBIKE_WIDGETS.quickRide}?partialView=1`} data-testid="widget-book-button" data-cv-plan="quick" data-cv-value="3500" disabled>BOOK NOW</button>
        </div>
        <!-- CRUISE (POPULAR) -->
        <div class="relative bg-light border-2 border-[#2D0A0A] rounded-2xl p-10 h-full flex flex-col shadow-[0_1px_3px_rgba(0,0,0,0.1),0_4px_12px_rgba(0,0,0,0.05)] transition-all duration-400 hover:-translate-y-1 hover:border-4 hover:border-[#2D0A0A] reveal reveal-delay-2">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#2D0A0A] text-ebike text-[10px] font-bold tracking-[0.2em] uppercase px-4 py-1 rounded-full">{t(lang, 'ebike.plans.cruise.badge')}</span>
          <h3 class="font-[family-name:var(--font-heading)] text-base text-[#2D0A0A]/60 tracking-wide mb-4">{t(lang, 'ebike.plans.cruise.name')}</h3>
          <p class="font-[family-name:var(--font-heading)] text-[clamp(36px,4vw,48px)] text-[#2D0A0A] tracking-tight leading-none mb-1">{t(lang, 'ebike.plans.cruise.price')}</p>
          <p class="text-sm font-semibold text-[#2D0A0A]/40 tracking-wide mb-6">{t(lang, 'ebike.plans.cruise.time')}</p>
          <p class="text-sm text-[#2D0A0A]/70 leading-relaxed mb-auto pb-6">{t(lang, 'ebike.plans.cruise.desc')}</p>
          <button class="bokunButton ebike-cv-btn block w-full py-3.5 px-6 bg-ebike text-white text-[13px] font-bold tracking-[0.15em] uppercase text-center border-none rounded-lg cursor-pointer transition-all duration-300 hover:bg-[#8e1d40] hover:-translate-y-0.5" data-src={`https://widgets.bokun.io/online-sales/44a9a7f7-bf0a-4945-ab64-57a5d5ebbaf3/experience/${EBIKE_WIDGETS.cruise}?partialView=1`} data-testid="widget-book-button" data-cv-plan="cruise" data-cv-value="5000" disabled>BOOK NOW</button>
        </div>
        <!-- ALL DAY -->
        <div class="relative bg-light border-2 border-black/[0.08] rounded-2xl p-10 h-full flex flex-col shadow-[0_1px_3px_rgba(0,0,0,0.1),0_4px_12px_rgba(0,0,0,0.05)] transition-all duration-400 hover:-translate-y-1 hover:border-4 hover:border-[#2D0A0A] reveal reveal-delay-3">
          <h3 class="font-[family-name:var(--font-heading)] text-base text-[#2D0A0A]/60 tracking-wide mb-4">{t(lang, 'ebike.plans.allday.name')}</h3>
          <p class="font-[family-name:var(--font-heading)] text-[clamp(36px,4vw,48px)] text-[#2D0A0A] tracking-tight leading-none mb-1">{t(lang, 'ebike.plans.allday.price')}</p>
          <p class="text-sm font-semibold text-[#2D0A0A]/40 tracking-wide mb-6">{t(lang, 'ebike.plans.allday.time')}</p>
          <p class="text-sm text-[#2D0A0A]/70 leading-relaxed mb-auto pb-6">{t(lang, 'ebike.plans.allday.desc')}</p>
          <button class="bokunButton ebike-cv-btn block w-full py-3.5 px-6 bg-ebike text-white text-[13px] font-bold tracking-[0.15em] uppercase text-center border-none rounded-lg cursor-pointer transition-all duration-300 hover:bg-[#8e1d40] hover:-translate-y-0.5" data-src={`https://widgets.bokun.io/online-sales/44a9a7f7-bf0a-4945-ab64-57a5d5ebbaf3/experience/${EBIKE_WIDGETS.allDay}?partialView=1`} data-testid="widget-book-button" data-cv-plan="allday" data-cv-value="7500" disabled>BOOK NOW</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Destinations -->
  <section id="destinations" class="py-32 px-10 bg-ebike max-md:py-24 max-md:px-6">
    <div class="max-w-[1200px] mx-auto">
      <!-- Header -->
      <div class="text-center mb-16 reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/40 mb-4">{t(lang, 'ebike.dest.label')}</p>
        <h2 class={`${lang === 'ja' ? 'font-[family-name:var(--font-serif-jp)]' : 'font-[family-name:var(--font-heading)]'} text-[clamp(24px,3vw,40px)] text-white tracking-tight`}>{t(lang, 'ebike.dest.heading')}</h2>
        <p class="font-[family-name:var(--font-body)] text-[clamp(14px,1.5vw,18px)] text-white/40 mt-2 font-medium tracking-wide">{t(lang, 'ebike.dest.sub')}</p>
      </div>
      <!-- Grid -->
      <div class="grid grid-cols-4 gap-5 max-lg:grid-cols-2 max-md:grid-cols-1 dest-grid">
        {destinations.map((d, i) => (
          <div class={`dest-card relative rounded-2xl overflow-hidden aspect-[3/4] max-md:aspect-video cursor-pointer reveal reveal-delay-${i + 1}`}>
            <div class="dest-card__bg absolute inset-0 bg-[#111] transition-transform duration-600 ease-[cubic-bezier(0.25,0.46,0.45,0.94)]">
              <img src={d.img} alt={d.name} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="absolute inset-0 z-[1]" style="background: linear-gradient(to top, rgba(45,10,10,0.85) 0%, rgba(45,10,10,0.1) 50%, rgba(0,0,0,0) 100%);"></div>
            <!-- Time Badge -->
            {d.time && (
              <div class="absolute top-4 right-4 z-[3] flex items-center gap-1 px-2.5 py-1.5 rounded-full bg-black/55 backdrop-blur-sm border border-white/12 text-[11px] font-semibold text-white tracking-wide">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-ebike shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {d.time}
              </div>
            )}
            <!-- Content -->
            <div class="absolute bottom-0 left-0 right-0 p-7 z-[2]">
              <h3 class="font-[family-name:var(--font-heading)] text-[clamp(20px,2.5vw,28px)] text-white tracking-wide mb-2">{d.name}</h3>
              <p class="font-[family-name:var(--font-heading-jp)] text-[13px] font-medium text-white/60 leading-relaxed line-clamp-1">{d.desc}</p>
            </div>
            <!-- Detail Panel (expand) -->
            <div class="dest-card__detail absolute bottom-0 left-0 right-0 z-[3] pt-20 px-6 pb-7 transition-all duration-400 ease-[cubic-bezier(0.25,0.46,0.45,0.94)]" style="background: linear-gradient(to top, rgba(45,10,10,0.95) 0%, rgba(45,10,10,0.85) 70%, rgba(45,10,10,0) 100%); transform: translateY(100%); opacity: 0; pointer-events: none;">
              <p class="font-[family-name:var(--font-heading-jp)] text-[13px] font-normal text-white/75 leading-[1.8]" set:html={d.detail}></p>
            </div>
            <span class="dest-card__tap-hint absolute bottom-2 left-1/2 -translate-x-1/2 z-[3] text-[9px] font-semibold tracking-[0.15em] uppercase text-white/25 transition-opacity duration-300">{t(lang, 'ebike.dest.tap')}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 5: Rules (Accordion) -->
  <section id="rules" class="py-32 px-10 bg-ebike max-md:py-24 max-md:px-6">
    <div class="max-w-[800px] mx-auto">
      <!-- Header -->
      <div class="text-center mb-16 reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/40 mb-4">{t(lang, 'ebike.faq.label')}</p>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(24px,3vw,40px)] text-white tracking-tight">{t(lang, 'ebike.faq.heading')}</h2>
      </div>
      <!-- Accordion -->
      <div class="flex flex-col reveal reveal-delay-1" id="accordion">
        {faqItems.map((item, i) => (
          <div class:list={['accordion-item overflow-hidden', i === faqItems.length - 1 ? 'border-t border-b border-white/15' : 'border-t border-white/15']}>
            <button class="accordion-trigger w-full py-5 flex items-center justify-between gap-4 bg-transparent border-none cursor-pointer text-left font-[family-name:var(--font-heading-jp)] text-[15px] font-bold text-white/85 tracking-wide transition-colors duration-300 hover:text-[#2D0A0A]">
              <span>{item.title}</span>
              <div class="accordion-icon shrink-0 w-6 h-6 flex items-center justify-center transition-transform duration-300">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white/40 transition-colors duration-300"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </div>
            </button>
            <div class="accordion-body max-h-0 overflow-hidden transition-[max-height] duration-400 ease-[cubic-bezier(0.25,0.46,0.45,0.94)]">
              <div class="pb-5 font-[family-name:var(--font-heading-jp)] text-sm font-normal text-white/70 leading-[1.9] tracking-wide" set:html={item.content}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Floating CTA -->
  <button id="floating-cta" class="fixed bottom-7 right-7 z-90 flex items-center gap-2 py-3.5 px-7 bg-ebike text-white text-[13px] font-bold tracking-[0.15em] uppercase border-none rounded-full cursor-pointer shadow-[0_8px_32px_rgba(180,37,80,0.4)] transition-colors duration-300 hover:bg-[#8e1d40] max-md:bottom-5 max-md:right-5 max-md:py-3 max-md:px-6 max-md:text-xs" onclick="(function(){var isPC=window.innerWidth>=1024;var el=document.getElementById(isPC?'plans':'planCards');if(el){var top=el.getBoundingClientRect().top+window.scrollY-(isPC?80:100);window.scrollTo({top:top,behavior:'smooth'})}})()">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
      <polyline points="18 15 12 9 6 15"/>
    </svg>
    {t(lang, 'common.bookNow')}
  </button>

  <!-- Inline Scripts: Accordion + Destination Cards -->
  <script>
    // Accordion toggle
    document.querySelectorAll('.accordion-trigger').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('.accordion-item') as HTMLElement;
        if (!item) return;
        const wasActive = item.classList.contains('active');

        // Close all
        document.querySelectorAll('.accordion-item').forEach((el) => {
          el.classList.remove('active');
          const body = el.querySelector('.accordion-body') as HTMLElement;
          if (body) body.style.maxHeight = '0';
          const icon = el.querySelector('.accordion-icon') as HTMLElement;
          if (icon) icon.style.transform = 'rotate(0deg)';
          const svg = el.querySelector('.accordion-icon svg') as SVGElement;
          if (svg) svg.style.color = 'rgba(255,255,255,0.4)';
        });

        // Toggle clicked
        if (!wasActive) {
          item.classList.add('active');
          const body = item.querySelector('.accordion-body') as HTMLElement;
          if (body) body.style.maxHeight = body.scrollHeight + 'px';
          const icon = item.querySelector('.accordion-icon') as HTMLElement;
          if (icon) icon.style.transform = 'rotate(45deg)';
          const svg = item.querySelector('.accordion-icon svg') as SVGElement;
          if (svg) svg.style.color = '#2D0A0A';
        }
      });
    });

    // Destination card expand/collapse
    document.querySelectorAll('.dest-card').forEach((card) => {
      card.addEventListener('click', () => {
        const wasExpanded = card.classList.contains('expanded');

        // Close all
        document.querySelectorAll('.dest-card').forEach((el) => {
          el.classList.remove('expanded');
          const detail = el.querySelector('.dest-card__detail') as HTMLElement;
          if (detail) {
            detail.style.transform = 'translateY(100%)';
            detail.style.opacity = '0';
            detail.style.pointerEvents = 'none';
          }
          const hint = el.querySelector('.dest-card__tap-hint') as HTMLElement;
          if (hint) hint.style.opacity = '1';
        });

        // Toggle clicked
        if (!wasExpanded) {
          card.classList.add('expanded');
          const detail = card.querySelector('.dest-card__detail') as HTMLElement;
          if (detail) {
            detail.style.transform = 'translateY(0)';
            detail.style.opacity = '1';
            detail.style.pointerEvents = 'all';
          }
          const hint = card.querySelector('.dest-card__tap-hint') as HTMLElement;
          if (hint) hint.style.opacity = '0';
        }
      });
    });

    // Destination card hover zoom
    document.querySelectorAll('.dest-card').forEach((card) => {
      const bg = card.querySelector('.dest-card__bg') as HTMLElement;
      if (!bg) return;
      card.addEventListener('mouseenter', () => { bg.style.transform = 'scale(1.08)'; });
      card.addEventListener('mouseleave', () => { bg.style.transform = 'scale(1)'; });
    });

    // Auto-play videos
    document.querySelectorAll('video[autoplay]').forEach((v) => {
      (v as HTMLVideoElement).play().catch(() => {});
    });
  </script>

  <!-- Scroll Bounce Keyframe -->
  <style>
    @keyframes scrollBounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(8px); }
    }
  </style>

  <!-- Bokun Widget Loader: lazy-loaded on first BOOK NOW interaction or scroll-into-view -->
  <script>
    (function() {
      let loaded = false;
      function loadBokun() {
        if (loaded) return;
        loaded = true;
        const s = document.createElement('script');
        s.src = 'https://widgets.bokun.io/assets/javascripts/apps/build/BokunWidgetsLoader.js?bookingChannelUUID=44a9a7f7-bf0a-4945-ab64-57a5d5ebbaf3';
        s.async = true;
        document.body.appendChild(s);
      }
      document.querySelectorAll('.bokunButton').forEach((btn) => {
        ['pointerenter', 'click', 'focus'].forEach(ev => btn.addEventListener(ev, loadBokun, { once: false, passive: true }));
      });
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          if (entries.some(e => e.isIntersecting)) {
            loadBokun();
            io.disconnect();
          }
        }, { rootMargin: '200px' });
        document.querySelectorAll('.bokunButton').forEach((btn) => io.observe(btn));
      } else {
        setTimeout(loadBokun, 3000);
      }
    })();
  </script>

  <!-- Google Ads Conversion: fire on E-BIKE BOOK NOW click (Phase 1: site click CV) -->
  <script is:inline define:vars={{
    gadsId: import.meta.env.PUBLIC_GADS_CONVERSION_ID || '',
    gadsLabel: import.meta.env.PUBLIC_GADS_BOOKNOW_LABEL || ''
  }}>
    (function() {
      if (!gadsId || !gadsLabel) {
        console.log('[GAds CV] PUBLIC_GADS_CONVERSION_ID or LABEL not set, skipping');
        return;
      }
      const sendTo = gadsId + '/' + gadsLabel;
      document.querySelectorAll('.ebike-cv-btn').forEach((btn) => {
        btn.addEventListener('click', function() {
          if (!window.gtag) {
            console.warn('[GAds CV] gtag not loaded');
            return;
          }
          const value = parseFloat(this.dataset.cvValue || '3000');
          window.gtag('event', 'conversion', {
            send_to: sendTo,
            value: value,
            currency: 'JPY',
            transaction_id: '',
          });
          console.log('[GAds CV] sent:', sendTo, 'plan=' + this.dataset.cvPlan, 'value=¥' + value);
        }, { passive: true });
      });
    })();
  </script>

</BaseLayout>
