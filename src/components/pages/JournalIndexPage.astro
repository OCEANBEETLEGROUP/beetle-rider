---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, localePath } from '../../i18n/config';

const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';

const posts = (await getCollection('journal'))
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const slugOf = (id: string) => id.replace(/-(ja|en)$/, '');
const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');

const metaTitle = en ? 'RIDE JOURNAL — Kamakura Routes & Rider Guides｜BEETLE RIDER' : 'RIDE JOURNAL — 鎌倉ルート＆ライダーガイド｜BEETLE RIDER';
const metaDesc = en
  ? 'Route guides, itineraries and rider tips for Kamakura, Enoshima and the Shonan coast — by the BEETLE RIDER crew.'
  : '鎌倉・江ノ島・湘南のルートガイド、モデルコース、ライダー向けTips。BEETLE RIDERクルーが書く実走ジャーナル。';
---

<BaseLayout title={metaTitle} description={metaDesc} activePage="journal" headerLogo="chopper">
  <section class="pt-36 pb-8 px-6 md:px-10 bg-deep-red text-center">
    <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">FROM THE GARAGE</p>
    <h1 class="font-[family-name:var(--font-heading)] text-[clamp(34px,5vw,64px)] text-white tracking-tight">RIDE JOURNAL</h1>
    <p class="text-[13px] text-white/45 mt-3 font-medium">{en ? 'Routes, guides and tips — written from the saddle.' : 'サドルの上から書いた、ルートとガイドとTips。'}</p>
  </section>

  <!-- CHOPPER / E-BIKE フィルター -->
  <section class="pb-10 px-6 md:px-10 bg-deep-red">
    <div class="flex justify-center gap-2.5">
      <button data-filter="all" class="jf-tab px-6 py-2.5 rounded-full text-[11px] font-bold tracking-[0.18em] uppercase cursor-pointer border transition-all bg-white/15 border-white/25 text-white">ALL</button>
      <button data-filter="chopper" class="jf-tab px-6 py-2.5 rounded-full text-[11px] font-bold tracking-[0.18em] uppercase cursor-pointer border transition-all bg-white/[0.06] border-white/15 text-white/60 hover:text-white">CHOPPER</button>
      <button data-filter="ebike" class="jf-tab px-6 py-2.5 rounded-full text-[11px] font-bold tracking-[0.18em] uppercase cursor-pointer border transition-all bg-white/[0.06] border-white/15 text-white/60 hover:text-white">E-BIKE</button>
    </div>
  </section>

  <section class="pb-24 px-6 md:px-10 bg-deep-red">
    <div class="max-w-[1000px] mx-auto grid grid-cols-1 md:grid-cols-3 gap-5" id="journalGrid">
      {posts.map((p, i) => (
        <a href={localePath('/journal/' + slugOf(p.id), lang)} data-product={p.data.product} class={`group rounded-2xl overflow-hidden border border-white/[0.08] bg-white/[0.03] hover:border-white/20 transition-all reveal reveal-delay-${(i % 3) + 1}`}>
          <div class="aspect-[16/10] overflow-hidden bg-[#111]">
            <img src={p.data.cover} alt={p.data.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2.5 mb-3 flex-wrap">
              <span class:list={['px-2.5 py-1 rounded-full text-[9px] font-bold tracking-[0.15em] uppercase', p.data.product === 'ebike' ? 'bg-ebike/20 text-ebike' : 'bg-brand/15 text-brand']}>
                {p.data.product === 'ebike' ? 'E-BIKE' : p.data.product === 'chopper' ? 'CHOPPER' : 'ALL RIDERS'}
              </span>
              <span class="px-2.5 py-1 rounded-full bg-white/[0.06] text-white/45 text-[9px] font-bold tracking-[0.15em] uppercase">{p.data.category}</span>
              <span class="text-[10px] font-semibold text-white/30 tracking-wider">{fmt(p.data.date)}</span>
            </div>
            <h2 class="font-[family-name:var(--font-heading)] text-[17px] text-white leading-snug mb-2 group-hover:text-white/80 transition-colors">{p.data.title}</h2>
            <p class="text-[12.5px] text-white/45 leading-[1.8] line-clamp-3">{p.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script>
    const tabs = document.querySelectorAll('.jf-tab');
    tabs.forEach((b) => b.addEventListener('click', () => {
      const f = b.getAttribute('data-filter');
      tabs.forEach((x) => {
        const on = x === b;
        x.className = 'jf-tab px-6 py-2.5 rounded-full text-[11px] font-bold tracking-[0.18em] uppercase cursor-pointer border transition-all ' +
          (on ? 'bg-white/15 border-white/25 text-white' : 'bg-white/[0.06] border-white/15 text-white/60 hover:text-white');
      });
      document.querySelectorAll('#journalGrid [data-product]').forEach((card) => {
        const p = card.getAttribute('data-product');
        (card as HTMLElement).style.display = (f === 'all' || p === f || p === 'both') ? '' : 'none';
      });
    }));
  </script>
</BaseLayout>
