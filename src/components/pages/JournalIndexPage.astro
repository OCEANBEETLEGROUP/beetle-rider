---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, localePath } from '../../i18n/config';

const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';

const posts = (await getCollection('journal'))
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const slugOf = (id: string) => id.replace(/-(ja|en)$/, '');
const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');

const metaTitle = en ? 'RIDE JOURNAL — Kamakura Routes & Rider Guides｜BEETLE RIDER' : 'RIDE JOURNAL — 鎌倉ルート＆ライダーガイド｜BEETLE RIDER';
const metaDesc = en
  ? 'Route guides, itineraries and rider tips for Kamakura, Enoshima and the Shonan coast — by the BEETLE RIDER crew.'
  : '鎌倉・江ノ島・湘南のルートガイド、モデルコース、ライダー向けTips。BEETLE RIDERクルーが書く実走ジャーナル。';
---

<BaseLayout title={metaTitle} description={metaDesc} activePage="journal" headerLogo="chopper">
  <section class="pt-36 pb-12 px-6 md:px-10 bg-deep-red text-center">
    <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">FROM THE GARAGE</p>
    <h1 class="font-[family-name:var(--font-heading)] text-[clamp(34px,5vw,64px)] text-white tracking-tight">RIDE JOURNAL</h1>
    <p class="text-[13px] text-white/45 mt-3 font-medium">{en ? 'Routes, guides and tips — written from the saddle.' : 'サドルの上から書いた、ルートとガイドとTips。'}</p>
  </section>

  <section class="pb-24 px-6 md:px-10 bg-deep-red">
    <div class="max-w-[1000px] mx-auto grid grid-cols-1 md:grid-cols-3 gap-5">
      {posts.map((p, i) => (
        <a href={localePath('/journal/' + slugOf(p.id), lang)} class={`group rounded-2xl overflow-hidden border border-white/[0.08] bg-white/[0.03] hover:border-white/20 transition-all reveal reveal-delay-${(i % 3) + 1}`}>
          <div class="aspect-[16/10] overflow-hidden bg-[#111]">
            <img src={p.data.cover} alt={p.data.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
          </div>
          <div class="p-6">
            <div class="flex items-center gap-3 mb-3">
              <span class="px-2.5 py-1 rounded-full bg-brand/15 text-brand text-[9px] font-bold tracking-[0.15em] uppercase">{p.data.category}</span>
              <span class="text-[10px] font-semibold text-white/30 tracking-wider">{fmt(p.data.date)}</span>
            </div>
            <h2 class="font-[family-name:var(--font-heading)] text-[17px] text-white leading-snug mb-2 group-hover:text-white/80 transition-colors">{p.data.title}</h2>
            <p class="text-[12.5px] text-white/45 leading-[1.8] line-clamp-3">{p.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
