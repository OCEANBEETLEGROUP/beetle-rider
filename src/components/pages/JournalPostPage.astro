---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { localePath } from '../../i18n/config';

interface Props {
  entry: CollectionEntry<'journal'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const lang = entry.data.lang;
const en = lang === 'en';
const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  image: `https://beetlerider.com${entry.data.cover}`,
  author: { '@type': 'Organization', name: 'BEETLE RIDER' },
  publisher: { '@id': 'https://beetlerider.com/#organization' },
};
---

<BaseLayout title={`${entry.data.title}｜BEETLE RIDER JOURNAL`} description={entry.data.description} activePage="journal" headerLogo="chopper" schema={[articleLd]}>
  <article>
    <!-- Cover -->
    <section class="relative h-[52vh] min-h-[380px] flex items-end overflow-hidden">
      <div class="absolute inset-0 bg-[#111]">
        <img src={entry.data.cover} alt={entry.data.title} class="w-full h-full object-cover" loading="eager" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/35 to-[rgba(45,10,10,0.97)]"></div>
      <div class="relative z-[2] px-6 md:px-10 pb-12 max-w-[760px] mx-auto w-full">
        <div class="flex items-center gap-3 mb-4">
          <span class="px-2.5 py-1 rounded-full bg-brand text-white text-[9px] font-bold tracking-[0.15em] uppercase">{entry.data.category}</span>
          <span class="text-[11px] font-semibold text-white/40 tracking-wider">{fmt(entry.data.date)}</span>
        </div>
        <h1 class="font-[family-name:var(--font-heading)] text-[clamp(26px,4.5vw,48px)] text-white tracking-tight leading-[1.1]">{entry.data.title}</h1>
      </div>
    </section>

    <!-- Body -->
    <section class="py-14 px-6 md:px-10 bg-deep-red">
      <div class="post-body max-w-[720px] mx-auto">
        <Content />
      </div>

      <!-- CTA -->
      <div class="max-w-[720px] mx-auto mt-14 grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href={localePath('/chopper', lang)} class="group rounded-2xl border border-white/10 bg-white/[0.03] p-6 hover:border-brand/50 transition-all">
          <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-brand mb-2">CHOPPER</p>
          <p class="font-[family-name:var(--font-heading)] text-lg text-white">{en ? 'Ride these roads →' : 'このルートを走る →'}</p>
        </a>
        <a href={localePath('/ebike', lang)} class="group rounded-2xl border border-white/10 bg-white/[0.03] p-6 hover:border-ebike/60 transition-all">
          <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-ebike mb-2">E-BIKE — NO LICENSE</p>
          <p class="font-[family-name:var(--font-heading)] text-lg text-white">{en ? 'Explore Kamakura →' : '鎌倉を巡る →'}</p>
        </a>
      </div>

      <div class="max-w-[720px] mx-auto mt-8 text-center">
        <a href={localePath('/journal', lang)} class="text-[11px] font-bold tracking-[0.18em] uppercase text-white/40 hover:text-white transition-colors">← RIDE JOURNAL</a>
      </div>
    </section>
  </article>

  <style is:global>
    .post-body { color: rgba(255,255,255,0.72); font-size: 15px; line-height: 2; }
    .post-body h2 { font-family: var(--font-heading); color: #fff; font-size: clamp(20px, 2.5vw, 26px); letter-spacing: -0.01em; margin: 2.2em 0 0.8em; line-height: 1.3; }
    .post-body h3 { color: #fff; font-weight: 700; font-size: 16.5px; margin: 1.8em 0 0.6em; }
    .post-body p { margin: 0 0 1.2em; }
    .post-body a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
    .post-body a:hover { color: var(--color-brand); }
    .post-body ul, .post-body ol { margin: 0 0 1.2em; padding-left: 1.4em; }
    .post-body li { margin-bottom: 0.5em; }
    .post-body strong { color: rgba(255,255,255,0.92); }
    .post-body blockquote { border-left: 3px solid var(--color-brand); padding-left: 1.2em; margin: 1.6em 0; color: rgba(255,255,255,0.55); }
    .post-body hr { border: none; border-top: 1px solid rgba(255,255,255,0.1); margin: 2.4em 0; }
  </style>
</BaseLayout>
