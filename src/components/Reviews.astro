---
/**
 * Reviews — Google実レビューセクション（データ: src/data/reviews.ts）
 */
import type { Lang } from '../i18n/config';
import { REVIEWS, GOOGLE_RATING, GOOGLE_REVIEW_COUNT, GOOGLE_MAPS_URL, REVIEWS_ARE_REAL } from '../data/reviews';

interface Props {
  lang: Lang;
  accent?: 'brand' | 'ebike' | 'dark';
}
const { lang, accent = 'brand' } = Astro.props;
const en = lang === 'en';
const starColor = accent === 'ebike' ? 'text-ebike' : accent === 'dark' ? 'text-[#2D0A0A]' : 'text-brand';
const hoverBtn =
  accent === 'ebike' ? 'hover:bg-ebike hover:border-ebike'
  : accent === 'dark' ? 'hover:bg-[#2D0A0A] hover:border-[#2D0A0A]'
  : 'hover:bg-brand hover:border-brand';
---

<section class="py-24 px-6 md:px-10" id="reviews">
  <div class="max-w-[1100px] mx-auto">
    <div class="text-center mb-12 reveal">
      <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">RIDER REVIEWS</p>
      <h2 class="font-[family-name:var(--font-heading)] text-[clamp(26px,3.5vw,44px)] text-white tracking-[-0.01em]">
        {GOOGLE_RATING.toFixed(1)} <span class={starColor}>★</span> on Google.
      </h2>
      <p class="text-[13px] text-white/40 mt-2 font-medium">
        {en ? `${GOOGLE_REVIEW_COUNT} reviews from riders around the world` : `世界中のライダーから ${GOOGLE_REVIEW_COUNT} 件のレビュー`}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 reveal reveal-delay-1">
      {REVIEWS.map((r) => (
        <figure class="flex flex-col rounded-2xl border border-white/[0.08] bg-white/[0.03] p-7">
          <div class={`${starColor} text-[13px] tracking-[0.2em] mb-4`} aria-label={`${r.rating} stars`}>
            {'★'.repeat(r.rating)}
          </div>
          <blockquote class="text-[13.5px] leading-[1.85] text-white/70 font-medium flex-1">
            “{r.text}”
          </blockquote>
          <figcaption class="mt-5 flex items-center justify-between">
            <span class="text-[12px] font-bold text-white/80 tracking-wide">{r.author}</span>
            <span class="text-[9.5px] font-semibold tracking-[0.15em] uppercase text-white/30">{r.source} Review</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="text-center mt-10 reveal reveal-delay-2">
      <a href={GOOGLE_MAPS_URL} target="_blank" rel="noopener" class={`inline-flex items-center gap-2 px-7 py-3 rounded-full border border-white/15 bg-white/[0.05] text-[11px] font-bold tracking-[0.18em] uppercase text-white/80 ${hoverBtn} hover:text-white transition-all`}>
        {en ? `Read all ${GOOGLE_REVIEW_COUNT} reviews` : `レビュー${GOOGLE_REVIEW_COUNT}件をすべて見る`}
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      {!REVIEWS_ARE_REAL && (
        <p class="mt-3 text-[10px] tracking-widest uppercase text-yellow-500/70">SAMPLE DATA — 公開前に実レビューへ差し替え</p>
      )}
    </div>
  </div>
</section>
