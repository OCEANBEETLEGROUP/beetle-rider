---
/**
 * CountriesBar — 実顧客の出身国バナー（国旗マーキー＋カウントアップ・TAKE指示 2026-07-10改）
 * - 数字は国数のみ（人数は出さない）。「現在、」＋パルスドットでリアルタイムな数字感を演出。
 * - 配置は顧客動線で決定: ホーム=ヒーロー直下（着地直後にグローバル実績を提示）／
 *   チョッパー・E-BIKE=Reviewsの直前（レビューと並ぶ社会的証明クラスタ）。TrustBarとは並べない。
 * - 国旗はSVG自己ホスト（/assets/flags/、flag-icons MIT）— 絵文字はWindowsで描画されないため不使用。
 * - ホーム/E-BIKE = 27の国と地域（TAKE提供リスト）。チョッパー = 貸渡簿統合DBの住所+電話国番号から
 *   算出（2026-07-10時点: 10カ国）。数字更新時は貸渡簿を再集計して count / codes を差し替える。
 */
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
  theme?: 'brand' | 'ebike';
  count: number;            // 国・地域の数
  regions?: boolean;        // true=「の国と地域」/ COUNTRIES & REGIONS 表記（グアム・台湾を含む27用）
  codes?: string[];         // 表示する国旗コード（/assets/flags/{code}.svg）
}

const NAMES: Record<string, string> = {
  us: 'USA', au: 'Australia', de: 'Germany', gu: 'Guam', gb: 'UK', fr: 'France',
  ca: 'Canada', nz: 'New Zealand', ch: 'Switzerland', be: 'Belgium', no: 'Norway',
  pl: 'Poland', cz: 'Czechia', ru: 'Russia', cl: 'Chile', ar: 'Argentina',
  tw: 'Taiwan', kr: 'South Korea', th: 'Thailand', sg: 'Singapore', my: 'Malaysia',
  ph: 'Philippines', kh: 'Cambodia', in: 'India', tr: 'Türkiye', ma: 'Morocco',
  jp: 'Japan', id: 'Indonesia', mt: 'Malta',
};

// 全社実績27（貸渡記録・TAKE提供）
const DEFAULT_CODES = ['us', 'au', 'de', 'gu', 'gb', 'fr', 'ca', 'nz', 'ch', 'be', 'no', 'pl', 'cz', 'ru', 'cl', 'ar', 'tw', 'kr', 'th', 'sg', 'my', 'ph', 'kh', 'in', 'tr', 'ma', 'jp'];

const { lang, theme = 'brand', count, regions = true, codes = DEFAULT_CODES } = Astro.props;
const en = lang === 'en';
const pink = theme === 'ebike';

const wrap = pink ? 'bg-ebike border-y border-black/[0.08]' : 'bg-white/[0.015] border-y border-white/[0.07]';
const label = pink ? 'text-white/75' : 'text-white/45';
const numCls = 'cb-num font-[family-name:var(--font-heading)] text-[19px] leading-none text-white inline-block min-w-[1.3em] text-center';
const dotCls = pink ? 'bg-white shadow-[0_0_10px_rgba(255,255,255,0.8)]' : 'bg-brand shadow-[0_0_10px_var(--color-brand)]';
---

<div class={wrap}>
  <div class="max-w-[1200px] mx-auto pl-6 py-3 flex items-center gap-6 max-md:flex-col max-md:gap-2.5 max-md:px-0 max-md:pt-3.5">
    <!-- 現在の実績カウント（パルスドット＋カウントアップでリアルタイム感） -->
    <p class:list={['shrink-0 flex items-center gap-x-2 text-[10.5px] md:text-[11px] font-bold tracking-[0.18em] uppercase whitespace-nowrap max-md:px-6', label]}>
      <span class:list={['w-1.5 h-1.5 rounded-full animate-pulse shrink-0', dotCls]} aria-hidden="true"></span>
      {en ? (
        <>RIGHT NOW — RIDERS FROM <span class={numCls} data-target={count}>0</span> {regions ? <>COUNTRIES &amp; REGIONS</> : <>COUNTRIES</>}</>
      ) : (
        <>現在、世界 <span class={numCls} data-target={count}>0</span> {regions ? 'の国と地域' : 'カ国'} からライダーが来ています</>
      )}
    </p>
    <!-- 国旗マーキー（2セット複製・ホバーで停止） -->
    <div class="cb-marquee flex-1 min-w-0 max-md:w-full">
      <div class="cb-track">
        {[0, 1].map((dup) => (
          <div class="cb-set" aria-hidden={dup === 1 ? 'true' : undefined}>
            {codes.map((code) => (
              <span class:list={['cb-chip', pink ? 'cb-chip-pink' : 'cb-chip-brand']}>
                <img src={`/assets/flags/${code}.svg`} width="18" height="14" alt={dup === 0 ? `${NAMES[code] ?? code} flag` : ''} loading="lazy" />
                <span>{NAMES[code] ?? code.toUpperCase()}</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .cb-marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .cb-track {
    display: flex;
    width: max-content;
    animation: cbScroll 50s linear infinite;
  }
  .cb-marquee:hover .cb-track { animation-play-state: paused; }
  .cb-set { display: flex; }
  .cb-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 13px;
    margin-right: 8px;
    border-radius: 999px;
    border: 1px solid;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.72);
    white-space: nowrap;
  }
  .cb-chip img { border-radius: 2px; display: block; }
  .cb-chip-brand { background: rgba(255, 255, 255, 0.045); border-color: rgba(255, 255, 255, 0.1); }
  .cb-chip-pink { background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.18); }
  @keyframes cbScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cb-track { animation: none; }
    .cb-marquee { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
  }
</style>

<script>
  // カウントアップ（視認時に0→実数、reduced-motionは即値）
  const nums = document.querySelectorAll<HTMLElement>('.cb-num');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      const el = e.target as HTMLElement;
      const target = parseInt(el.dataset.target || '0');
      if (reduce) { el.textContent = String(target); return; }
      const t0 = performance.now();
      const dur = 1200;
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / dur);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }, { threshold: 0.4 });
  nums.forEach((n) => io.observe(n));
</script>
