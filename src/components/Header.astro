---
import { localePath, alternateUrl } from '../i18n/config';
import { useTranslations } from '../i18n/index';
import type { Lang } from '../i18n/config';

interface Props {
  activePage: 'home' | 'chopper' | 'ebike' | 'about' | 'access' | 'faq' | 'touring' | 'journal';
  logo: 'chopper' | 'ebike' | 'corporate';
  lang: Lang;
}

const { activePage, logo, lang } = Astro.props;
const t = useTranslations(lang);

const logoSrc = {
  chopper: '/assets/logo/BR_CHOPPER_LOGO.svg',
  ebike: '/assets/logo/BR_EBIKE_LOGO.svg',
  corporate: '/assets/logo/OB_CORPORATE.svg',
}[logo];

// ヘッダー: E-Bike / Chopper / Others(About・Journal・Access・FAQ) — TAKE方針 2026-07-07
const navItems = [
  { href: localePath('/ebike', lang), label: t('nav.ebike'), key: 'ebike' as const },
  { href: localePath('/chopper', lang), label: t('nav.chopper'), key: 'chopper' as const },
];
const otherItems = [
  { href: localePath('/about', lang), label: t('nav.about'), key: 'about' as const },
  { href: localePath('/journal', lang), label: 'Journal', key: 'journal' as const },
  { href: localePath('/access', lang), label: t('nav.access'), key: 'access' as const },
  { href: localePath('/faq', lang), label: t('nav.faq'), key: 'faq' as const },
];
const othersActive = (['about', 'journal', 'access', 'faq'] as string[]).includes(activePage);

const altUrl = alternateUrl(Astro.url);
// Add ?lang= param to set cookie via middleware
const jpUrl = (lang === 'ja' ? Astro.url.pathname : altUrl) + '?lang=ja';
const enUrl = (lang === 'en' ? Astro.url.pathname : altUrl) + '?lang=en';
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-100 px-10 py-5 flex items-center justify-between backdrop-blur-[20px] bg-[rgba(45,10,10,0.35)] border-b border-white/[0.08] transition-all duration-400">
  <a href={localePath('/', lang)} class="flex items-center">
    <img src={logoSrc} alt="BEETLE RIDER" class="h-4" />
  </a>

  <!-- Desktop Nav (centered) -->
  <nav class="hidden md:flex gap-2 items-center absolute left-1/2 -translate-x-1/2">
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={[
          'nav-pill inline-flex items-center px-5 py-2 rounded-full text-[11px] font-semibold tracking-[0.2em] uppercase transition-all duration-300 cursor-pointer',
          activePage === item.key
            ? item.key === 'ebike'
              ? 'bg-ebike border-ebike text-white'
              : item.key === 'chopper'
                ? 'bg-brand border-brand text-white'
                : 'bg-white/15 border-white/25 text-white'
            : 'bg-white/[0.08] border border-white/10 text-white/85',
          item.key === 'ebike' && activePage !== item.key ? 'hover:bg-ebike hover:border-ebike hover:text-white' : '',
          item.key === 'chopper' && activePage !== item.key ? 'hover:bg-brand hover:border-brand hover:text-white' : '',
          item.key === 'about' && activePage !== item.key ? 'hover:bg-white/15 hover:text-white' : '',
        ]}
      >
        {item.label}
      </a>
    ))}
    <!-- Others dropdown -->
    <div class="relative group">
      <button class:list={[
        'nav-pill inline-flex items-center gap-1.5 px-5 py-2 rounded-full text-[11px] font-semibold tracking-[0.2em] uppercase transition-all duration-300 cursor-pointer border',
        othersActive ? 'bg-white/15 border-white/25 text-white' : 'bg-white/[0.08] border-white/10 text-white/85 hover:bg-white/15 hover:text-white',
      ]}>
        Others
        <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 hidden group-hover:block group-focus-within:block">
        <div class="min-w-[170px] rounded-2xl border border-white/12 bg-[rgba(28,5,7,0.95)] backdrop-blur-[16px] py-2 flex flex-col shadow-[0_16px_48px_rgba(0,0,0,0.5)]">
          {otherItems.map((item) => (
            <a href={item.href} class:list={[
              'px-5 py-2.5 text-[11px] font-semibold tracking-[0.18em] uppercase transition-colors',
              activePage === item.key ? 'text-white' : 'text-white/60 hover:text-white hover:bg-white/[0.06]',
            ]}>
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </nav>

  <!-- Language Switch (right-aligned, shown on md+) -->
  <div class="hidden md:flex gap-1 items-center">
    <a href={jpUrl} class:list={[
      'px-3 py-1.5 rounded-full text-[11px] font-semibold tracking-wider',
      lang === 'ja'
        ? 'bg-white/12 border border-white/25 text-white'
        : 'bg-transparent border border-white/15 text-white/50 hover:text-white/80 transition-colors',
    ]}>JP</a>
    <a href={enUrl} class:list={[
      'px-3 py-1.5 rounded-full text-[11px] font-semibold tracking-wider',
      lang === 'en'
        ? 'bg-white/12 border border-white/25 text-white'
        : 'bg-transparent border border-white/15 text-white/50 hover:text-white/80 transition-colors',
    ]}>EN</a>
  </div>

  <!-- Hamburger (Mobile) -->
  <button id="hamburger" class="flex md:hidden flex-col gap-[5px] cursor-pointer p-1" aria-label="Menu">
    <span class="w-6 h-0.5 bg-white rounded-sm transition-all duration-300"></span>
    <span class="w-6 h-0.5 bg-white rounded-sm transition-all duration-300"></span>
    <span class="w-6 h-0.5 bg-white rounded-sm transition-all duration-300"></span>
  </button>
</header>

<!-- Mobile Menu -->
<div id="mobile-menu" class="fixed inset-0 bg-deep-red z-[99] flex flex-col items-center justify-center gap-6 opacity-0 pointer-events-none transition-opacity duration-400">
  {navItems.map((item) => (
    <a href={item.href} class="font-[family-name:var(--font-heading)] text-[32px] text-white tracking-wide uppercase hover:opacity-60 transition-opacity">
      {item.label}
    </a>
  ))}
  <div class="w-10 h-px bg-white/15 my-1"></div>
  {otherItems.map((item) => (
    <a href={item.href} class="font-[family-name:var(--font-heading)] text-[19px] text-white/60 tracking-wide uppercase hover:text-white transition-colors">
      {item.label}
    </a>
  ))}
  <!-- Mobile Language Switch -->
  <div class="flex gap-3 mt-6">
    <a href={jpUrl} class:list={[
      'px-4 py-2 rounded-full text-[13px] font-semibold tracking-wider',
      lang === 'ja'
        ? 'bg-white/12 border border-white/25 text-white'
        : 'bg-transparent border border-white/15 text-white/50',
    ]}>JP</a>
    <a href={enUrl} class:list={[
      'px-4 py-2 rounded-full text-[13px] font-semibold tracking-wider',
      lang === 'en'
        ? 'bg-white/12 border border-white/25 text-white'
        : 'bg-transparent border border-white/15 text-white/50',
    ]}>EN</a>
  </div>
</div>

<script>
  // Header scroll effect
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (header) {
      header.style.background = window.scrollY > 50
        ? 'rgba(45, 10, 10, 0.85)'
        : 'rgba(45, 10, 10, 0.35)';
    }
  });

  // Mobile menu toggle
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  hamburger?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('opacity-100');
    if (isOpen) {
      mobileMenu?.classList.remove('opacity-100', 'pointer-events-auto');
      mobileMenu?.classList.add('opacity-0', 'pointer-events-none');
    } else {
      mobileMenu?.classList.remove('opacity-0', 'pointer-events-none');
      mobileMenu?.classList.add('opacity-100', 'pointer-events-auto');
    }
  });
</script>
