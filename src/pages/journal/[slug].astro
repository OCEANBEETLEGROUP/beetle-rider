---
import { getCollection } from 'astro:content';
import JournalPostPage from '../../components/pages/JournalPostPage.astro';

export async function getStaticPaths() {
  const posts = await getCollection('journal');
  return posts
    .filter((p) => p.data.lang === 'ja')
    .map((entry) => ({
      params: { slug: entry.id.replace(/-(ja|en)$/, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
---

<JournalPostPage entry={entry} />
