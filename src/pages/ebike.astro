---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookNowButton from '../components/BookNowButton.astro';
import { EBIKE_WIDGETS } from '../lib/bokun';
---

<BaseLayout title="E-BIKE RENTAL — BEETLE RIDER" activePage="ebike" headerLogo="ebike">

  <!-- Section 1: Hero (Video) -->
  <section class="relative h-screen min-h-[600px] flex items-end justify-start overflow-hidden">
    <!-- Video Background -->
    <div class="absolute inset-0 bg-[#0a0a0a] z-0">
      <video autoplay muted loop playsinline poster="/assets/ebike/ebike0010.jpg" class="w-full h-full object-cover">
        <source src="/assets/video/E_BIKE.MOV" type="video/quicktime">
        <source src="/assets/video/E_BIKE.MOV" type="video/mp4">
      </video>
    </div>
    <!-- Gradient Overlay fading to #B42550 -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-[rgba(0,0,0,0.15)]  to-[rgba(180,37,80,0.95)] z-[1]" style="background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.15) 40%, rgba(180,37,80,0.7) 80%, rgba(180,37,80,0.95) 100%);"></div>
    <!-- Content -->
    <div class="relative z-[2] px-10 pb-32 max-w-[900px] max-md:px-6 max-md:pb-24">
      <p class="text-[11px] font-bold tracking-[0.35em] uppercase text-ebike mb-4">E-BIKE RENTAL</p>
      <h1 class="font-[family-name:var(--font-heading)] text-[clamp(40px,7vw,88px)] text-white tracking-tight leading-[0.95] mb-6">NO LICENSE.<br>JUST RIDE.</h1>
      <p class="font-[family-name:var(--font-heading-jp)] text-[clamp(14px,1.5vw,20px)] font-medium text-white/50 tracking-wide">免許不要。当日予約OK。鎌倉の風を感じろ。</p>
    </div>
    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-[2] flex flex-col items-center gap-2 animate-[scrollBounce_2s_ease-in-out_infinite]">
      <span class="text-[9px] font-bold tracking-[0.25em] uppercase text-white/30">Scroll</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white/30">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </div>
  </section>

  <!-- Section 2: Specs -->
  <section id="specs" class="py-32 px-10 bg-ebike max-md:py-24 max-md:px-6">
    <div class="max-w-[1100px] mx-auto">
      <!-- Header -->
      <div class="text-center mb-16 reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/40 mb-4">What You Get</p>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(24px,3vw,40px)] text-white tracking-tight">Built for the Coast.</h2>
      </div>
      <!-- Grid -->
      <div class="grid grid-cols-4 gap-5 max-lg:grid-cols-2 max-md:grid-cols-2">
        <!-- POWER -->
        <div class="bg-light border border-black/[0.08] rounded-2xl p-6 aspect-square max-md:aspect-auto flex flex-col overflow-hidden transition-all duration-400 hover:-translate-y-1.5 hover:shadow-[0_20px_60px_rgba(0,0,0,0.15)] reveal reveal-delay-1">
          <div class="w-10 h-10 rounded-[10px] bg-ebike/12 flex items-center justify-center mb-4 shrink-0">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-ebike">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </div>
          <h3 class="font-[family-name:var(--font-heading)] text-[clamp(13px,1.3vw,16px)] text-[#2D0A0A] tracking-wide mb-1.5">POWER</h3>
          <p class="font-[family-name:var(--font-heading)] text-[clamp(15px,1.5vw,22px)] text-ebike tracking-tight mb-2 whitespace-nowrap">HIGH TORQUE</p>
          <p class="text-[clamp(11px,1.1vw,14px)] text-[#2D0A0A]/70 leading-relaxed">坂道も余裕の強力モーター</p>
          <p class="text-[clamp(10px,1vw,13px)] text-[#2D0A0A]/50 mt-1 font-medium">Conquers any Kamakura hill</p>
        </div>
        <!-- RANGE -->
        <div class="bg-light border border-black/[0.08] rounded-2xl p-6 aspect-square max-md:aspect-auto flex flex-col overflow-hidden transition-all duration-400 hover:-translate-y-1.5 hover:shadow-[0_20px_60px_rgba(0,0,0,0.15)] reveal reveal-delay-2">
          <div class="w-10 h-10 rounded-[10px] bg-ebike/12 flex items-center justify-center mb-4 shrink-0">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-ebike">
              <rect x="1" y="6" width="18" height="12" rx="2" ry="2"/><line x1="23" y1="13" x2="23" y2="11"/><line x1="5" y1="10" x2="5" y2="14"/><line x1="9" y1="10" x2="9" y2="14"/><line x1="13" y1="10" x2="13" y2="14"/>
            </svg>
          </div>
          <h3 class="font-[family-name:var(--font-heading)] text-[clamp(13px,1.3vw,16px)] text-[#2D0A0A] tracking-wide mb-1.5">RANGE</h3>
          <p class="font-[family-name:var(--font-heading)] text-[clamp(15px,1.5vw,22px)] text-ebike tracking-tight mb-2 whitespace-nowrap">30-40km</p>
          <p class="text-[clamp(11px,1.1vw,14px)] text-[#2D0A0A]/70 leading-relaxed">海沿いを走り尽くせる十分な航続距離</p>
          <p class="text-[clamp(10px,1vw,13px)] text-[#2D0A0A]/50 mt-1 font-medium">Enough range for a full coastal cruise</p>
        </div>
        <!-- STYLE -->
        <div class="bg-light border border-black/[0.08] rounded-2xl p-6 aspect-square max-md:aspect-auto flex flex-col overflow-hidden transition-all duration-400 hover:-translate-y-1.5 hover:shadow-[0_20px_60px_rgba(0,0,0,0.15)] reveal reveal-delay-3">
          <div class="w-10 h-10 rounded-[10px] bg-ebike/12 flex items-center justify-center mb-4 shrink-0">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-ebike">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <h3 class="font-[family-name:var(--font-heading)] text-[clamp(13px,1.3vw,16px)] text-[#2D0A0A] tracking-wide mb-1.5">STYLE</h3>
          <p class="font-[family-name:var(--font-heading)] text-[clamp(15px,1.5vw,22px)] text-ebike tracking-tight mb-2 whitespace-nowrap">HEAD TURNER</p>
          <p class="text-[clamp(11px,1.1vw,14px)] text-[#2D0A0A]/70 leading-relaxed">視線を集めるデザイン</p>
          <p class="text-[clamp(10px,1vw,13px)] text-[#2D0A0A]/50 mt-1 font-medium">Designed to turn heads</p>
        </div>
        <!-- LICENSE -->
        <div class="bg-light border border-black/[0.08] rounded-2xl p-6 aspect-square max-md:aspect-auto flex flex-col overflow-hidden transition-all duration-400 hover:-translate-y-1.5 hover:shadow-[0_20px_60px_rgba(0,0,0,0.15)] reveal reveal-delay-4">
          <div class="w-10 h-10 rounded-[10px] bg-ebike/12 flex items-center justify-center mb-4 shrink-0">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-ebike">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <h3 class="font-[family-name:var(--font-heading)] text-[clamp(13px,1.3vw,16px)] text-[#2D0A0A] tracking-wide mb-1.5">LICENSE</h3>
          <p class="font-[family-name:var(--font-heading)] text-[clamp(15px,1.5vw,22px)] text-ebike tracking-tight mb-2 whitespace-nowrap">NO LICENSE</p>
          <p class="text-[clamp(11px,1.1vw,14px)] text-[#2D0A0A]/70 leading-relaxed">免許不要・最高速度20km/h</p>
          <p class="text-[clamp(10px,1vw,13px)] text-[#2D0A0A]/50 mt-1 font-medium">No license required</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Plans -->
  <section id="plans" class="py-24 px-10 bg-ebike max-md:py-24 max-md:px-6">
    <div class="max-w-[1100px] mx-auto">
      <!-- Header -->
      <div class="text-center mb-10 reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/40 mb-4">Plans &amp; Pricing</p>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(24px,3vw,40px)] text-white tracking-tight">Choose Your Ride.</h2>
      </div>
      <!-- Grid -->
      <div class="grid grid-cols-3 gap-6 items-stretch max-md:grid-cols-1">
        <!-- QUICK RIDE -->
        <div class="relative bg-light border-2 border-black/[0.08] rounded-2xl p-10 h-full flex flex-col shadow-[0_1px_3px_rgba(0,0,0,0.1),0_4px_12px_rgba(0,0,0,0.05)] transition-all duration-400 hover:-translate-y-1 hover:border-4 hover:border-[#2D0A0A] reveal reveal-delay-1">
          <h3 class="font-[family-name:var(--font-heading)] text-base text-[#2D0A0A]/60 tracking-wide mb-4">QUICK RIDE</h3>
          <p class="font-[family-name:var(--font-heading)] text-[clamp(36px,4vw,48px)] text-[#2D0A0A] tracking-tight leading-none mb-1">&yen;3,500</p>
          <p class="text-sm font-semibold text-[#2D0A0A]/40 tracking-wide mb-6">2 Hours</p>
          <p class="text-sm text-[#2D0A0A]/70 leading-relaxed mb-auto pb-6">Best for a quick coastal spin</p>
          {EBIKE_WIDGETS.quickRide ? (
            <BookNowButton widgetId={EBIKE_WIDGETS.quickRide} label="BOOK NOW" class="block w-full py-3.5 px-6 bg-ebike text-white text-[13px] font-bold tracking-[0.15em] uppercase text-center border-none rounded-lg cursor-pointer transition-all duration-300 hover:bg-[#8e1d40] hover:-translate-y-0.5" />
          ) : (
            <button class="block w-full py-3.5 px-6 bg-ebike/50 text-white/60 text-[13px] font-bold tracking-[0.15em] uppercase text-center border-none rounded-lg cursor-not-allowed" disabled>COMING SOON</button>
          )}
          <p class="text-[11px] text-[#2D0A0A]/35 text-center mt-2.5 font-medium">Powered by Bokun</p>
        </div>
        <!-- CRUISE (POPULAR) -->
        <div class="relative bg-light border-2 border-[#2D0A0A] rounded-2xl p-10 h-full flex flex-col shadow-[0_1px_3px_rgba(0,0,0,0.1),0_4px_12px_rgba(0,0,0,0.05)] transition-all duration-400 hover:-translate-y-1 hover:border-4 hover:border-[#2D0A0A] reveal reveal-delay-2">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#2D0A0A] text-ebike text-[10px] font-bold tracking-[0.2em] uppercase px-4 py-1 rounded-full">POPULAR</span>
          <h3 class="font-[family-name:var(--font-heading)] text-base text-[#2D0A0A]/60 tracking-wide mb-4">CRUISE</h3>
          <p class="font-[family-name:var(--font-heading)] text-[clamp(36px,4vw,48px)] text-[#2D0A0A] tracking-tight leading-none mb-1">&yen;5,000</p>
          <p class="text-sm font-semibold text-[#2D0A0A]/40 tracking-wide mb-6">2 - 4 Hours</p>
          <p class="text-sm text-[#2D0A0A]/70 leading-relaxed mb-auto pb-6">Explore Kamakura at your pace</p>
          {EBIKE_WIDGETS.cruise ? (
            <BookNowButton widgetId={EBIKE_WIDGETS.cruise} label="BOOK NOW" class="block w-full py-3.5 px-6 bg-ebike text-white text-[13px] font-bold tracking-[0.15em] uppercase text-center border-none rounded-lg cursor-pointer transition-all duration-300 hover:bg-[#8e1d40] hover:-translate-y-0.5" />
          ) : (
            <button class="block w-full py-3.5 px-6 bg-ebike/50 text-white/60 text-[13px] font-bold tracking-[0.15em] uppercase text-center border-none rounded-lg cursor-not-allowed" disabled>COMING SOON</button>
          )}
          <p class="text-[11px] text-[#2D0A0A]/35 text-center mt-2.5 font-medium">Powered by Bokun</p>
        </div>
        <!-- ALL DAY -->
        <div class="relative bg-light border-2 border-black/[0.08] rounded-2xl p-10 h-full flex flex-col shadow-[0_1px_3px_rgba(0,0,0,0.1),0_4px_12px_rgba(0,0,0,0.05)] transition-all duration-400 hover:-translate-y-1 hover:border-4 hover:border-[#2D0A0A] reveal reveal-delay-3">
          <h3 class="font-[family-name:var(--font-heading)] text-base text-[#2D0A0A]/60 tracking-wide mb-4">ALL DAY</h3>
          <p class="font-[family-name:var(--font-heading)] text-[clamp(36px,4vw,48px)] text-[#2D0A0A] tracking-tight leading-none mb-1">&yen;7,500</p>
          <p class="text-sm font-semibold text-[#2D0A0A]/40 tracking-wide mb-6">4 - 8 Hours</p>
          <p class="text-sm text-[#2D0A0A]/70 leading-relaxed mb-auto pb-6">The ultimate freedom</p>
          {EBIKE_WIDGETS.allDay ? (
            <BookNowButton widgetId={EBIKE_WIDGETS.allDay} label="BOOK NOW" class="block w-full py-3.5 px-6 bg-ebike text-white text-[13px] font-bold tracking-[0.15em] uppercase text-center border-none rounded-lg cursor-pointer transition-all duration-300 hover:bg-[#8e1d40] hover:-translate-y-0.5" />
          ) : (
            <button class="block w-full py-3.5 px-6 bg-ebike/50 text-white/60 text-[13px] font-bold tracking-[0.15em] uppercase text-center border-none rounded-lg cursor-not-allowed" disabled>COMING SOON</button>
          )}
          <p class="text-[11px] text-[#2D0A0A]/35 text-center mt-2.5 font-medium">Powered by Bokun</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Destinations -->
  <section id="destinations" class="py-32 px-10 bg-ebike max-md:py-24 max-md:px-6">
    <div class="max-w-[1200px] mx-auto">
      <!-- Header -->
      <div class="text-center mb-16 reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/40 mb-4">Explore Kamakura</p>
        <h2 class="font-[family-name:var(--font-serif-jp)] text-[clamp(24px,3vw,40px)] text-white tracking-tight">鎌倉散策</h2>
        <p class="font-[family-name:var(--font-body)] text-[clamp(14px,1.5vw,18px)] text-white/40 mt-2 font-medium tracking-wide">Discover the Ancient Capital.</p>
      </div>
      <!-- Grid -->
      <div class="grid grid-cols-4 gap-5 max-lg:grid-cols-2 max-md:grid-cols-1 dest-grid">
        <!-- SHRINE -->
        <div class="dest-card relative rounded-2xl overflow-hidden aspect-[3/4] max-md:aspect-video cursor-pointer reveal reveal-delay-1">
          <div class="dest-card__bg absolute inset-0 bg-[#111] transition-transform duration-600 ease-[cubic-bezier(0.25,0.46,0.45,0.94)]">
            <img src="/assets/route/KAMAKURA_HACHIMANGU1.jpg" alt="TSURUGAOKA HACHIMANGU" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute inset-0 z-[1]" style="background: linear-gradient(to top, rgba(45,10,10,0.85) 0%, rgba(45,10,10,0.1) 50%, rgba(0,0,0,0) 100%);"></div>
          <!-- Time Badge -->
          <div class="absolute top-4 right-4 z-[3] flex items-center gap-1 px-2.5 py-1.5 rounded-full bg-black/55 backdrop-blur-sm border border-white/12 text-[11px] font-semibold text-white tracking-wide">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-ebike shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            ~5 min
          </div>
          <!-- Content -->
          <div class="absolute bottom-0 left-0 right-0 p-7 z-[2]">
            <h3 class="font-[family-name:var(--font-heading)] text-[clamp(16px,1.8vw,22px)] text-white tracking-wide mb-2">SHRINE</h3>
            <p class="font-[family-name:var(--font-heading-jp)] text-[13px] font-medium text-white/60 leading-relaxed">鶴岡八幡宮 — 鎌倉の象徴を参拝する</p>
          </div>
          <!-- Detail Panel (expand) -->
          <div class="dest-card__detail absolute bottom-0 left-0 right-0 z-[3] pt-20 px-6 pb-7 transition-all duration-400 ease-[cubic-bezier(0.25,0.46,0.45,0.94)]" style="background: linear-gradient(to top, rgba(45,10,10,0.95) 0%, rgba(45,10,10,0.85) 70%, rgba(45,10,10,0) 100%); transform: translateY(100%); opacity: 0; pointer-events: none;">
            <p class="font-[family-name:var(--font-heading-jp)] text-[13px] font-normal text-white/75 leading-[1.8]"><strong class="text-white font-bold">鶴岡八幡宮</strong><br>鎌倉幕府の守護神。境内の石段や源平池など見どころ多数。小町通りを抜けてすぐ。E-BIKEは鳥居前の駐輪場へ。</p>
          </div>
          <span class="dest-card__tap-hint absolute bottom-2 left-1/2 -translate-x-1/2 z-[3] text-[9px] font-semibold tracking-[0.15em] uppercase text-white/25 transition-opacity duration-300">Tap for details</span>
        </div>
        <!-- BIG BUDDHA -->
        <div class="dest-card relative rounded-2xl overflow-hidden aspect-[3/4] max-md:aspect-video cursor-pointer reveal reveal-delay-2">
          <div class="dest-card__bg absolute inset-0 bg-[#111] transition-transform duration-600 ease-[cubic-bezier(0.25,0.46,0.45,0.94)]">
            <img src="/assets/route/KAMAKURA_BIG BUDA1.jpg" alt="GREAT BUDDHA" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute inset-0 z-[1]" style="background: linear-gradient(to top, rgba(45,10,10,0.85) 0%, rgba(45,10,10,0.1) 50%, rgba(0,0,0,0) 100%);"></div>
          <div class="absolute top-4 right-4 z-[3] flex items-center gap-1 px-2.5 py-1.5 rounded-full bg-black/55 backdrop-blur-sm border border-white/12 text-[11px] font-semibold text-white tracking-wide">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-ebike shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            ~15 min
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-7 z-[2]">
            <h3 class="font-[family-name:var(--font-heading)] text-[clamp(16px,1.8vw,22px)] text-white tracking-wide mb-2">BIG BUDDHA</h3>
            <p class="font-[family-name:var(--font-heading-jp)] text-[13px] font-medium text-white/60 leading-relaxed">鎌倉大仏 — 国宝の青銅仏を間近で</p>
          </div>
          <div class="dest-card__detail absolute bottom-0 left-0 right-0 z-[3] pt-20 px-6 pb-7 transition-all duration-400 ease-[cubic-bezier(0.25,0.46,0.45,0.94)]" style="background: linear-gradient(to top, rgba(45,10,10,0.95) 0%, rgba(45,10,10,0.85) 70%, rgba(45,10,10,0) 100%); transform: translateY(100%); opacity: 0; pointer-events: none;">
            <p class="font-[family-name:var(--font-heading-jp)] text-[13px] font-normal text-white/75 leading-[1.8]"><strong class="text-white font-bold">鎌倉大仏（高徳院）</strong><br>高さ約13mの国宝青銅阿弥陀如来像。胎内拝観も可能。長谷エリアは紫陽花の名所・長谷寺もすぐ近く。</p>
          </div>
          <span class="dest-card__tap-hint absolute bottom-2 left-1/2 -translate-x-1/2 z-[3] text-[9px] font-semibold tracking-[0.15em] uppercase text-white/25 transition-opacity duration-300">Tap for details</span>
        </div>
        <!-- ENOSHIMA -->
        <div class="dest-card relative rounded-2xl overflow-hidden aspect-[3/4] max-md:aspect-video cursor-pointer reveal reveal-delay-3">
          <div class="dest-card__bg absolute inset-0 bg-[#111] transition-transform duration-600 ease-[cubic-bezier(0.25,0.46,0.45,0.94)]">
            <img src="/assets/route/ENOSHIMA2.jpg" alt="ENOSHIMA" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute inset-0 z-[1]" style="background: linear-gradient(to top, rgba(45,10,10,0.85) 0%, rgba(45,10,10,0.1) 50%, rgba(0,0,0,0) 100%);"></div>
          <div class="absolute top-4 right-4 z-[3] flex items-center gap-1 px-2.5 py-1.5 rounded-full bg-black/55 backdrop-blur-sm border border-white/12 text-[11px] font-semibold text-white tracking-wide">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-ebike shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            ~20 min
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-7 z-[2]">
            <h3 class="font-[family-name:var(--font-heading)] text-[clamp(16px,1.8vw,22px)] text-white tracking-wide mb-2">ENOSHIMA</h3>
            <p class="font-[family-name:var(--font-heading-jp)] text-[13px] font-medium text-white/60 leading-relaxed">江ノ島 — 海沿いを走り島へ渡る</p>
          </div>
          <div class="dest-card__detail absolute bottom-0 left-0 right-0 z-[3] pt-20 px-6 pb-7 transition-all duration-400 ease-[cubic-bezier(0.25,0.46,0.45,0.94)]" style="background: linear-gradient(to top, rgba(45,10,10,0.95) 0%, rgba(45,10,10,0.85) 70%, rgba(45,10,10,0) 100%); transform: translateY(100%); opacity: 0; pointer-events: none;">
            <p class="font-[family-name:var(--font-heading-jp)] text-[13px] font-normal text-white/75 leading-[1.8]"><strong class="text-white font-bold">江ノ島</strong><br>134号線の海沿いルートは最高のE-BIKEコース。島内では展望灯台・岩屋洞窟・しらすグルメが楽しめる。</p>
          </div>
