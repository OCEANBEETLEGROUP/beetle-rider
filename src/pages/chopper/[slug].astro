---
import ChopperDetailPage from '../../components/pages/ChopperDetailPage.astro';
import { getVehicles } from '../../lib/microcms';

export async function getStaticPaths() {
  const { contents } = await getVehicles();
  // Generate pages for active + maintenance vehicles (hidden → no page)
  const visible = contents.filter(v => (v.status?.[0] || 'active') !== 'hidden');
  return visible.map((v, i) => ({
    params: { slug: v.slug },
    props: { vehicle: v, index: i + 1 },
  }));
}

const { vehicle, index } = Astro.props;
---

<ChopperDetailPage vehicle={vehicle} index={index} />
