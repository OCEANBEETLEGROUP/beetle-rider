---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="BEETLE RIDER — Not Just a Rental" activePage="home" headerLogo="chopper">

  <!-- Section 1: Split Hero -->
  <section class="flex h-screen p-3 gap-3 pt-[76px] bg-deep-red max-md:flex-col">
    <a href="/ebike" class="group relative flex-1 rounded-[32px] overflow-hidden cursor-pointer transition-[flex] duration-600 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] hover:flex-[1.15]">
      <div class="absolute inset-0 bg-[#111] transition-transform duration-800 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-hover:scale-105">
        <img src="/assets/ebike/ebike0010.jpg" alt="E-BIKE" class="w-full h-full object-cover" loading="lazy" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/10 to-black/50 group-hover:from-black/5 group-hover:to-black/40 transition-all duration-500"></div>
      <div class="absolute bottom-0 left-0 right-0 p-12 z-[2]">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-2 h-2 rounded-full bg-ebike shadow-[0_0_12px_var(--color-ebike)] animate-pulse"></div>
          <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-white/60">E-BIKE RENTAL</span>
        </div>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(36px,5vw,64px)] text-white tracking-tight leading-none mb-3">E-BIKE</h2>
        <p class="text-sm font-medium text-white/70 tracking-wide max-w-[300px]">免許不要。当日予約OK。</p>
      </div>
      <div class="absolute bottom-12 right-10 w-14 h-14 rounded-full bg-white/10 border border-white/20 flex items-center justify-center z-[2] group-hover:bg-white/20 group-hover:translate-x-1 transition-all duration-400">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
    </a>

    <a href="/chopper" class="group relative flex-1 rounded-[32px] overflow-hidden cursor-pointer transition-[flex] duration-600 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] hover:flex-[1.15]">
      <div class="absolute inset-0 bg-[#111] transition-transform duration-800 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-hover:scale-105">
        <video autoplay muted loop playsinline poster="/assets/chopper/promo/R0006459.JPG" class="w-full h-full object-cover">
          <source src="/assets/video/CHOPPER.MOV" type="video/quicktime">
          <source src="/assets/video/CHOPPER.MOV" type="video/mp4">
        </video>
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/10 to-black/50 group-hover:from-black/5 group-hover:to-black/40 transition-all duration-500"></div>
      <div class="absolute bottom-0 left-0 right-0 p-12 z-[2]">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-2 h-2 rounded-full bg-brand shadow-[0_0_12px_var(--color-brand)] animate-pulse"></div>
          <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-white/60">CHOPPER EXPERIENCE</span>
        </div>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(36px,5vw,64px)] text-white tracking-tight leading-none mb-3">CHOPPER</h2>
        <p class="text-sm font-medium text-white/70 tracking-wide max-w-[300px]">リジットフレームのスポーツスターを体験せよ。</p>
      </div>
      <div class="absolute bottom-12 right-10 w-14 h-14 rounded-full bg-white/10 border border-white/20 flex items-center justify-center z-[2] group-hover:bg-white/20 group-hover:translate-x-1 transition-all duration-400">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
    </a>
  </section>

  <!-- Section 2: Statement -->
  <section class="py-32 px-10 bg-deep-red text-center flex flex-col items-center justify-center min-h-[60vh]">
    <div class="reveal">
      <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-6">Kamakura, Japan</p>
    </div>
    <div class="reveal reveal-delay-1">
      <h2 class="font-[family-name:var(--font-accent)] text-[clamp(24px,4vw,48px)] text-white tracking-tight leading-[1.2] max-w-[900px] mb-10">
        Not Just a Rental.<br>We Deliver <em class="not-italic text-brand">Chopper Orgasm.</em>
      </h2>
    </div>
    <div class="reveal reveal-delay-2">
      <div class="w-12 h-px bg-white/15 mx-auto mb-10"></div>
    </div>
    <div class="reveal reveal-delay-3">
      <p class="text-sm text-white/60 leading-relaxed max-w-[600px]">
        東京からわずか60分。鎌倉の海と山が交差する地で、<br class="hidden md:block">
        あなたの日常を書き換える体験が待っている。
      </p>
    </div>
  </section>

  <!-- Section 3: Access Map -->
  <section class="py-16 px-10 bg-deep-red">
    <div class="max-w-[1200px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div>
        <div class="reveal">
          <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">Access</p>
          <h2 class="font-[family-name:var(--font-heading)] text-[clamp(28px,3.5vw,48px)] text-white leading-tight mb-2">
            60 Min From Tokyo.
          </h2>
          <span class="block font-[family-name:var(--font-heading-jp)] text-sm text-white/40 font-bold mb-6">首都圏からわずか60分の聖域。</span>
        </div>
        <div class="reveal reveal-delay-1">
          <p class="text-sm text-white/50 leading-relaxed mb-8">
            鎌倉駅から徒歩圏内。東京駅からJR横須賀線で約60分、車なら首都高から横浜横須賀道路経由で約1時間。湘南の海と古都の風情が交差するこの地に、あなたのマシンが待っている。
          </p>
        </div>
        <div class="reveal reveal-delay-2 flex gap-12">
          <div>
            <span class="block font-[family-name:var(--font-heading)] text-[48px] text-white leading-none">60</span>
            <span class="text-[11px] font-semibold tracking-[0.15em] uppercase text-white/35">Min from Tokyo</span>
          </div>
          <div>
            <span class="block font-[family-name:var(--font-heading)] text-[48px] text-white leading-none">5</span>
            <span class="text-[11px] font-semibold tracking-[0.15em] uppercase text-white/35">Min walk from station</span>
          </div>
        </div>
      </div>
      <div class="reveal reveal-delay-2">
        <svg viewBox="0 0 560 520" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
          <path d="M0,370 Q60,360 120,365 Q180,372 230,360 Q270,350 300,354 Q340,360 380,350 Q430,340 480,346 Q520,352 560,342" fill="none" stroke="white" stroke-width="1" opacity="0.15"/>
          <path d="M0,338 Q60,330 115,334 Q170,339 220,328 Q255,320 298,324 Q335,330 370,321 Q420,311 470,318 Q520,324 560,314" fill="none" stroke="white" stroke-width="3.5" opacity="0.28" stroke-linecap="round"/>
          <text x="160" y="382" font-family="'Archivo Black', sans-serif" font-size="12" fill="white" opacity="0.16" letter-spacing="0.18em">ROUTE 134</text>
          <path d="M450,55 Q435,90 420,130 Q405,165 390,195 Q370,235 350,270 Q325,300 305,325 L298,324" fill="none" stroke="white" stroke-width="1.8" opacity="0.4" stroke-dasharray="8,5"/>
          <path d="M390,195 Q370,170 350,150 Q330,130 310,115" fill="none" stroke="white" stroke-width="1.8" opacity="0.4" stroke-dasharray="8,5"/>
          <circle cx="450" cy="55" r="5.5" fill="white" opacity="0.5"/>
          <text x="466" y="60" font-family="Inter" font-size="13" fill="white" opacity="0.4" font-weight="700" letter-spacing="0.08em">TOKYO</text>
          <circle cx="310" cy="115" r="4" fill="white" opacity="0.35"/>
          <text x="250" y="108" font-family="Inter" font-size="12" fill="white" opacity="0.3" font-weight="700" letter-spacing="0.06em">SHIBUYA</text>
          <circle cx="390" cy="195" r="4" fill="white" opacity="0.35"/>
          <text x="405" y="191" font-family="Inter" font-size="12" fill="white" opacity="0.3" font-weight="700" letter-spacing="0.06em">YOKOHAMA</text>
          <circle cx="370" cy="321" r="3" fill="white" opacity="0.25"/>
          <text x="358" y="308" font-family="Inter" font-size="11" fill="white" opacity="0.25" font-weight="600" letter-spacing="0.06em">ZUSHI</text>
          <circle cx="430" cy="310" r="3" fill="white" opacity="0.25"/>
          <text x="418" y="297" font-family="Inter" font-size="11" fill="white" opacity="0.25" font-weight="600" letter-spacing="0.06em">HAYAMA</text>
          <circle cx="220" cy="328" r="3" fill="white" opacity="0.25"/>
          <text x="195" y="315" font-family="Inter" font-size="11" fill="white" opacity="0.25" font-weight="600" letter-spacing="0.06em">ENOSHIMA</text>
          <text x="20" y="290" font-family="Inter" font-size="11" fill="white" opacity="0.22" font-weight="600" letter-spacing="0.06em">← ODAWARA · HAKONE</text>
          <g>
            <circle cx="298" cy="324" r="9" fill="#C30D23"/>
            <circle cx="298" cy="324" r="18" fill="none" stroke="#C30D23" stroke-width="1.5" opacity="0.3">
              <animate attributeName="r" from="14" to="30" dur="2.5s" repeatCount="indefinite"/>
              <animate attributeName="opacity" from="0.35" to="0" dur="2.5s" repeatCount="indefinite"/>
            </circle>
          </g>
          <text x="298" y="360" text-anchor="middle" font-family="'Archivo Black', sans-serif" font-size="15" fill="white" opacity="0.85" letter-spacing="0.1em">KAMAKURA</text>
          <g transform="translate(520, 465)" opacity="0.15">
            <line x1="0" y1="-14" x2="0" y2="14" stroke="white" stroke-width="1"/>
            <line x1="-14" y1="0" x2="14" y2="0" stroke="white" stroke-width="1"/>
            <text font-family="Inter" font-size="8" fill="white" text-anchor="middle" y="-20" font-weight="700">N</text>
          </g>
          <line x1="30" y1="480" x2="100" y2="480" stroke="white" stroke-width="0.8" opacity="0.12"/>
          <text x="30" y="493" font-family="Inter" font-size="8" fill="white" opacity="0.12">10km</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- Section 4: Highlights -->
  <section class="py-16 px-10 bg-deep-red">
    <div class="max-w-[1200px] mx-auto">
      <div class="text-center mb-12 reveal">
        <p class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/35 mb-4">Choose Your Ride</p>
        <h2 class="font-[family-name:var(--font-heading)] text-[clamp(28px,3.5vw,48px)] text-white leading-tight">Two Roads. One Obsession.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <a href="/ebike" class="group relative aspect-[4/3] md:aspect-[3/2] rounded-2xl overflow-hidden cursor-pointer reveal reveal-delay-1">
          <div class="absolute inset-0 transition-transform duration-500 group-hover:scale-105">
            <img src="/assets/ebike/ebike0035.jpg" alt="E-BIKE" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-8 z-[2]">
            <span class="inline-block px-3 py-1 rounded-full bg-ebike text-[10px] font-bold tracking-[0.15em] uppercase text-white mb-3">E-BIKE</span>
            <h3 class="font-[family-name:var(--font-heading)] text-[clamp(20px,2.5vw,32px)] text-white leading-tight mb-2">No License.<br>Just Ride.</h3>
            <p class="text-sm text-white/60 max-w-[320px]">免許不要。湘南の風を30km先まで連れていく電動バイク。当日予約OK。</p>
          </div>
        </a>
        <a href="/chopper" class="group relative aspect-[4/3] md:aspect-[3/2] rounded-2xl overflow-hidden cursor-pointer reveal reveal-delay-2">
          <div class="absolute inset-0 transition-transform duration-500 group-hover:scale-105">
            <img src="/assets/chopper/promo/R0006459.JPG" alt="CHOPPER" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-8 z-[2]">
            <span class="inline-block px-3 py-1 rounded-full bg-brand text-[10px] font-bold tracking-[0.15em] uppercase text-white mb-3">CHOPPER</span>
            <h3 class="font-[family-name:var(--font-heading)] text-[clamp(20px,2.5vw,32px)] text-white leading-tight mb-2">1 of 1.<br>Your Machine Awaits.</h3>
            <p class="text-sm text-white/60 max-w-[320px]">世界に1台のリジッドフレーム・スポーツスター。大型二輪免許または国際免許（IDP）保持者限定。</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll('video[autoplay]').forEach(v => {
      (v as HTMLVideoElement).play().catch(() => {});
    });
  </script>
</BaseLayout>
